<scroll-view class="page" scroll-y wx:if="{{trip}}">
  <view class="hero"><view class="eyebrow">TRIP BUDGET</view><view class="title">预算中心</view><view class="numbers"><view><view class="value">{{summary.spentText}}</view><view class="label">已使用</view></view><view><view class="value {{summary.overBudget ? 'danger' : ''}}">{{summary.remainingText}}</view><view class="label">{{summary.overBudget ? '已超支' : '剩余'}}</view></view><view><view class="value">{{summary.percent}}%</view><view class="label">预算进度</view></view></view></view>
  <view class="source-strip"><view><view class="source-label">个人支出 · {{summary.personalExpenseCount}} 笔</view><view class="source-value">{{summary.personalText}}</view></view><view><view class="source-label">AA 账本 · {{summary.ledgerExpenseCount}} 笔</view><view class="source-value">{{summary.ledgerText}}</view></view></view>
  <view class="section"><view class="section-title">分类进度</view><view class="category-row" wx:for="{{summary.byCategory}}" wx:key="category"><view><view class="category-name">{{item.category}}</view><view class="category-copy">已用 {{item.spentText}}</view></view><input class="budget-input {{item.over ? 'budget-over' : ''}}" type="digit" placeholder="分类预算" value="{{item.budgetInput}}" data-category="{{item.category}}" bindblur="setCategoryBudget"/></view></view>
  <view class="section"><view class="section-title">关联 AA 账本</view><view class="hint">计入同行人的全部账本支出，不复制数据。</view><view class="ledger {{item.linked ? 'linked' : ''}}" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleLedger"><view><view class="ledger-title">{{item.title}}</view><view class="hint">{{item.expenseCount}} 笔 · {{item.amountText}}</view></view><view>{{item.linked ? '已计入' : '不计入'}}</view></view><view class="hint" wx:if="{{!ledgers.length}}">暂无可关联账本</view></view>
  <view class="section"><view class="section-title">新增个人支出</view><view class="field-label">支出名称</view><input class="input" placeholder="例如：机场快线" value="{{expense.title}}" data-field="title" bindinput="input"/><view class="grid"><view><view class="field-label">金额</view><input class="input" type="digit" placeholder="0.00" value="{{expense.amountText}}" data-field="amountText" bindinput="input"/></view><view><view class="field-label">币种</view><input class="input" placeholder="CNY" value="{{expense.currency}}" data-field="currency" bindinput="input"/></view><view><view class="field-label">汇率</view><input class="input" type="digit" placeholder="1" value="{{expense.rate}}" data-field="rate" bindinput="input"/></view></view><view class="field-label">支出日期</view><picker mode="date" value="{{expense.date}}" start="{{trip.startDate}}" end="{{trip.endDate}}" bindchange="expenseDate"><view class="input picker">{{expense.date || '选择日期'}}</view></picker><view class="categories"><view class="chip {{expense.category === item ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" data-value="{{item}}" bindtap="category">{{item}}</view></view><button class="add" bindtap="addExpense">记录支出</button><view class="expense" wx:for="{{trip.personalExpenses}}" wx:key="id"><view><view class="expense-title">{{item.title || item.category}}</view><view class="hint">{{item.currency}} · {{item.date}}</view></view><view class="delete" data-id="{{item.id}}" bindtap="removeExpense">删除</view></view></view>
</scroll-view>
