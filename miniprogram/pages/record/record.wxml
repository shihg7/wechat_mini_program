<view class="record-shell">
  <scroll-view
    wx:if="{{!missing}}"
    class="page {{mode === 'create' || mode === 'edit' ? 'page-with-save-bar' : ''}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="record-header">
      <view class="header-copy">
        <view class="eyebrow">{{mode === "create" ? "NEW RATING" : mode === "edit" ? "EDIT RATING" : "QUICK RATING"}}</view>
        <view class="title">{{mode === "create" ? "记录一次到访" : form.name}}</view>
        <view class="header-meta">{{form.type === "restaurant" ? "餐厅" : "酒店"}} · {{form.visitDate}}</view>
      </view>
      <view class="score-panel {{form.score !== null && form.score !== '' ? 'has-score' : ''}}">
        <view class="score-value">{{form.score !== null && form.score !== "" ? form.score : "--"}}</view>
        <view class="score-unit">/ 10</view>
      </view>
    </view>

    <view class="form-band">
      <view class="section-heading">
        <view class="section-title">基本信息</view>
        <view class="required-note">名称必填</view>
      </view>

      <view class="segments" wx:if="{{!readonly}}">
        <view class="segment {{form.type === 'hotel' ? 'active' : ''}}" data-type="hotel" bindtap="onTypeTap">
          <ui-icon name="hotel" size="{{25}}" tone="{{form.type === 'hotel' ? 'white' : 'muted'}}" />
          <text>酒店</text>
        </view>
        <view class="segment {{form.type === 'restaurant' ? 'active' : ''}}" data-type="restaurant" bindtap="onTypeTap">
          <ui-icon name="utensils" size="{{25}}" tone="{{form.type === 'restaurant' ? 'white' : 'muted'}}" />
          <text>餐厅</text>
        </view>
      </view>

      <view class="field">
        <view class="label">名称</view>
        <input
          class="input"
          disabled="{{readonly}}"
          value="{{form.name}}"
          placeholder="{{form.type === 'restaurant' ? '餐厅名称' : '酒店名称'}}"
          maxlength="80"
          data-field="name"
          bindinput="onInput"
        />
      </view>

      <view class="field-grid">
        <view class="field">
          <view class="label">城市</view>
          <input
            class="input"
            disabled="{{readonly}}"
            value="{{form.city}}"
            placeholder="选填"
            maxlength="40"
            data-field="city"
            bindinput="onInput"
          />
        </view>
        <view class="field">
          <view class="label">到访日期</view>
          <picker mode="date" disabled="{{readonly}}" value="{{form.visitDate}}" bindchange="onDateChange">
            <view class="input picker-value">
              <text>{{form.visitDate}}</text>
              <ui-icon wx:if="{{!readonly}}" name="calendar" size="{{23}}" tone="muted" />
            </view>
          </picker>
        </view>
      </view>

      <view class="field">
        <view class="label">评分（可选）</view>
        <view class="score-input-row" wx:if="{{!readonly}}">
          <input
            class="score-input"
            type="digit"
            value="{{scoreInput}}"
            placeholder="1.0 - 10.0"
            maxlength="4"
            bindinput="onScoreInput"
          />
          <button class="clear-score icon-center" wx:if="{{scoreInput !== ''}}" catchtap="clearScore" aria-label="清空评分">
            <ui-icon name="x" size="{{22}}" tone="muted" />
          </button>
          <view class="score-suffix">/ 10</view>
        </view>
        <view class="readonly-value score-readonly" wx:else>
          {{form.score !== null ? form.score + " / 10" : "未评分"}}
        </view>
      </view>

      <view class="field">
        <view class="label">备注</view>
        <textarea
          class="textarea"
          disabled="{{readonly}}"
          value="{{form.note}}"
          placeholder="选填"
          maxlength="500"
          data-field="note"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="detail-actions" wx:if="{{mode === 'detail'}}">
      <button class="action-button secondary icon-action" bindtap="goToList">
        <ui-icon name="clipboard" size="{{25}}" />
        <text>全部记录</text>
      </button>
      <button class="action-button primary icon-action" bindtap="enterEdit">
        <ui-icon name="edit" size="{{25}}" tone="white" />
        <text>编辑</text>
      </button>
      <button class="action-button danger icon-action" bindtap="remove">
        <ui-icon name="trash" size="{{25}}" tone="accent" />
        <text>删除</text>
      </button>
    </view>
  </scroll-view>

  <view class="missing-state" wx:if="{{missing}}">
    <view class="missing-icon"><ui-icon name="alert" size="{{42}}" tone="accent" /></view>
    <view class="missing-title">找不到这条记录</view>
    <button class="missing-button" bindtap="goBack">返回上一页</button>
  </view>

  <view class="fixed-save-bar" wx:if="{{mode === 'create' || mode === 'edit'}}">
    <view class="save-bar-inner">
      <button class="cancel-button icon-center" wx:if="{{mode === 'edit'}}" bindtap="cancelEdit" aria-label="取消编辑">
        <ui-icon name="x" size="{{29}}" />
      </button>
      <button class="save-button icon-action" bindtap="save">
        <ui-icon name="check" size="{{27}}" tone="white" />
        <text>{{mode === "edit" ? "保存修改" : "保存记录"}}</text>
      </button>
    </view>
  </view>
</view>
