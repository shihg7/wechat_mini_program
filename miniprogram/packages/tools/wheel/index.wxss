page{background:#edf1f2;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{height:100vh;padding:24rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden}.topbar,.wheel-switch,.wheel-actions,.editor-toggle,.history-head,.option,.option-main,.option-tools,.result-actions,.editor-head{display:flex;align-items:center;justify-content:space-between}.topbar{flex-shrink:0}.eyebrow{font-size:19rpx;line-height:26rpx;color:#e86343;font-weight:800}.title{font-size:48rpx;line-height:58rpx;font-weight:900;margin-top:1rpx}.subtitle{font-size:22rpx;line-height:32rpx;color:#667085}.icon-button{width:68rpx;height:68rpx;margin:0;padding:0;background:#172033;color:#fff;border-radius:8rpx;font-size:35rpx;line-height:68rpx;box-shadow:0 8rpx 18rpx rgba(23,32,51,.18)}.icon-button::after,.spin-button::after,.add-button::after,.result-sheet button::after{border:0}.wheel-switch{flex-shrink:0;min-height:92rpx;margin-top:18rpx;padding:0 22rpx;border-radius:8rpx;background:#172033;color:#fff;box-shadow:0 8rpx 22rpx rgba(23,32,51,.14)}.wheel-picker{flex:1;min-width:0}.switch-label{color:#9eaabd;font-size:18rpx;line-height:26rpx}.wheel-name{max-width:390rpx;overflow:hidden;font-size:27rpx;font-weight:800;line-height:38rpx;text-overflow:ellipsis;white-space:nowrap}.wheel-name text{margin-left:7rpx;color:#e6af2e}.wheel-actions{flex-shrink:0;gap:22rpx;color:#a8c2ef;font-size:20rpx}.danger{color:#f19a87!important}.stage{position:relative;flex-shrink:0;width:600rpx;height:600rpx;margin:14rpx auto 0}.stage-ring{position:absolute;inset:9rpx;border-radius:50%;box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.7),0 18rpx 36rpx rgba(23,32,51,.16)}.wheel-canvas{width:100%;height:100%;touch-action:none}.spin-hint{flex-shrink:0;text-align:center;color:#667085;font-size:21rpx;line-height:30rpx;margin-top:0}.spin-button{flex-shrink:0;width:100%;height:84rpx;margin-top:11rpx;background:#e86343!important;color:#fff!important;border-radius:8rpx;font-size:28rpx;font-weight:900;line-height:84rpx;box-shadow:0 10rpx 20rpx rgba(232,99,67,.22)}.spin-button[disabled]{background:#aeb5c0!important;box-shadow:none}.editor-toggle{flex-shrink:0;height:66rpx;margin-top:12rpx;padding:0 18rpx;background:#fff;border:1rpx solid #dce2e5;border-radius:8rpx;font-size:22rpx}.editor-title{font-weight:800}.count-badge{display:inline-block;min-width:34rpx;height:34rpx;margin-left:10rpx;padding:0 8rpx;border-radius:8rpx;background:#e6af2e;color:#172033;font-size:19rpx;font-weight:900;line-height:34rpx;text-align:center;box-sizing:border-box}.toggle-copy{color:#3568ad;font-weight:700}.lower{flex:1;min-height:0}.editor{padding-top:16rpx}.editor-head{margin-bottom:10rpx}.batch{width:100%;height:128rpx;padding:17rpx 18rpx;box-sizing:border-box;background:#fff;border:1rpx solid #dce2e5;border-radius:8rpx;font-size:23rpx;line-height:34rpx}.add-button{height:70rpx;margin-top:10rpx;background:#3568ad!important;color:#fff!important;border-radius:8rpx;font-size:24rpx;font-weight:800;line-height:70rpx}.option{margin-top:10rpx;padding:15rpx 16rpx;background:#fff;border-left:5rpx solid #176b68;border-radius:8rpx;gap:12rpx}.option-main{flex:1;min-width:0;justify-content:flex-start;gap:12rpx}.option-index{width:38rpx;height:38rpx;flex-shrink:0;border-radius:50%;background:#edf1f2;text-align:center;line-height:38rpx;font-size:20rpx;font-weight:800}.option-text{overflow:hidden;font-size:24rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.option-tools{flex-shrink:0;gap:14rpx;color:#3568ad;font-size:20rpx}.disabled-option{opacity:.48;border-left-color:#98a2b3}.history-head{margin-top:14rpx;padding:19rpx 20rpx;background:#fff;border-radius:8rpx}.section-title{font-size:27rpx;font-weight:850}.section-meta{color:#667085;font-size:20rpx;line-height:29rpx}.history{background:#fff;padding:0 20rpx 20rpx}.history-row{display:flex;justify-content:space-between;padding:15rpx 0;border-top:1rpx solid #edf0f3;font-size:22rpx}.history-row view:first-child{font-weight:700}.history-row view:last-child{color:#667085}.empty{text-align:center;color:#98a2b3;padding:24rpx}.clear-history{text-align:center;color:#a34b32;font-size:22rpx;padding-top:16rpx}.result-mask{position:fixed;z-index:20;inset:0;background:rgba(10,16,28,.58);display:flex;align-items:flex-end;backdrop-filter:blur(3px)}.result-sheet{position:relative;width:100%;padding:38rpx 32rpx calc(env(safe-area-inset-bottom) + 26rpx);box-sizing:border-box;background:#fff;border-radius:8rpx 8rpx 0 0;text-align:center;overflow:hidden}.result-accent{position:absolute;left:0;right:0;top:0;height:10rpx;background:#e6af2e}.result-mark{width:74rpx;height:74rpx;margin:0 auto 16rpx;border-radius:50%;background:#176b68;color:#fff;font-size:36rpx;font-weight:900;line-height:74rpx}.result-label{color:#667085;font-size:23rpx}.result-value{margin:10rpx 0 28rpx;color:#172033;font-size:48rpx;line-height:62rpx;font-weight:900;word-break:break-all}.result-actions{gap:12rpx}.result-actions button{flex:1;height:76rpx;border-radius:8rpx;font-size:24rpx;font-weight:800}.again{background:#172033!important;color:#fff!important}.remove-winner{background:#edf1f2!important;color:#a34b32!important}.done{width:100%;height:72rpx;margin-top:12rpx;background:#e86343!important;color:#fff!important;border-radius:8rpx;font-size:24rpx;font-weight:850}
