<scroll-view class="page" scroll-y wx:if="{{ledger}}">
  <view class="hero">
    <view class="hero-main">
      <view class="eyebrow">SPLIT LEDGER</view>
      <view class="title">{{ledger.title}}</view>
      <view class="summary">{{ledger.city || "未填写城市"}} · {{memberCount}} 位当前成员 · {{summary.expenseCount}} 笔</view>
    </view>
    <view class="total-card">
      <view class="total-value">{{summary.totalText}}</view>
      <view class="total-label">总支出</view>
    </view>
  </view>

  <view class="settled-banner {{isSettled ? 'done' : 'pending'}}">
    <view>
      <view class="settled-title">{{isSettled ? "已结清" : "进行中"}}</view>
      <view class="settled-desc">{{isSettled ? "所有支出与已确认转账已平衡" : "剩余待结算 " + remainingText}}</view>
    </view>
    <view class="copy-link" bindtap="copySettlementText">复制结算文本</view>
  </view>

  <view class="overview-grid">
    <view class="overview-item">
      <view class="overview-value">{{summary.averageText}}</view>
      <view class="overview-label">人均</view>
    </view>
    <view class="overview-item">
      <view class="overview-value">{{settlements.length}}</view>
      <view class="overview-label">待转账</view>
    </view>
    <view class="overview-item">
      <view class="overview-value">{{transfers.length}}</view>
      <view class="overview-label">结算记录</view>
    </view>
  </view>

  <view class="quick-actions">
    <button class="button primary" bindtap="openExpenseForm">{{showExpenseForm ? "继续填写" : "记一笔支出"}}</button>
    <button class="button secondary" bindtap="editLedger">成员与账本</button>
  </view>

  <view class="section member-section">
    <view class="section-head">
      <view>
        <view class="section-title">成员</view>
        <view class="section-subtitle">归档成员仍保留在历史账目中</view>
      </view>
      <view class="mini-link" bindtap="editLedger">管理</view>
    </view>
    <view class="member-chips">
      <view class="member-chip {{item.status}}" wx:for="{{members}}" wx:key="id">{{item.name}}{{item.status === "archived" ? " · 已归档" : ""}}</view>
    </view>
  </view>

  <view class="section form-section" wx:if="{{showExpenseForm}}">
    <view class="section-head">
      <view>
        <view class="section-title">{{editingExpenseId ? "编辑支出" : "记一笔支出"}}</view>
        <view class="section-subtitle">{{editingExpenseId ? "历史归档成员会完整保留" : "新支出默认只包含当前成员"}}</view>
      </view>
      <view class="close-link" bindtap="closeExpenseForm">收起</view>
    </view>

    <view class="field">
      <view class="field-label">支出名称</view>
      <input class="input" placeholder="例如：晚餐 / 酒店 / 打车" value="{{expenseForm.title}}" data-field="title" bindinput="onExpenseInput" />
    </view>

    <view class="amount-row">
      <view class="field amount-field">
        <view class="field-label">金额</view>
        <input class="input amount-input" type="digit" placeholder="1200.00" value="{{expenseForm.amount}}" data-field="amount" bindinput="onExpenseInput" />
      </view>
      <view class="field payer-field">
        <view class="field-label">付款人</view>
        <picker mode="selector" range="{{expenseForm.payerOptions}}" range-key="name" value="{{expenseForm.payerIndex}}" bindchange="onPayerChange">
          <view class="input picker-value">{{expenseForm.payerName}}</view>
        </picker>
      </view>
    </view>

    <view class="split-row">
      <view class="field split-field">
        <view class="field-label">分类</view>
        <picker mode="selector" range="{{categories}}" value="{{expenseForm.categoryIndex}}" bindchange="onCategoryChange">
          <view class="input picker-value">{{expenseForm.categoryName}}</view>
        </picker>
      </view>
      <view class="field split-field">
        <view class="field-label">日期</view>
        <picker mode="date" value="{{expenseForm.paidAt}}" bindchange="onPaidAtChange">
          <view class="input picker-value">{{expenseForm.paidAt || "选择日期"}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="participant-head">
        <view class="field-label">参与分摊人 · {{participantSummary}}</view>
        <view class="participant-actions">
          <view class="mini-link" bindtap="selectAllParticipants">全选</view>
          <view class="mini-danger" bindtap="clearParticipants">清空</view>
        </view>
      </view>
      <checkbox-group class="member-checks" bindchange="onParticipantsChange">
        <label class="member-check {{item.status}}" wx:for="{{memberOptions}}" wx:key="id">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#2864d9" />
          <text>{{item.name}}{{item.status === "archived" ? "（已归档）" : ""}}</text>
        </label>
      </checkbox-group>
    </view>

    <view class="field">
      <view class="field-label">分摊方式</view>
      <view class="split-mode-control">
        <view class="split-mode-option {{expenseForm.splitMode === item.key ? 'active' : ''}}" wx:for="{{splitModes}}" wx:key="key" data-mode="{{item.key}}" bindtap="onSplitModeTap">{{item.label}}</view>
      </view>
    </view>

    <view class="allocation-panel" wx:if="{{expenseForm.splitMode !== 'equal'}}">
      <view class="allocation-hint" wx:if="{{expenseForm.splitMode === 'amount'}}">各成员金额合计需要等于本笔支出</view>
      <view class="allocation-hint" wx:elif="{{expenseForm.splitMode === 'ratio'}}">填写百分比，合计需要等于 100%</view>
      <view class="allocation-hint" wx:else>填写正整数份数，例如 2、1、1</view>
      <view class="allocation-row" wx:for="{{expenseForm.allocationRows}}" wx:key="id">
        <view class="allocation-name">{{item.name}}{{item.status === "archived" ? " · 已归档" : ""}}</view>
        <view class="allocation-input-wrap">
          <input class="allocation-input" type="digit" value="{{item.value}}" data-id="{{item.id}}" bindinput="onAllocationInput" />
          <text class="allocation-unit">{{expenseForm.splitMode === "amount" ? "元" : expenseForm.splitMode === "ratio" ? "%" : "份"}}</text>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <input class="input" placeholder="可选" value="{{expenseForm.note}}" data-field="note" bindinput="onExpenseInput" />
    </view>

    <view class="form-actions">
      <button class="button primary" bindtap="saveExpense">{{editingExpenseId ? "保存修改" : "保存支出"}}</button>
      <button class="button secondary" bindtap="closeExpenseForm">取消</button>
    </view>
  </view>

  <view class="section priority-section">
    <view class="section-head">
      <view>
        <view class="section-title">推荐转账方案</view>
        <view class="section-subtitle">{{settlements.length ? "可按实际到账金额分次确认" : "当前无需转账"}}</view>
      </view>
    </view>
    <view class="empty-inner success-empty" wx:if="{{!settlements.length}}">账目已经平衡。</view>
    <view class="settlement-wrap" wx:for="{{settlements}}" wx:key="key">
      <view class="settlement">
        <view>
          <view class="settlement-flow">{{item.fromName}} → {{item.toName}}</view>
          <view class="settlement-hint">建议转账</view>
        </view>
        <view class="settlement-side">
          <view class="settlement-amount">{{item.amountText}}</view>
          <view class="confirm-link" data-index="{{index}}" bindtap="openTransfer">确认转账</view>
        </view>
      </view>
    </view>

    <view class="transfer-form" wx:if="{{pendingTransfer}}">
      <view class="transfer-form-title">确认 {{pendingTransfer.fromName}} → {{pendingTransfer.toName}}</view>
      <view class="transfer-form-desc">可输入部分到账金额，剩余金额会继续保留在推荐方案中。</view>
      <input class="input transfer-input" type="digit" value="{{pendingTransfer.amount}}" bindinput="onTransferAmountInput" />
      <view class="form-actions">
        <button class="button primary" bindtap="confirmTransfer">确认到账</button>
        <button class="button secondary inset" bindtap="cancelTransfer">取消</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">结算历史</view>
        <view class="section-subtitle">已确认与已撤销记录均保留</view>
      </view>
    </view>
    <view class="empty-inner" wx:if="{{!transfers.length}}">还没有确认过转账。</view>
    <view class="transfer-history {{item.voided ? 'voided' : ''}}" wx:for="{{transfers}}" wx:key="id">
      <view class="history-main">
        <view class="member-name">{{item.fromName}} → {{item.toName}}</view>
        <view class="member-meta">{{item.time || "时间未记录"}} · {{item.statusText}}</view>
      </view>
      <view class="history-side">
        <view class="expense-amount">{{item.amountText}}</view>
        <view class="delete-link" wx:if="{{!item.voided}}" data-id="{{item.id}}" bindtap="voidTransfer">撤销</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">成员净额</view>
        <view class="section-subtitle">已计入确认转账；正数应收，负数应付</view>
      </view>
    </view>
    <view class="member-row" wx:for="{{summaryMembers}}" wx:key="key">
      <view>
        <view class="member-name">{{item.name}}{{item.status === "archived" ? " · 已归档" : ""}}</view>
        <view class="member-meta">已付 {{item.paidText}} · 应摊 {{item.shareText}}</view>
      </view>
      <view class="balance {{item.balanceCents >= 0 ? 'balance-positive' : 'balance-negative'}}">{{item.balanceText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">支出明细</view>
        <view class="section-subtitle">{{summary.expenseCount}} 笔</view>
      </view>
    </view>
    <view class="empty-inner" wx:if="{{!expenseViews.length}}">还没有支出。</view>
    <view class="expense" wx:for="{{expenseViews}}" wx:key="id">
      <view class="expense-main">
        <view class="expense-title">{{item.title}}</view>
        <view class="expense-meta">{{item.category}} · {{item.payerName}} 付款 · {{item.participantNames}} · {{item.splitSummary}}{{item.archivedHint}}</view>
        <view class="expense-note">{{item.paidAt || "未填写日期"}} {{item.noteText}}</view>
      </view>
      <view class="expense-side">
        <view class="expense-amount">{{item.amountText}}</view>
        <view class="expense-actions">
          <view class="edit-link" data-id="{{item.id}}" bindtap="editExpense">编辑</view>
          <view class="delete-link" data-id="{{item.id}}" bindtap="removeExpense">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">分类统计</view>
        <view class="section-subtitle">{{summary.categories.length}} 类</view>
      </view>
    </view>
    <view class="empty-inner" wx:if="{{!summary.categories.length}}">还没有分类支出。</view>
    <view class="category-row" wx:for="{{summary.categories}}" wx:key="category">
      <view>
        <view class="member-name">{{item.category}}</view>
        <view class="member-meta">{{item.count}} 笔</view>
      </view>
      <view class="expense-amount">{{item.totalText}}</view>
    </view>
  </view>
</scroll-view>
