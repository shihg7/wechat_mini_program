<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="eyebrow">旅行计划</view>
      <view class="title">我的行程</view>
      <view class="subtitle">下一段旅程，从这里开始</view>
    </view>
    <button class="add icon-action" bindtap="createTrip">
      <ui-icon name="plus" size="{{27}}" tone="white" />
      <text>新建</text>
    </button>
  </view>

  <view class="search-box">
    <ui-icon name="search" size="{{28}}" tone="muted" />
    <input class="search" placeholder="搜索行程或日程" value="{{keyword}}" bindinput="search" />
    <view class="clear-search icon-center" wx:if="{{keyword}}" bindtap="clearSearch" aria-label="清除搜索">
      <ui-icon name="x" size="{{23}}" tone="muted" />
    </view>
  </view>

  <view class="empty" wx:if="{{!allTripCount}}">
    <view class="empty-mark"><ui-icon name="route" size="{{42}}" tone="green" /></view>
    <view class="empty-title">还没有行程</view>
    <button class="primary icon-action" bindtap="createTrip">
      <ui-icon name="plus" size="{{28}}" tone="white" />
      <text>创建行程</text>
    </button>
  </view>

  <view class="empty" wx:elif="{{!trips.length}}">
    <view class="empty-mark muted"><ui-icon name="search" size="{{40}}" tone="muted" /></view>
    <view class="empty-title">没有匹配的行程</view>
    <button class="secondary icon-action" bindtap="clearSearch">
      <ui-icon name="x" size="{{24}}" tone="muted" />
      <text>清除搜索</text>
    </button>
  </view>

  <view class="trip-list" wx:else>
    <view class="list-head">
      <text>全部行程</text>
      <text>{{trips.length}} 个</text>
    </view>
    <view
      class="trip-card"
      wx:for="{{trips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openTrip"
    >
      <view class="trip-top">
        <view class="destination icon-label">
          <ui-icon name="pin" size="{{23}}" tone="green" />
          <text>{{item.destinationText}}</text>
        </view>
        <view class="phase {{item.phaseTone}}">{{item.phaseLabel}}</view>
      </view>
      <view class="trip-title">{{item.title}}</view>
      <view class="trip-date icon-label">
        <ui-icon name="calendar" size="{{23}}" tone="muted" />
        <text>{{item.dateText}}</text>
      </view>
      <view class="trip-foot">
        <view class="stat icon-label">
          <ui-icon name="route" size="{{24}}" tone="green" />
          <text>{{item.itemCount}} 项日程</text>
        </view>
        <view class="stat icon-label">
          <ui-icon name="clock" size="{{24}}" tone="amber" />
          <text>{{item.dayCount}} 天</text>
        </view>
        <ui-icon name="chevron-right" size="{{27}}" tone="muted" />
      </view>
    </view>
  </view>
</view>
