<scroll-view class="page" scroll-y wx:if="{{!missing}}">
  <view class="hero">
    <view class="hero-top">
      <view class="type-chip">{{form.type === "hotel" ? "住宿" : form.type === "restaurant" ? "餐厅" : form.type === "transport" ? "交通" : form.type === "ticket" ? "门票" : "其他"}}</view>
      <view class="status-chip {{form.status}}">{{form.status === "completed" ? "已完成" : form.status === "cancelled" ? "已取消" : "待出发"}}</view>
    </view>
    <view class="eyebrow">{{mode === "create" ? "NEW BOOKING" : mode === "edit" ? "EDIT BOOKING" : "BOOKING"}}</view>
    <view class="title">{{form.name || "新增预订"}}</view>
    <view class="hero-meta icon-label" wx:if="{{bookingView}}"><ui-icon name="calendar" size="{{24}}" tone="white" /><text>{{bookingView.timingLabel}} · {{form.startDate}}</text></view>
  </view>

  <block wx:if="{{!readonly}}">
    <view class="section">
      <view class="section-title">预订内容</view>
      <view class="segments five"><view class="segment {{form.type === item.key ? 'active' : ''}}" wx:for="{{bookingTypes}}" wx:key="key" data-value="{{item.key}}" bindtap="onTypeTap">{{item.label}}</view></view>
      <view class="field"><view class="label">名称 <text class="required">必填</text></view><input class="input" placeholder="酒店、餐厅、航班或门票名称" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
      <view class="grid"><view class="field"><view class="label">城市</view><input class="input" placeholder="例如 上海" value="{{form.city}}" data-field="city" bindinput="onInput" /></view><view class="field"><view class="label">人数</view><input class="input" type="number" value="{{form.peopleCount}}" bindinput="onPeopleChange" /></view></view>
      <view class="field"><view class="label">地址 / 出发到达信息</view><input class="input" placeholder="可选" value="{{form.address}}" data-field="address" bindinput="onInput" /></view>
    </view>

    <view class="section">
      <view class="section-title">时间安排</view>
      <view class="grid"><view class="field"><view class="label">开始日期 <text class="required">必填</text></view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="onDateChange"><view class="input picker">{{form.startDate || "选择日期"}}</view></picker></view><view class="field"><view class="label">开始时间</view><picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="onTimeChange"><view class="input picker">{{form.startTime || "选择时间"}}</view></picker></view></view>
      <view class="grid"><view class="field"><view class="label">结束日期</view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="onDateChange"><view class="input picker">{{form.endDate || "可不填"}}</view></picker></view><view class="field"><view class="label">结束时间</view><picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="onTimeChange"><view class="input picker">{{form.endTime || "可不填"}}</view></picker></view></view>
    </view>

    <view class="section">
      <view class="section-title">付款与取消</view>
      <view class="field"><view class="label">付款状态</view><view class="segments three"><view class="segment {{form.paymentStatus === item.key ? 'active' : ''}}" wx:for="{{paymentStatuses}}" wx:key="key" data-field="paymentStatus" data-value="{{item.key}}" bindtap="onOptionTap">{{item.label}}</view></view></view>
      <view class="grid"><view class="field"><view class="label">总金额</view><input class="input" type="digit" placeholder="0.00" value="{{form.amountText}}" data-field="amountText" bindinput="onInput" /></view><view class="field"><view class="label">预订编号</view><input class="input" placeholder="可选" value="{{form.bookingReference}}" data-field="bookingReference" bindinput="onInput" /></view></view>
      <view class="grid"><view class="field"><view class="label">免费取消截止日</view><picker mode="date" value="{{form.cancellationDate}}" data-field="cancellationDate" bindchange="onDateChange"><view class="input picker">{{form.cancellationDate || "可不填"}}</view></picker></view><view class="field"><view class="label">截止时间</view><picker mode="time" value="{{form.cancellationTime}}" data-field="cancellationTime" bindchange="onTimeChange"><view class="input picker">{{form.cancellationTime || "当天末"}}</view></picker></view></view>
      <view class="field"><view class="label">联系方式</view><input class="input" placeholder="电话、平台或联系人" value="{{form.contact}}" data-field="contact" bindinput="onInput" /></view>
    </view>

    <view class="section">
      <view class="section-title">状态与备注</view>
      <view class="segments three"><view class="segment {{form.status === item.key ? 'active' : ''}}" wx:for="{{bookingStatuses}}" wx:key="key" data-field="status" data-value="{{item.key}}" bindtap="onOptionTap">{{item.label}}</view></view>
      <view class="field"><view class="label">备注</view><textarea class="textarea" placeholder="入住要求、取票方式、值机提醒等" value="{{form.note}}" data-field="note" bindinput="onInput" /></view>
    </view>
    <view class="save-bar"><button class="button primary icon-action" bindtap="save"><ui-icon name="check" size="{{26}}" tone="white" /><text>保存预订</text></button></view>
  </block>

  <block wx:else>
    <view class="alert-row {{bookingView.urgencyTone}}" wx:if="{{bookingView.cancellationLabel}}"><ui-icon name="clock" size="{{27}}" tone="{{bookingView.cancellationExpired ? 'accent' : bookingView.urgencyTone}}" /><view><view class="alert-title">{{bookingView.cancellationLabel}}</view><view class="alert-desc">取消前请再次核对平台规则</view></view></view>
    <view class="section detail-section">
      <view class="section-head"><view class="section-title">预订信息</view><view class="edit-link icon-label" bindtap="edit"><ui-icon name="edit" size="{{22}}" tone="blue" /><text>编辑</text></view></view>
      <view class="detail-row"><view class="detail-label">日期</view><view class="detail-value">{{form.startDate}}{{form.startTime ? " " + form.startTime : ""}}{{form.endDate ? " 至 " + form.endDate : ""}}{{form.endTime ? " " + form.endTime : ""}}</view></view>
      <view class="detail-row"><view class="detail-label">人数</view><view class="detail-value">{{form.peopleCount}} 人</view></view>
      <view class="detail-row" wx:if="{{form.city || form.address}}"><view class="detail-label">地点</view><view class="detail-value">{{form.city}}{{form.city && form.address ? " · " : ""}}{{form.address}}</view></view>
      <view class="detail-row"><view class="detail-label">付款</view><view class="detail-value strong">{{bookingView.paymentStatusLabel}} · {{bookingView.amountText}}</view></view>
      <view class="detail-row" wx:if="{{form.bookingReference}}"><view class="detail-label">预订编号</view><view class="detail-value selectable">{{form.bookingReference}}</view></view>
      <view class="detail-row" wx:if="{{form.contact}}"><view class="detail-label">联系</view><view class="detail-value selectable">{{form.contact}}</view></view>
      <view class="detail-row" wx:if="{{form.note}}"><view class="detail-label">备注</view><view class="detail-value note">{{form.note}}</view></view>
    </view>

    <view class="section workflow-section">
      <view class="section-title">接下来</view>
      <view class="workflow-grid">
        <view class="workflow-item" bindtap="openTrip"><view class="workflow-icon blue"><ui-icon name="route" size="{{30}}" tone="blue" /></view><view class="workflow-title">{{tripTitle ? "查看行程" : "加入行程"}}</view><view class="workflow-desc">{{tripTitle || "放进行程日历"}}</view></view>
        <view class="workflow-item" bindtap="addToBudget"><view class="workflow-icon green"><ui-icon name="wallet" size="{{30}}" tone="green" /></view><view class="workflow-title">{{form.budgetExpenseId ? "查看预算" : "计入预算"}}</view><view class="workflow-desc">{{form.amountCents ? form.amountText : "需先填写金额"}}</view></view>
        <view class="workflow-item" bindtap="addToLedger"><view class="workflow-icon amber"><ui-icon name="users" size="{{30}}" tone="amber" /></view><view class="workflow-title">{{form.ledgerExpenseId ? "查看 AA 支出" : "记入 AA"}}</view><view class="workflow-desc">{{ledgerTitle || "选择付款人与参与人"}}</view></view>
        <view class="workflow-item" wx:if="{{canCreateReview}}" bindtap="recordVisit"><view class="workflow-icon accent"><ui-icon name="{{form.type === 'hotel' ? 'hotel' : 'utensils'}}" size="{{30}}" tone="accent" /></view><view class="workflow-title">{{form.recordId ? "查看体验" : "记录到访"}}</view><view class="workflow-desc">完成后评分与复盘</view></view>
      </view>
    </view>

    <view class="linked-strip" wx:if="{{wishlistName}}"><ui-icon name="heart" size="{{24}}" tone="amber" /><text>来自想去清单：{{wishlistName}}</text></view>
    <view class="bottom-actions"><button class="button secondary icon-action" bindtap="edit"><ui-icon name="edit" size="{{24}}" tone="blue" /><text>编辑</text></button><button class="button danger icon-action" bindtap="remove"><ui-icon name="trash" size="{{24}}" tone="accent" /><text>删除</text></button></view>
  </block>
</scroll-view>

<view class="missing" wx:if="{{missing}}"><view class="missing-icon"><ui-icon name="alert" size="{{42}}" tone="accent" /></view><view class="missing-title">找不到这条预订</view><view class="missing-desc">它可能已被删除或被备份恢复替换。</view><button class="button primary" bindtap="goBack">返回</button></view>
