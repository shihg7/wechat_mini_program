page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.hero {
  min-height: 240rpx;
  padding: 34rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 12rpx;
  max-width: 430rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 56rpx;
  word-break: break-all;
}

.summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 38rpx;
}

.score-card {
  width: 140rpx;
  min-width: 140rpx;
  height: 140rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.score-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 30rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.type-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.type-option {
  flex: 1;
  min-height: 68rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #4d596c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
}

.type-active {
  background: #172033;
  color: #ffffff;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
}

.field + .field {
  margin-top: 22rpx;
}

.grid .field + .field {
  margin-top: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #5b6678;
  font-size: 24rpx;
  line-height: 34rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 27rpx;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 176rpx;
  padding: 20rpx 22rpx;
  line-height: 40rpx;
}

.picker-value {
  color: #172033;
}

.category-head,
.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.category-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.category-score {
  min-width: 84rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.metric {
  margin-top: 26rpx;
}

.metric-label,
.metric-value {
  font-size: 25rpx;
  line-height: 36rpx;
}

.metric-label {
  color: #263248;
  font-weight: 700;
}

.metric-value {
  color: #667085;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.tag {
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  color: #4d596c;
  font-size: 24rpx;
  line-height: 56rpx;
  background: #fff;
}

.tag-active {
  border-color: #172033;
  background: #172033;
  color: #fff;
}

.tag-readonly {
  opacity: 0.92;
}

.score-overview {
  padding-bottom: 18rpx;
}

.score-bar {
  margin-top: 22rpx;
}

.score-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.score-bar-label,
.score-bar-value {
  font-size: 25rpx;
  line-height: 36rpx;
}

.score-bar-label {
  color: #263248;
  font-weight: 800;
}

.score-bar-value {
  color: #667085;
  font-weight: 700;
}

.score-track {
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 8rpx;
  background: #e7ebf1;
  overflow: hidden;
}

.score-fill {
  height: 14rpx;
  border-radius: 8rpx;
}

.custom-tag-editor {
  display: flex;
  gap: 12rpx;
}

.custom-tag-input {
  flex: 1;
  min-width: 0;
}

.tag-add-button {
  width: 128rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 84rpx;
  padding: 0;
}

.tag-add-button::after {
  border: none;
}

.custom-tags {
  margin-top: 18rpx;
}

.visibility-tabs {
  display: flex;
  gap: 12rpx;
}

.visibility-tab {
  flex: 1;
  min-height: 64rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #4d596c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.visibility-active {
  background: #172033;
  color: #ffffff;
}

.public-textarea {
  margin-top: 18rpx;
  min-height: 140rpx;
}

.public-preview {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  border: 1rpx solid #d9dee8;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
  word-break: break-all;
}

.preview-score {
  width: 72rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 60rpx;
  text-align: center;
}

.preview-meta,
.preview-note,
.preview-tags,
.privacy-hint {
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.preview-meta {
  margin-top: 10rpx;
}

.preview-note,
.preview-tags {
  margin-top: 8rpx;
}

.privacy-hint {
  margin-top: 14rpx;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-actions {
  flex-wrap: nowrap;
}

.button {
  flex: 1;
  min-width: 190rpx;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #172033;
}

.danger {
  background: #a34b32;
  color: #ffffff;
}
