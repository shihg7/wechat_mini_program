<scroll-view class="page" scroll-y wx:if="{{report}}">
  <view class="hero"><view><view class="eyebrow">DATA HEALTH</view><view class="title">待整理中心</view><view class="hero-meta">集中处理重复、缺失和失效数据</view></view><view class="total">{{report.total}}</view></view>
  <view class="clean" wx:if="{{!report.total}}"><view class="clean-title">目前很整齐</view><view class="clean-desc">没有发现需要处理的数据问题。</view></view>
  <view class="section" wx:if="{{report.duplicates.length}}"><view class="section-head"><view class="section-title">疑似重复地点</view><view class="count">{{report.duplicates.length}}</view></view><view class="row" wx:for="{{report.duplicates}}" wx:key="key"><view class="row-main" data-id="{{item.source.id}}" bindtap="goPlace"><view class="row-title">{{item.source.name}} / {{item.target.name}}</view><view class="row-meta">{{item.source.city || "未填写城市"}} · 进入地点页确认合并</view></view><view class="row-actions"><view class="link" data-id="{{item.source.id}}" bindtap="goPlace">处理</view><view class="ignore" data-source="{{item.source.id}}" data-target="{{item.target.id}}" bindtap="ignoreDuplicate">忽略</view></view></view></view>
  <view class="section" wx:if="{{report.incompletePlaces.length}}"><view class="section-head"><view class="section-title">地点信息待补充</view><view class="count">{{report.incompletePlaces.length}}</view></view><view class="row" wx:for="{{report.incompletePlaces}}" wx:key="id" data-id="{{item.id}}" bindtap="goPlace"><view><view class="row-title">{{item.name}}</view><view class="row-meta">{{!item.city ? "缺少城市" : ""}}{{!item.city && !item.address ? " · " : ""}}{{!item.address ? "缺少地址" : ""}}</view></view><view class="link">补充</view></view></view>
  <view class="section" wx:if="{{report.orphanRecords.length || report.unratedRecords.length || report.staleDrafts.length}}"><view class="section-head"><view class="section-title">体验记录待处理</view><view class="count">{{report.orphanRecords.length + report.unratedRecords.length + report.staleDrafts.length}}</view></view><view class="row" wx:for="{{report.orphanRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecord"><view><view class="row-title">{{item.displayName}}</view><view class="row-meta">缺少有效地点关联</view></view><view class="link">处理</view></view><view class="row" wx:for="{{report.unratedRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecord"><view><view class="row-title">{{item.displayName}}</view><view class="row-meta">已完成但未评分</view></view><view class="link">评分</view></view><view class="row" wx:for="{{report.staleDrafts}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecord"><view><view class="row-title">{{item.displayName}}</view><view class="row-meta">超过 30 天的草稿</view></view><view class="link">继续</view></view></view>
  <view class="section" wx:if="{{report.invalidPhotos.length || report.orphanPhotoPaths.length}}"><view class="section-head"><view class="section-title">照片文件</view><view class="count">{{report.invalidPhotos.length + report.orphanPhotoPaths.length}}</view></view><view class="row" wx:for="{{report.invalidPhotos}}" wx:key="key"><view><view class="row-title">{{item.record.displayName}}</view><view class="row-meta">{{item.photos.length}} 张照片已失效</view></view><view class="danger-link" data-id="{{item.record.id}}" bindtap="clearInvalidPhotos">清理元数据</view></view><view class="orphan-action" wx:if="{{report.orphanPhotoPaths.length}}"><view><view class="row-title">无主照片文件</view><view class="row-meta">{{report.orphanPhotoPaths.length}} 个文件未被任何记录引用</view></view><button class="small-danger" bindtap="clearOrphans">安全清理</button></view></view>
  <view class="section" wx:if="{{report.wishlistDuplicates.length}}"><view class="section-head"><view class="section-title">想去项可能已存在</view><view class="count">{{report.wishlistDuplicates.length}}</view></view><view class="row" wx:for="{{report.wishlistDuplicates}}" wx:key="key" data-id="{{item.item.id}}" bindtap="goWishlist"><view><view class="row-title">{{item.item.name}}</view><view class="row-meta">可能关联：{{item.suggestions[0].name}}</view></view><view class="link">确认</view></view></view>
</scroll-view>
