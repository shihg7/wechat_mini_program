.page{min-height:100vh;background:#f4f6f8;padding:28rpx 28rpx 150rpx;box-sizing:border-box;color:#172033}.hero{background:#172033;color:#fff;padding:36rpx;border-radius:8rpx}.eyebrow{font-size:20rpx;color:#9ab8ff;font-weight:700}.title{font-size:46rpx;font-weight:750;margin:10rpx 0}.meta{font-size:24rpx;color:#c5cedc}.hero-actions{display:flex;gap:12rpx;margin-top:28rpx}.hero-actions button{margin:0;background:#2b3547;color:#fff;font-size:23rpx;border-radius:6rpx}.hero-actions .budget{background:#fff;color:#172033}.warning{margin-top:18rpx;padding:20rpx;background:#fff1ed;color:#a34b32;border-radius:6rpx;font-size:24rpx}.day{margin-top:28rpx}.day-head{display:flex;justify-content:space-between}.day-title{font-size:30rpx;font-weight:700}.day-count{font-size:23rpx;color:#667085}.empty-day{padding:25rpx 0;color:#98a2b3;font-size:24rpx}.plan{display:flex;align-items:center;background:#fff;margin-top:12rpx;padding:23rpx;border-left:6rpx solid #2864d9;border-radius:6rpx}.plan.conflict{border-left-color:#c4472d}.time{width:95rpx;font-size:24rpx;font-weight:700}.plan-main{flex:1}.plan-title{font-size:27rpx;font-weight:650}.plan-meta{font-size:22rpx;color:#667085;margin-top:5rpx}.remove{font-size:22rpx;color:#a34b32}.form{background:#fff;margin-top:28rpx;padding:28rpx;border-radius:8rpx}.form-title{font-size:30rpx;font-weight:700;margin-bottom:20rpx}.input{background:#f3f5f7;padding:20rpx;border-radius:6rpx;margin-bottom:14rpx;font-size:25rpx}.types{display:flex;gap:8rpx;flex-wrap:wrap;margin-bottom:14rpx}.type{padding:12rpx 17rpx;background:#eef1f4;border-radius:5rpx;font-size:22rpx}.type.active{background:#172033;color:#fff}.time-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.save,.floating{background:#172033!important;color:#fff!important;border-radius:8rpx}.floating{position:fixed;left:28rpx;right:28rpx;bottom:35rpx}
