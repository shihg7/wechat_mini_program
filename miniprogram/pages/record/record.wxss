page {
  height: 100%;
  overflow: hidden;
  background: #f2f5f7;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.record-shell {
  height: 100vh;
  overflow: hidden;
}

.page {
  box-sizing: border-box;
  height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 44rpx);
}

.page-with-save-bar {
  padding-bottom: calc(env(safe-area-inset-bottom) + 176rpx);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 172rpx;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.title {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 50rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-meta {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 32rpx;
}

.score-panel {
  display: flex;
  flex: 0 0 128rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 112rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.score-panel.has-score {
  border-color: #72d0a8;
  background: rgba(31, 122, 85, 0.24);
}

.score-value {
  font-size: 40rpx;
  font-weight: 850;
  line-height: 47rpx;
}

.score-unit {
  color: rgba(255, 255, 255, 0.62);
  font-size: 19rpx;
  line-height: 27rpx;
}

.form-band {
  margin: 18rpx -28rpx 0;
  padding: 28rpx;
  border-top: 1rpx solid #e4e8ed;
  border-bottom: 1rpx solid #e4e8ed;
  background: #ffffff;
}

.section-heading,
.segments,
.segment,
.picker-value,
.score-input-row,
.detail-actions,
.save-bar-inner,
.icon-action,
.icon-center {
  display: flex;
  align-items: center;
}

.section-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 850;
  line-height: 40rpx;
}

.required-note,
.label {
  color: #667085;
  font-size: 22rpx;
  line-height: 31rpx;
}

.segments {
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: #eef2f5;
}

.segment {
  justify-content: center;
  gap: 9rpx;
  flex: 1;
  height: 66rpx;
  border-radius: 7rpx;
  color: #596579;
  font-size: 24rpx;
  font-weight: 800;
}

.segment.active {
  background: #2864d9;
  color: #ffffff;
}

.field {
  margin-top: 24rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.label {
  margin-bottom: 9rpx;
}

.input,
.score-input,
.textarea,
.readonly-value {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 25rpx;
}

.input {
  height: 78rpx;
  padding: 0 18rpx;
  line-height: 78rpx;
}

.input[disabled],
.textarea[disabled] {
  border-color: #e4e8ed;
  background: #f3f5f7;
  color: #354052;
}

.picker-value {
  justify-content: space-between;
  gap: 8rpx;
}

.score-input-row {
  position: relative;
}

.score-input {
  height: 78rpx;
  padding: 0 150rpx 0 18rpx;
}

.score-suffix {
  position: absolute;
  right: 20rpx;
  color: #667085;
  font-size: 23rpx;
  pointer-events: none;
}

.clear-score {
  position: absolute;
  right: 83rpx;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #eef2f5;
}

.clear-score::after,
.action-button::after,
.cancel-button::after,
.save-button::after,
.missing-button::after {
  border: 0;
}

.readonly-value {
  min-height: 78rpx;
  padding: 0 18rpx;
  line-height: 78rpx;
}

.score-readonly {
  color: #1f7a55;
  font-size: 28rpx;
  font-weight: 850;
}

.textarea {
  min-height: 190rpx;
  padding: 18rpx;
  line-height: 38rpx;
}

.detail-actions {
  gap: 10rpx;
  margin-top: 20rpx;
}

.action-button {
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  height: 74rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.action-button.primary {
  background: #2864d9;
  color: #ffffff;
}

.action-button.secondary {
  background: #ffffff;
  color: #172033;
}

.action-button.danger {
  background: #fff4f1;
  color: #a34b32;
}

.fixed-save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 16rpx);
  border-top: 1rpx solid #dfe4e9;
  background: rgba(255, 255, 255, 0.97);
}

.save-bar-inner {
  gap: 12rpx;
  width: 100%;
}

.cancel-button {
  justify-content: center;
  flex: 0 0 78rpx;
  width: 78rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #eef2f5;
}

.save-button {
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #2864d9;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 78rpx;
}

.missing-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 48rpx;
  text-align: center;
}

.missing-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 8rpx;
  background: #fff1ed;
}

.missing-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 42rpx;
}

.missing-button {
  justify-content: center;
  gap: 8rpx;
  width: 250rpx;
  height: 74rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #172033;
  font-size: 23rpx;
  font-weight: 800;
}

.icon-center {
  justify-content: center;
}
