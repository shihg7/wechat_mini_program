page{background:#eef2f5;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx)}.hero{display:flex;align-items:center;justify-content:space-between;padding:28rpx;border-radius:8rpx;background:#172033;color:#fff}.eyebrow{color:rgba(255,255,255,.65);font-size:21rpx}.title{margin-top:6rpx;font-size:40rpx;font-weight:800}.hero-meta{margin-top:6rpx;color:rgba(255,255,255,.75);font-size:22rpx}.total{width:92rpx;height:76rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:8rpx;font-size:36rpx;font-weight:800;line-height:76rpx;text-align:center}.section,.clean{margin-top:18rpx;padding:24rpx;border-radius:8rpx;background:#fff}.section-head,.row,.row-actions,.orphan-action{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section-title,.clean-title{font-size:29rpx;font-weight:800}.count{color:#667085;font-size:23rpx}.row{padding:18rpx 0;border-bottom:1rpx solid #e5e9f0}.row:last-child{border-bottom:0}.row-main{flex:1;min-width:0}.row-title{font-size:25rpx;font-weight:800;line-height:35rpx}.row-meta,.clean-desc{margin-top:3rpx;color:#667085;font-size:21rpx;line-height:31rpx}.row-actions{flex-shrink:0}.link,.ignore,.danger-link{font-size:22rpx;font-weight:800}.link{color:#2864d9}.ignore{color:#667085}.danger-link{color:#a34b32}.orphan-action{margin-top:16rpx;padding-top:18rpx;border-top:1rpx solid #e5e9f0}.small-danger{width:152rpx;height:62rpx;margin:0;padding:0;border-radius:8rpx;background:#f7e3df;color:#913626;font-size:22rpx;font-weight:800;line-height:62rpx}.small-danger::after{border:0}.clean{text-align:center}.clean-desc{margin-top:8rpx}
