page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.hero {
  min-height: 220rpx;
  padding: 34rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 12rpx;
  max-width: 420rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 56rpx;
  word-break: break-all;
}

.summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 38rpx;
}

.total-card {
  width: 176rpx;
  min-width: 176rpx;
  min-height: 136rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.total-value {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.total-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 30rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.section-head,
.member-row,
.settlement,
.expense {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.section-subtitle {
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
}

.field {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #5b6678;
  font-size: 24rpx;
  line-height: 34rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 27rpx;
  line-height: 84rpx;
}

.picker-value {
  color: #172033;
}

.member-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.member-check {
  min-height: 60rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #263248;
  font-size: 25rpx;
  line-height: 60rpx;
}

.actions {
  margin-top: 18rpx;
}

.button {
  width: 100%;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #172033;
}

.save-expense {
  margin-top: 24rpx;
}

.member-row,
.settlement,
.expense {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.member-name,
.settlement-flow,
.expense-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.member-meta,
.expense-meta,
.expense-note {
  color: #667085;
  font-size: 23rpx;
  line-height: 34rpx;
}

.balance,
.settlement-amount,
.expense-amount {
  min-width: 132rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.balance-positive {
  color: #1f7a55;
}

.balance-negative {
  color: #a34b32;
}

.settlement-amount,
.expense-amount {
  color: #172033;
}

.expense-main {
  flex: 1;
  min-width: 0;
}

.expense-side {
  min-width: 138rpx;
  text-align: right;
}

.delete-link {
  margin-top: 10rpx;
  color: #a34b32;
  font-size: 24rpx;
  line-height: 34rpx;
}

.empty-inner {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #667085;
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}
