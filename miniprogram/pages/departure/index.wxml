<view class="page">
  <view class="topbar">
    <view><view class="eyebrow">READY TO GO</view><view class="title">出发中心</view></view>
    <button class="add-button icon-action" bindtap="createBooking"><ui-icon name="plus" size="{{27}}" tone="white" /><text>预订</text></button>
  </view>

  <view class="summary-band">
    <view class="summary-item"><view class="summary-value">{{overview.upcomingCount}}</view><view class="summary-label">待出发</view></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><view class="summary-value">{{overview.urgentCount}}</view><view class="summary-label">需留意</view></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><view class="summary-value">{{overview.checklist.percent}}%</view><view class="summary-label">清单完成</view></view>
  </view>

  <view class="next-banner" wx:if="{{overview.nextBooking}}" data-id="{{overview.nextBooking.id}}" bindtap="openBooking">
    <view class="next-icon"><ui-icon name="plane" size="{{34}}" tone="blue" /></view>
    <view class="next-copy"><view class="next-label">下一项 · {{overview.nextBooking.timingLabel}}</view><view class="next-title">{{overview.nextBooking.name}}</view><view class="next-meta">{{overview.nextBooking.startDate}}{{overview.nextBooking.startTime ? " · " + overview.nextBooking.startTime : ""}}</view></view>
    <ui-icon name="chevron-right" size="{{26}}" tone="muted" />
  </view>

  <view class="main-tabs">
    <view class="main-tab {{activeTab === 'bookings' ? 'active' : ''}}" data-tab="bookings" bindtap="changeTab"><ui-icon name="calendar" size="{{25}}" tone="{{activeTab === 'bookings' ? 'white' : 'muted'}}" /><text>预订</text></view>
    <view class="main-tab {{activeTab === 'checklist' ? 'active' : ''}}" data-tab="checklist" bindtap="changeTab"><ui-icon name="clipboard" size="{{25}}" tone="{{activeTab === 'checklist' ? 'white' : 'muted'}}" /><text>行前清单</text></view>
  </view>

  <block wx:if="{{activeTab === 'bookings'}}">
    <view class="status-tabs">
      <view class="status-tab {{statusFilter === 'upcoming' ? 'active' : ''}}" data-status="upcoming" bindtap="filterStatus">待出发</view>
      <view class="status-tab {{statusFilter === 'completed' ? 'active' : ''}}" data-status="completed" bindtap="filterStatus">已完成</view>
      <view class="status-tab {{statusFilter === 'cancelled' ? 'active' : ''}}" data-status="cancelled" bindtap="filterStatus">已取消</view>
      <view class="status-tab {{statusFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="filterStatus">全部</view>
    </view>

    <view class="empty" wx:if="{{!visibleBookings.length}}">
      <view class="empty-icon"><ui-icon name="plane" size="{{42}}" tone="blue" /></view>
      <view class="empty-title">这里还没有预订</view>
      <view class="empty-desc">保存住宿、用餐、交通或门票，取消期限和出发倒计时会集中显示。</view>
      <button class="empty-button icon-action" bindtap="createBooking"><ui-icon name="plus" size="{{26}}" tone="white" /><text>新增预订</text></button>
    </view>

    <view class="booking-card" wx:for="{{visibleBookings}}" wx:key="id" data-id="{{item.id}}" bindtap="openBooking">
      <view class="booking-head"><view class="type-badge">{{item.typeLabel}}</view><view class="timing {{item.urgencyTone}}">{{item.timingLabel}}</view></view>
      <view class="booking-title">{{item.name}}</view>
      <view class="booking-meta"><ui-icon name="calendar" size="{{21}}" tone="muted" /><text>{{item.startDate}}{{item.startTime ? " · " + item.startTime : ""}}{{item.peopleCount > 1 ? " · " + item.peopleCount + " 人" : ""}}</text></view>
      <view class="deadline {{item.cancellationExpired ? 'expired' : ''}}" wx:if="{{item.cancellationLabel}}"><ui-icon name="clock" size="{{21}}" tone="{{item.cancellationExpired ? 'accent' : item.urgencyTone}}" /><text>{{item.cancellationLabel}}</text></view>
      <view class="booking-bottom"><view><view class="payment">{{item.paymentStatusLabel}}</view><view class="trip-name" wx:if="{{item.tripTitle}}">{{item.tripTitle}}</view></view><view class="amount">{{item.amountText}}</view></view>
    </view>
  </block>

  <block wx:if="{{activeTab === 'checklist'}}">
    <view class="checklist-head">
      <picker class="trip-picker" mode="selector" range="{{tripOptions}}" range-key="title" value="{{selectedTripIndex}}" bindchange="onTripChange"><view class="trip-select"><view><view class="field-label">当前清单</view><view class="trip-title">{{tripOptions[selectedTripIndex].title}}</view></view><ui-icon name="chevron-right" size="{{24}}" tone="muted" /></view></picker>
      <view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width: {{checklistSummary.percent}}%;"></view></view><view class="progress-text">{{checklistSummary.completed}} / {{checklistSummary.total}}</view></view>
    </view>

    <view class="template-row" bindtap="seedChecklist"><view class="template-icon"><ui-icon name="sparkles" size="{{29}}" tone="amber" /></view><view class="template-copy"><view class="template-title">补齐通用行前清单</view><view class="template-desc">证件、预订、通讯、保险、药品和充电设备</view></view><ui-icon name="chevron-right" size="{{24}}" tone="muted" /></view>

    <view class="task-form"><input class="task-input" placeholder="新增准备事项" value="{{newTaskTitle}}" data-field="newTaskTitle" bindinput="onTaskInput" /><input class="owner-input" placeholder="负责人（可选）" value="{{newTaskOwner}}" data-field="newTaskOwner" bindinput="onTaskInput" /><button class="task-add icon-center" bindtap="addTask" aria-label="添加任务"><ui-icon name="plus" size="{{27}}" tone="white" /></button></view>

    <view class="empty checklist-empty" wx:if="{{!checklistItems.length}}"><view class="empty-icon"><ui-icon name="clipboard" size="{{42}}" tone="green" /></view><view class="empty-title">清单还是空的</view><view class="empty-desc">使用模板快速开始，或者添加自己的准备事项。</view></view>

    <view class="task-row {{item.done ? 'done' : ''}}" wx:for="{{checklistItems}}" wx:key="id">
      <view class="task-check icon-center" data-id="{{item.id}}" bindtap="toggleTask"><ui-icon name="{{item.done ? 'check' : 'circle'}}" size="{{27}}" tone="{{item.done ? 'green' : 'muted'}}" /></view>
      <view class="task-copy" data-id="{{item.id}}" bindtap="toggleTask"><view class="task-title">{{item.title}}</view><view class="task-meta">{{item.category}}{{item.owner ? " · " + item.owner + " 负责" : ""}}</view></view>
      <view class="task-more icon-center" data-id="{{item.id}}" catchtap="taskActions"><ui-icon name="more" size="{{25}}" tone="muted" /></view>
    </view>
  </block>
</view>
