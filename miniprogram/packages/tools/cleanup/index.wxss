page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.hero { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx; border-radius: 8rpx; background: #172033; color: #fff; }
.hero-copy { flex: 1; min-width: 0; }
.eyebrow { color: rgba(255,255,255,.65); font-size: 21rpx; }
.hero-title { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; }
.title { font-size: 40rpx; font-weight: 800; }
.hero-meta { margin-top: 6rpx; color: rgba(255,255,255,.75); font-size: 22rpx; }
.total { width: 92rpx; height: 76rpx; flex: none; border: 1rpx solid rgba(255,255,255,.25); border-radius: 8rpx; font-size: 36rpx; font-weight: 800; line-height: 76rpx; text-align: center; }
.section,
.clean { margin-top: 18rpx; padding: 24rpx; border-radius: 8rpx; background: #fff; }
.section-head,
.section-name,
.row,
.row-actions,
.row-link,
.orphan-action { display: flex; align-items: center; }
.section-head,
.row,
.orphan-action { justify-content: space-between; gap: 16rpx; }
.section-name { gap: 11rpx; min-width: 0; }
.section-icon,
.clean-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex: none; border-radius: 8rpx; background: #eef2f5; }
.icon-blue { background: #eaf1ff; }
.icon-green { background: #e7f4ef; }
.icon-accent { background: #f7e8e3; }
.icon-amber { background: #fff0de; }
.section-title,
.clean-title { font-size: 29rpx; font-weight: 800; }
.count { flex: none; min-width: 44rpx; height: 38rpx; padding: 0 8rpx; border-radius: 8rpx; background: #eef2f5; color: #667085; font-size: 21rpx; font-weight: 700; line-height: 38rpx; text-align: center; }
.row { padding: 18rpx 0; border-bottom: 1rpx solid #e5e9f0; }
.row:last-child { border-bottom: 0; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 25rpx; font-weight: 800; line-height: 35rpx; word-break: break-all; }
.row-meta,
.clean-desc { margin-top: 3rpx; color: #667085; font-size: 21rpx; line-height: 31rpx; }
.row-actions { flex: none; gap: 16rpx; }
.row-link { flex: none; gap: 2rpx; color: #2864d9; font-size: 22rpx; font-weight: 800; }
.link,
.ignore,
.danger-link { flex: none; font-size: 22rpx; font-weight: 800; }
.link { color: #2864d9; }
.ignore { color: #667085; }
.danger-link { color: #a34b32; }
.orphan-action { margin-top: 16rpx; padding-top: 18rpx; border-top: 1rpx solid #e5e9f0; }
.small-danger { display: flex; align-items: center; justify-content: center; gap: 6rpx; width: 164rpx; height: 62rpx; flex: none; margin: 0; padding: 0; border-radius: 8rpx; background: #f7e3df; color: #913626; font-size: 22rpx; font-weight: 800; line-height: 30rpx; }
.small-danger::after { border: 0; }
.clean { padding: 42rpx 24rpx; text-align: center; }
.clean-icon { margin: 0 auto 16rpx; background: #e7f4ef; }
.clean-desc { margin-top: 8rpx; }
