.page{min-height:100vh;background:#f4f6f8;padding:28rpx;box-sizing:border-box;color:#172033}.hero{display:flex;justify-content:space-between;align-items:flex-start;padding:24rpx 4rpx 34rpx}.eyebrow{font-size:20rpx;color:#2864d9;font-weight:700}.title{font-size:54rpx;font-weight:750;margin-top:8rpx}.subtitle{font-size:25rpx;color:#667085;margin-top:8rpx}.add,.primary{background:#172033!important;color:#fff!important;border-radius:8rpx;font-size:26rpx}.add{margin:6rpx 0 0;padding:0 28rpx}.group-title{font-size:24rpx;font-weight:700;color:#667085;margin:28rpx 4rpx 14rpx}.trip-card{background:#fff;border:1rpx solid #e4e8ee;border-radius:8rpx;padding:28rpx;margin-bottom:16rpx}.trip-top{display:flex;justify-content:space-between;align-items:center}.trip-title{font-size:32rpx;font-weight:700}.count{font-size:22rpx;color:#2864d9}.trip-meta,.trip-date{font-size:24rpx;color:#667085;margin-top:12rpx}.empty{text-align:center;background:#fff;padding:70rpx 35rpx;border-radius:8rpx}.empty-title{font-size:34rpx;font-weight:700}.empty-copy{font-size:25rpx;color:#667085;margin:18rpx 0 30rpx}
