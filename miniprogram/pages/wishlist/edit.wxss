page{background:#eef2f5;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx)}.hero{padding:28rpx;border-radius:8rpx;background:#172033;color:#fff}.eyebrow{color:rgba(255,255,255,.66);font-size:21rpx}.title{margin-top:8rpx;font-size:40rpx;font-weight:800;line-height:54rpx;word-break:break-all}.hero-meta{margin-top:8rpx;color:rgba(255,255,255,.76);font-size:23rpx}.section,.suggestions{margin-top:18rpx;padding:24rpx;border-radius:8rpx;background:#fff}.segments{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;border:1rpx solid #d9dee8;border-radius:8rpx}.segments.three{grid-template-columns:repeat(3,1fr)}.segment{height:66rpx;border-right:1rpx solid #d9dee8;color:#667085;font-size:23rpx;font-weight:700;line-height:66rpx;text-align:center}.segment:last-child{border-right:0}.segment.active{background:#2864d9;color:#fff}.field{margin-top:18rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.label{margin-bottom:8rpx;color:#667085;font-size:23rpx}.label.spaced{margin-top:22rpx}.input{width:100%;height:78rpx;box-sizing:border-box;padding:0 18rpx;border:1rpx solid #d9dee8;border-radius:8rpx;background:#f8fafc;font-size:25rpx}.picker{line-height:78rpx}.textarea{width:100%;height:150rpx;box-sizing:border-box;padding:16rpx 18rpx;border:1rpx solid #d9dee8;border-radius:8rpx;background:#f8fafc;font-size:25rpx}.map-button,.plain-button{width:100%;height:70rpx;margin-top:18rpx;border-radius:8rpx;background:#eef2f5;color:#2864d9;font-size:23rpx;font-weight:800;line-height:70rpx}.map-button::after,.plain-button::after,.button::after{border:0}.suggestion-title{font-size:27rpx;font-weight:800}.suggestion{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #e5e9f0}.suggestion-name{font-size:25rpx;font-weight:800}.suggestion-meta{color:#667085;font-size:21rpx}.link{color:#2864d9;font-size:23rpx;font-weight:800}.actions{display:flex;gap:12rpx;margin-top:18rpx}.button{flex:1;height:78rpx;padding:0 8rpx;border-radius:8rpx;font-size:25rpx;font-weight:800;line-height:78rpx}.primary{background:#2864d9;color:#fff}.secondary{background:#fff;color:#172033}.danger{background:#fff;color:#a34b32}
