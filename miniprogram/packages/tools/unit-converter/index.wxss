page {
  background: #f3f5f7;
  color: #182230;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  box-sizing: border-box;
}

.eyebrow {
  color: #176b68;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 24rpx;
}

.page-title {
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 22rpx;
}

.category-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 60rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5a6676;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 27rpx;
  text-align: center;
  overflow-wrap: anywhere;
}

.category-chip-active {
  border-color: #176b68;
  background: #176b68;
  color: #ffffff;
}

.result-panel {
  min-height: 238rpx;
  margin-top: 15rpx;
  padding: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #182230;
  color: #ffffff;
}

.result-label {
  color: #aeb8c6;
  font-size: 21rpx;
  font-weight: 800;
}

.result-value {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.result-value-small {
  font-size: 46rpx;
  line-height: 60rpx;
}

.result-value-compact {
  font-size: 36rpx;
  line-height: 50rpx;
}

.result-unit {
  margin-top: 8rpx;
  color: #d3dae4;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  overflow-wrap: anywhere;
}

.result-error {
  margin-top: 12rpx;
  color: #ffb4a4;
  font-size: 21rpx;
}

.convert-panel {
  margin-top: 14rpx;
  padding: 24rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 8rpx;
  background: #ffffff;
}

.field-label {
  margin-bottom: 9rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
}

.value-input,
.picker-field {
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #f8fafb;
  font-size: 25rpx;
  font-weight: 800;
}

.value-input {
  width: 100%;
}

.picker-field,
.category-note,
.primary-button,
.swap-button {
  display: flex;
  align-items: center;
}

.unit-field {
  margin-top: 20rpx;
}

.picker-field {
  min-height: 80rpx;
  height: auto;
  justify-content: space-between;
  gap: 10rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.picker-field text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 35rpx;
  white-space: normal;
  overflow-wrap: anywhere;
}

.swap-button {
  justify-content: center;
  gap: 8rpx;
  width: 190rpx;
  height: 58rpx;
  margin: 14rpx auto -6rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #edf4ff;
  color: #3568ad;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.swap-button::after,
.primary-button::after {
  border: 0;
}

.category-note {
  gap: 8rpx;
  margin-top: 18rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 30rpx;
}

.primary-button {
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 82rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
  background: #176b68 !important;
  color: #ffffff !important;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 82rpx;
}
