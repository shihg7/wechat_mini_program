page { background: #f3f5f7; color: #172033; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.intro { position: relative; overflow: hidden; padding: 34rpx 30rpx 30rpx; border-radius: 8rpx; background: #172033; color: #fff; box-shadow: 0 12rpx 30rpx rgba(23,32,51,.16); }
.intro-mark { position: absolute; top: 24rpx; right: 24rpx; padding: 5rpx 10rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 6rpx; color: rgba(255,255,255,.8); font-size: 18rpx; font-weight: 800; line-height: 28rpx; }
.eyebrow { color: #f1c75b; font-size: 22rpx; font-weight: 800; line-height: 32rpx; }
.title { max-width: 540rpx; margin-top: 8rpx; font-size: 42rpx; font-weight: 800; line-height: 56rpx; }
.description { max-width: 570rpx; margin-top: 14rpx; color: rgba(255,255,255,.72); font-size: 24rpx; line-height: 38rpx; }
.progress-row { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.progress-track { height: 10rpx; flex: 1; overflow: hidden; border-radius: 5rpx; background: rgba(255,255,255,.18); }
.progress-fill { height: 100%; border-radius: 5rpx; background: #f1c75b; transition: width .25s ease; }
.progress-text { width: 70rpx; flex-shrink: 0; color: rgba(255,255,255,.82); font-size: 22rpx; font-weight: 800; text-align: right; }
.done-panel { margin-top: 18rpx; padding: 22rpx 24rpx; border-left: 7rpx solid #176b68; border-radius: 8rpx; background: #e8f4f1; }
.done-title { color: #125a57; font-size: 27rpx; font-weight: 800; line-height: 38rpx; }
.done-desc { margin-top: 3rpx; color: #47716f; font-size: 22rpx; line-height: 32rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 34rpx; }
.section-title { font-size: 31rpx; font-weight: 800; line-height: 42rpx; }
.section-note { color: #7a8494; font-size: 21rpx; line-height: 32rpx; }
.step { display: flex; align-items: flex-start; gap: 22rpx; margin-top: 14rpx; padding: 26rpx 24rpx; border: 2rpx solid transparent; border-radius: 8rpx; background: #fff; }
.step:active { background: #f8fafc; }
.step.completed { border-color: #bdded5; background: #f8fcfb; }
.step-number { width: 66rpx; height: 66rpx; flex-shrink: 0; border-radius: 8rpx; background: #eef2f5; color: #4d596c; font-size: 23rpx; font-weight: 800; line-height: 66rpx; text-align: center; }
.completed .step-number { background: #176b68; color: #fff; font-size: 30rpx; }
.step-main { flex: 1; min-width: 0; }
.step-title { font-size: 28rpx; font-weight: 800; line-height: 40rpx; }
.step-desc { margin-top: 4rpx; color: #667085; font-size: 22rpx; line-height: 34rpx; }
.step-action { margin-top: 11rpx; color: #2864d9; font-size: 22rpx; font-weight: 800; line-height: 32rpx; }
.step-action text { margin-left: 4rpx; font-size: 28rpx; }
.finish-button, .restart-button { height: 82rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: 800; line-height: 82rpx; }
.finish-button::after, .restart-button::after { border: none; }
.finish-button { margin-top: 32rpx; background: #172033; color: #fff; }
.restart-button { margin-top: 12rpx; background: #fff; color: #4d596c; }
.privacy-note { margin-top: 18rpx; color: #8a93a1; font-size: 20rpx; line-height: 30rpx; text-align: center; }
