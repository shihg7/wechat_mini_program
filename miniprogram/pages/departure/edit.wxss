p:9rpx;margin-top:13rpx;padding:15rpx 18rpx;border-radius:8rpx;background:#fff9e7;color:#7d5319;font-size:21rpx}.bottom-actions{gap:12rpx;margin-top:14rpx}.bottom-actions .button{flex:1}.missing{box-sizing:border-box;min-height:100vh;padding:140rpx 40rpx;text-align:center}.missing-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;margin:0 auto;border-radius:8rpx;background:#f8eae6}.missing-title{margin-top:17rpx;font-size:29rpx;font-weight:850}.missing-desc{margin:8rpx 0 24rpx;color:#667085;font-size:22rpx;line-height:34rpx}
