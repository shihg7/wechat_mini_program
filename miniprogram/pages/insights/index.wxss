page { background: #eef2f5; color: #172033; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { box-sizing: border-box; min-height: 100vh; padding: 30rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.topbar,.hero,.section-head,.bar-row,.score-row,.rank-row,.revisit-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.eyebrow { color: #667085; font-size: 21rpx; line-height: 30rpx; }.title { margin-top: 4rpx; font-size: 44rpx; font-weight: 800; line-height: 58rpx; }
.year-picker { min-width: 170rpx; height: 66rpx; padding: 0 16rpx; border-radius: 8rpx; background: #fff; color: #263248; font-size: 24rpx; font-weight: 700; line-height: 66rpx; text-align: center; }
.hero { margin-top: 22rpx; padding: 28rpx 12rpx; border-radius: 8rpx; background: #172033; color: #fff; }.hero-stat { flex: 1; min-width: 0; text-align: center; }.hero-value { font-size: 38rpx; font-weight: 800; line-height: 48rpx; }.hero-label { margin-top: 5rpx; color: rgba(255,255,255,.7); font-size: 19rpx; line-height: 28rpx; }
.section { margin-top: 18rpx; padding: 24rpx; border-radius: 8rpx; background: #fff; }.section-title { font-size: 30rpx; font-weight: 800; line-height: 42rpx; }.section-title.compact { font-size: 27rpx; }.section-meta { color: #667085; font-size: 22rpx; }
.composition { display: flex; width: 100%; height: 22rpx; margin-top: 20rpx; overflow: hidden; border-radius: 6rpx; background: #eef2f5; }.composition-hotel { background: #2864d9; }.composition-restaurant { background: #a34b32; }
.best-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 18rpx; }.best-item { position: relative; min-height: 132rpx; padding: 18rpx; border-bottom: 1rpx solid #e5e9f0; box-sizing: border-box; }.best-item:nth-child(odd) { border-right: 1rpx solid #e5e9f0; }.best-label { color: #667085; font-size: 20rpx; line-height: 30rpx; }.best-name { max-width: calc(100% - 58rpx); margin-top: 6rpx; font-size: 25rpx; font-weight: 800; line-height: 34rpx; word-break: break-all; }.best-score { position: absolute; right: 16rpx; top: 48rpx; color: #2864d9; font-size: 30rpx; font-weight: 800; }
.bar-row,.score-row { margin-top: 14rpx; }.bar-label { width: 88rpx; color: #667085; font-size: 21rpx; }.bar-track,.score-track { flex: 1; height: 18rpx; overflow: hidden; border-radius: 5rpx; background: #eef2f5; }.bar-fill,.score-fill { height: 100%; background: #a34b32; }.bar-fill.blue { background: #2864d9; }.bar-value,.score-value { width: 48rpx; font-size: 22rpx; font-weight: 800; text-align: right; }.score-name { width: 180rpx; overflow: hidden; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.rank-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 26rpx; }.rank-row { margin-top: 14rpx; }.rank-name { min-width: 0; overflow: hidden; color: #4d596c; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.rank-count { color: #172033; font-size: 23rpx; font-weight: 800; }
.revisit-row { margin-top: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e5e9f0; }.revisit-name { font-size: 25rpx; font-weight: 800; line-height: 34rpx; }.revisit-meta { color: #667085; font-size: 21rpx; line-height: 30rpx; }.delta { min-width: 82rpx; font-size: 28rpx; font-weight: 800; text-align: right; }.up { color: #1f7a55; }.down { color: #a34b32; }
.empty { margin-top: 18rpx; padding: 56rpx 30rpx; border-radius: 8rpx; background: #fff; text-align: center; }.empty-title { font-size: 30rpx; font-weight: 800; }.empty-desc { margin-top: 10rpx; color: #667085; font-size: 23rpx; line-height: 36rpx; }
