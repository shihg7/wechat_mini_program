page{background:#eef2f5;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx)}.hero{padding:28rpx;border-radius:8rpx;background:#172033;color:#fff}.eyebrow{color:rgba(255,255,255,.65);font-size:21rpx}.title{margin-top:6rpx;font-size:40rpx;font-weight:800}.hero-meta{margin-top:7rpx;color:rgba(255,255,255,.75);font-size:22rpx}.section{margin-top:18rpx;padding:24rpx;border-radius:8rpx;background:#fff}.label,.section-meta{color:#667085;font-size:22rpx}.label.spaced{margin-top:20rpx}.input{width:100%;height:76rpx;margin-top:8rpx;padding:0 18rpx;box-sizing:border-box;border:1rpx solid #d9dee8;border-radius:8rpx;background:#f8fafc;font-size:25rpx}.segments{display:grid;grid-template-columns:repeat(3,1fr);margin-top:8rpx;overflow:hidden;border:1rpx solid #d9dee8;border-radius:8rpx}.segment{height:64rpx;border-right:1rpx solid #d9dee8;color:#667085;font-size:22rpx;font-weight:700;line-height:64rpx;text-align:center}.segment:last-child{border:0}.segment.active{background:#2864d9;color:#fff}.section-head,.order-row,.order-tools{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.section-title{font-size:29rpx;font-weight:800}.count{color:#2864d9;font-size:24rpx;font-weight:800}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:16rpx}.photo-item{position:relative;height:150rpx;overflow:hidden;border:3rpx solid transparent;border-radius:8rpx;background:#eef2f5}.photo-item.checked{border-color:#2864d9}.photo-item image{width:100%;height:100%}.missing{height:100%;color:#a34b32;font-size:20rpx;line-height:150rpx;text-align:center}.check{position:absolute;right:7rpx;top:7rpx;width:34rpx;height:34rpx;border-radius:50%;background:rgba(23,32,51,.8);color:#fff;font-size:22rpx;line-height:34rpx;text-align:center}.selected-order{margin-top:14rpx}.order-row{padding:12rpx 0;border-bottom:1rpx solid #e5e9f0}.order-name{font-size:22rpx}.order-tools view{width:42rpx;height:38rpx;border:1rpx solid #d9dee8;border-radius:6rpx;font-size:28rpx;line-height:34rpx;text-align:center}.option-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:15rpx}.option{height:58rpx;border-radius:8rpx;background:#eef2f5;color:#667085;font-size:22rpx;font-weight:700;line-height:58rpx;text-align:center}.option.active{background:#172033;color:#fff}.privacy{margin-top:16rpx;color:#8a5a19;font-size:21rpx;line-height:32rpx}.preview{position:relative;margin-top:18rpx;padding:26rpx;border-radius:8rpx;background:#f4f1eb}.preview-type{color:#667085;font-size:20rpx}.preview-title{max-width:80%;margin-top:7rpx;font-size:30rpx;font-weight:800;line-height:42rpx}.preview-meta,.preview-summary{margin-top:7rpx;color:#667085;font-size:22rpx;line-height:33rpx}.preview-score{position:absolute;right:26rpx;top:48rpx;color:#2864d9;font-size:36rpx;font-weight:800}.export-button{width:100%;height:82rpx;margin-top:18rpx;border-radius:8rpx;background:#2864d9;color:#fff;font-size:27rpx;font-weight:800;line-height:82rpx}.export-button::after{border:0}.hidden-canvas{position:fixed;left:-3000px;top:0;width:375px;height:1000px;pointer-events:none}
