.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 56rpx);
  background: #f3f5f7;
  color: #182230;
}
.topbar, .hero, .summary-group, .ledger-heading, .ledger-bottom { display: flex; align-items: center; justify-content: space-between; }
.eyebrow { color: #667085; font-size: 22rpx; font-weight: 600; line-height: 32rpx; }
.title { margin-top: 4rpx; font-size: 48rpx; font-weight: 800; line-height: 62rpx; }
.icon-button { width: 72rpx; height: 72rpx; padding: 0; border-radius: 8rpx; background: #182230; color: #fff; font-size: 34rpx; line-height: 68rpx; }
.hero { gap: 20rpx; margin-top: 22rpx; padding: 30rpx; border-radius: 8rpx; background: #182230; color: #fff; box-shadow: 0 8rpx 24rpx rgba(24,34,48,.12); }
.hero-main { flex: 1; min-width: 0; }
.hero-label, .hero-meta { color: rgba(255,255,255,.68); font-size: 21rpx; }
.hero-total { margin: 5rpx 0; font-size: 42rpx; font-weight: 800; line-height: 54rpx; }
.summary-group { flex-shrink: 0; gap: 28rpx; padding-left: 26rpx; border-left: 1rpx solid rgba(255,255,255,.18); }
.summary-item { text-align: center; }
.summary-value { font-size: 36rpx; font-weight: 800; }
.summary-label { margin-top: 3rpx; color: rgba(255,255,255,.68); font-size: 20rpx; }
.section-head { margin-top: 34rpx; }
.section-title { font-size: 32rpx; font-weight: 800; line-height: 44rpx; }
.section-subtitle { margin-top: 2rpx; color: #7a8494; font-size: 22rpx; }
.empty { margin-top: 20rpx; padding: 58rpx 34rpx 40rpx; border: 1rpx solid #e7eaee; border-radius: 8rpx; background: #fff; text-align: center; }
.empty-mark { width: 76rpx; height: 76rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #e7f4ef; color: #1f7a55; font-size: 34rpx; font-weight: 800; line-height: 76rpx; }
.empty-title { font-size: 34rpx; font-weight: 800; line-height: 46rpx; }
.empty-desc { max-width: 560rpx; margin: 14rpx auto 0; color: #667085; font-size: 25rpx; line-height: 40rpx; }
.button { height: 82rpx; border-radius: 8rpx; font-size: 27rpx; font-weight: 800; line-height: 82rpx; }
.primary { background: #182230; color: #fff; }
.empty-button { margin-top: 28rpx; }
.ledger-card { position: relative; margin-top: 14rpx; padding: 26rpx; border: 1rpx solid #e7eaee; border-radius: 8rpx; background: #fff; }
.ledger-heading { justify-content: flex-start; gap: 12rpx; padding-right: 170rpx; }
.ledger-title { min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 800; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-tag { flex: none; padding: 4rpx 10rpx; border-radius: 6rpx; font-size: 19rpx; font-weight: 700; }
.status-tag.active { background: #fff0de; color: #a35b12; }
.status-tag.settled { background: #e7f4ef; color: #1f7a55; }
.ledger-total { position: absolute; right: 26rpx; top: 25rpx; font-size: 30rpx; font-weight: 800; }
.ledger-meta { margin-top: 9rpx; color: #667085; font-size: 23rpx; line-height: 34rpx; }
.ledger-bottom { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f3; }
.remaining { color: #a34b32; font-size: 23rpx; font-weight: 700; }
.remaining.settled { color: #1f7a55; }
.manage { min-width: 100rpx; color: #2864d9; font-size: 23rpx; font-weight: 700; text-align: right; }
