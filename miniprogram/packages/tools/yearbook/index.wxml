<scroll-view class="page" scroll-y wx:if="{{model}}"><view class="topbar"><view><view class="eyebrow">TRAVEL YEARBOOK</view><view class="title">年度回忆册</view></view><picker mode="selector" range="{{yearLabels}}" value="{{yearIndex}}" bindchange="onYearChange"><view class="year">{{yearLabels[yearIndex]}}</view></picker></view><view class="hero"><view class="stat"><view class="value">{{model.insights.total}}</view><view class="label">体验</view></view><view class="stat"><view class="value">{{model.insights.cityTotal}}</view><view class="label">城市</view></view><view class="stat"><view class="value">{{model.insights.revisitPlaceTotal}}</view><view class="label">复访</view></view><view class="stat"><view class="value">{{model.insights.ratedTotal ? model.insights.averageScore : "--"}}</view><view class="label">均分</view></view></view><view class="empty" wx:if="{{!model.insights.total}}">这一年还没有已完成体验。</view><block wx:else><view class="section"><view class="field-label">回忆册标题</view><input class="input" value="{{preferences.title}}" bindinput="onTitleInput" /><view class="aa-toggle {{preferences.includeAa ? 'active' : ''}}" bindtap="toggleAa"><view><view class="toggle-title">私人 PDF 加入 AA 年度摘要</view><view class="toggle-meta">{{model.aaSummary.expenseCount}} 笔 · {{model.aaSummary.totalText}}</view></view><view class="switch">{{preferences.includeAa ? "开" : "关"}}</view></view></view><view class="section"><view class="section-head"><view><view class="section-title">年度照片</view><view class="section-meta">最多 24 张 · 当前 {{model.photos.length}}</view></view></view><view class="photo-grid"><view class="photo {{item.checked ? 'checked' : ''}}" wx:for="{{photoOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="togglePhoto"><image src="{{item.filePath}}" mode="aspectFill" /><view class="photo-name">{{item.recordName}}</view></view></view></view><view class="section"><view class="section-title">月度时间线</view><view class="month" wx:for="{{model.months}}" wx:key="month"><view class="month-label">{{item.label}}</view><view class="month-copy">{{item.count}} 次 · {{item.records[0].name}}</view></view></view><view class="actions"><button class="button share" loading="{{exporting}}" bindtap="exportLong">分享长图</button><button class="button pdf" loading="{{exporting}}" bindtap="exportPdf">私人 PDF</button></view></block><canvas type="2d" id="yearbookCanvas" class="hidden-canvas"></canvas></scroll-view>
