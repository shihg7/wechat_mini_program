<view class="page">
  <view class="hero"><view><view class="eyebrow">旅行计划</view><view class="title">我的行程</view><view class="subtitle">按天安排，预算和体验都不落下</view></view><button class="add" bindtap="createTrip">＋ 新建</button></view>
  <view class="filters"><input class="search" placeholder="搜索行程、城市或备注" value="{{keyword}}" bindinput="search"/><scroll-view class="status-scroll" scroll-x><view class="status-row"><view class="status-filter {{activeStatus === item.key ? 'active' : ''}}" wx:for="{{statuses}}" wx:key="key" data-status="{{item.key}}" bindtap="filterStatus">{{item.label}}</view></view></scroll-view></view>
  <view class="empty" wx:if="{{!trips.length}}"><view class="empty-mark">＋</view><view class="empty-title">从一次旅行开始</view><view class="empty-copy">确定日期和城市，再把想去的酒店、餐厅加入每天的安排。</view><view class="empty-steps"><view><text>1</text>创建行程</view><view><text>2</text>安排日程</view><view><text>3</text>管理预算</view></view><button class="primary" bindtap="createTrip">创建第一段行程</button></view>
  <view class="group" wx:for="{{groups}}" wx:key="key"><view class="group-title"><text>{{item.label}}</text><text>{{item.items.length}} 个</text></view><view class="trip-card" wx:for="{{item.items}}" wx:for-item="trip" wx:key="id" data-id="{{trip.id}}" bindtap="openTrip"><view class="trip-top"><view class="status {{trip.status}}">{{trip.statusLabel}}</view><view class="count">{{trip.progressText}}</view></view><view class="trip-title">{{trip.title}}</view><view class="trip-meta">{{trip.cityText}} · {{trip.dateText}}</view><view class="trip-foot"><view>{{trip.planCount}} 项日程</view><view>{{trip.budgetText}}</view><view class="arrow">›</view></view></view></view>
</view>
