<view class="page">
  <view class="topbar">
    <view>
      <view class="eyebrow">多人旅行分账</view>
      <view class="title">AA 账本</view>
    </view>
    <button class="icon-button square-icon-button" aria-label="新建账本" bindtap="createLedger"><ui-icon name="plus" size="{{34}}" tone="white" /></button>
  </view>

  <view class="hero">
    <view class="hero-main">
      <view class="hero-label"><ui-icon name="wallet" size="{{24}}" tone="white" /><text>按账本币种累计</text></view>
      <view class="hero-currency-totals" wx:if="{{currencyTotals.length}}">
        <view class="hero-currency-row" wx:for="{{currencyTotals}}" wx:key="baseCurrency"><text class="hero-currency-code">{{item.baseCurrency}}</text><text class="hero-currency-amount">{{item.totalText}}</text></view>
      </view>
      <view class="hero-total" wx:else>尚无账目</view>
      <view class="hero-meta">不同币种分别统计，不换算 · 共 {{totalCount}} 个账本</view>
    </view>
    <view class="summary-group">
      <view class="summary-item"><view class="summary-value">{{activeCount}}</view><view class="summary-label">待结算</view></view>
      <view class="summary-item"><view class="summary-value">{{settledCount}}</view><view class="summary-label">已结清</view></view>
    </view>
  </view>

  <view class="section-head" wx:if="{{ledgers.length}}">
    <view><view class="section-title section-title-icon"><ui-icon name="receipt" size="{{29}}" /><text>全部账本</text></view><view class="section-subtitle">点击账本查看支出与结算</view></view>
  </view>

  <view class="empty" wx:if="{{!ledgers.length}}">
    <view class="empty-mark"><ui-icon name="receipt" size="{{42}}" tone="green" /></view>
    <view class="empty-title">第一本账，从同行人开始</view>
    <view class="empty-desc">添加成员、记下谁付款和谁参与，系统会精确算出最后的转账方案。</view>
    <button class="button primary empty-button" bindtap="createLedger"><ui-icon name="plus" size="{{28}}" tone="white" /><text>新建第一本账</text></button>
  </view>

  <view class="ledger-card" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="ledger-heading"><view class="ledger-title">{{item.title || "未命名账本"}}</view><view class="status-tag {{item.status}}">{{item.statusText}}</view></view>
    <view class="ledger-total">{{item.totalText}}</view>
    <view class="ledger-meta">
      <view class="meta-item"><ui-icon name="pin" size="{{23}}" tone="muted" /><text>{{item.city || "未填写城市"}}</text></view>
      <view class="meta-item"><ui-icon name="wallet" size="{{23}}" tone="muted" /><text>{{item.baseCurrency}} 单币种</text></view>
      <view class="meta-item"><ui-icon name="users" size="{{23}}" tone="muted" /><text>{{item.memberCount}} 人</text></view>
      <view class="meta-item"><ui-icon name="receipt" size="{{23}}" tone="muted" /><text>{{item.expenseCount}} 笔</text></view>
    </view>
    <view class="ledger-bottom">
      <view class="remaining {{item.status}}">
        <ui-icon wx:if="{{item.status === 'empty'}}" name="receipt" size="{{24}}" tone="muted" />
        <ui-icon wx:elif="{{item.status === 'settled'}}" name="check" size="{{24}}" tone="green" />
        <ui-icon wx:else name="alert" size="{{24}}" tone="accent" />
        <text>{{item.status === "empty" ? "尚未记录支出" : item.status === "settled" ? "无需转账" : "待结算 " + item.remainingText}}</text>
      </view>
      <view class="manage" catchtap="manageLedger" data-id="{{item.id}}"><text>管理</text><ui-icon name="more" size="{{28}}" tone="blue" /></view>
    </view>
  </view>
</view>
