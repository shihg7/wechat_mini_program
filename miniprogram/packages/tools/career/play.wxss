page {
  background: #edf1f2;
  color: #172033;
}

.game-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.loading-page,
.missing-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 50rpx;
  box-sizing: border-box;
  text-align: center;
}

.loading-title {
  font-size: 26rpx;
  font-weight: 800;
}

.loading-track {
  width: 320rpx;
  height: 10rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #d7dde2;
}

.loading-fill {
  width: 62%;
  height: 100%;
  background: #3568ad;
}

.missing-icon {
  display: flex;
  justify-content: center;
}

.missing-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.missing-copy {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 34rpx;
}

.missing-button {
  width: 300rpx;
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
}

.missing-button::after,
.choice-button::after,
.primary-action::after,
.secondary-action::after {
  border: 0;
}

.fixed-status {
  flex: 0 0 190rpx;
  height: 190rpx;
  padding: 18rpx 24rpx 16rpx;
  box-sizing: border-box;
  background: #172033;
  color: #fff;
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 38rpx;
}

.progress-copy {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 19rpx;
  font-weight: 750;
}

.chapter-progress {
  color: #aeb9ca;
  font-weight: 500;
}

.run-mode {
  height: 30rpx;
  padding: 0 8rpx;
  border: 1rpx solid #53627a;
  border-radius: 5rpx;
  color: #e6af2e;
  font-size: 16rpx;
  line-height: 30rpx;
}

.progress-track {
  width: 210rpx;
  height: 10rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #3d4a60;
}

.progress-fill {
  height: 100%;
  background: #e6af2e;
}

.stats-bar {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  height: 112rpx;
  margin-top: 7rpx;
}

.stat-cell {
  min-width: 0;
  padding: 11rpx 8rpx 9rpx;
  border-top: 4rpx solid #6d9de0;
  border-radius: 6rpx;
  background: #26344a;
  box-sizing: border-box;
  text-align: center;
}

.stat-cell.tone-green {
  border-top-color: #57a58e;
}

.stat-cell.tone-coral {
  border-top-color: #e86343;
}

.stat-cell.tone-gold {
  border-top-color: #e6af2e;
}

.stat-cell.tone-navy {
  border-top-color: #a8c2ef;
}

.stat-cell.tone-red,
.stat-cell.warning {
  border-top-color: #f07868;
  background: #3b2d38;
}

.stat-label {
  overflow: hidden;
  color: #bfc8d6;
  font-size: 17rpx;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value {
  margin-top: 2rpx;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.stat-meter {
  height: 5rpx;
  margin-top: 8rpx;
  overflow: hidden;
  background: #4a566a;
}

.stat-meter-fill {
  height: 100%;
  background: #dbe4f1;
}

.stage-band {
  position: relative;
  flex: 0 0 200rpx;
  height: 200rpx;
  overflow: hidden;
  background: #243348;
}

.stage-art {
  width: 100%;
  height: 100%;
}

.stage-overlay {
  position: absolute;
  left: 24rpx;
  top: 20rpx;
  width: 360rpx;
  padding: 14rpx 16rpx;
  border-left: 5rpx solid #e6af2e;
  border-radius: 0 8rpx 8rpx 0;
  background: rgba(23, 32, 51, .9);
  color: #fff;
}

.stage-index {
  color: #e6af2e;
  font-size: 17rpx;
  font-weight: 850;
  line-height: 23rpx;
}

.stage-title {
  overflow: hidden;
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage-meta {
  overflow: hidden;
  color: #c0cadd;
  font-size: 18rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-scroll {
  flex: 1;
  min-height: 0;
  background: #f7f9fa;
}

.story-content {
  min-height: 100%;
  padding: 28rpx 30rpx 36rpx;
  box-sizing: border-box;
}

.career-context {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #dde3e7;
}

.persona-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 7rpx;
  background: #e8edf1;
}

.tone-context-blue {
  background: #e7eef9;
}

.tone-context-green {
  background: #e6f2ee;
}

.tone-context-accent {
  background: #fbe9e4;
}

.tone-context-amber {
  background: #fff2df;
}

.persona-copy {
  flex: 1;
  min-width: 0;
  margin-left: 11rpx;
}

.persona-kicker,
.style-kicker,
.turning-kicker,
.final-persona-kicker {
  color: #7b8493;
  font-size: 15rpx;
  font-weight: 750;
  line-height: 21rpx;
}

.persona-title {
  overflow: hidden;
  margin-top: 1rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 29rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.keyword-row {
  display: flex;
  flex-shrink: 0;
  gap: 5rpx;
  max-width: 260rpx;
}

.keyword-row text,
.ending-keywords text {
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 5rpx;
  background: #e8edf1;
  color: #667085;
  font-size: 15rpx;
  line-height: 30rpx;
}

.phase-panel {
  animation: story-rise .26s ease-out both;
}

.phase-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.novelty-badge {
  padding: 5rpx 9rpx;
  border-radius: 5rpx;
  background: #dceee7;
  color: #176b68;
  font-size: 16rpx;
  font-weight: 850;
}

.event-kind {
  color: #7b8493;
  font-size: 17rpx;
  font-weight: 750;
}

.phase-label {
  display: inline-block;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  background: #e6edf8;
  color: #3568ad;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 36rpx;
}

.phase-label.outcome-label {
  background: #e8f2ef;
  color: #176b68;
}

.phase-label.chapter-label {
  background: #fff2df;
  color: #9a6514;
}

.phase-label.ending-label {
  background: #fbe9e4;
  color: #a34b32;
}

.story-title {
  margin-top: 14rpx;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.story-body {
  display: block;
  margin-top: 18rpx;
  color: #344054;
  font-size: 25rpx;
  line-height: 43rpx;
  white-space: pre-wrap;
}

.delta-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.delta-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(50% - 5rpx);
  height: 58rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-left: 4rpx solid #98a2b3;
  border-radius: 6rpx;
  background: #fff;
  color: #667085;
  font-size: 21rpx;
}

.delta-item.positive {
  border-left-color: #176b68;
}

.delta-item.negative {
  border-left-color: #e86343;
}

.delta-value {
  color: #172033;
  font-size: 23rpx;
  font-weight: 900;
}

.echo-list {
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #dde3e7;
}

.echo-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 10rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 32rpx;
}

.career-signal {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-left: 5rpx solid #3568ad;
  border-radius: 0 8rpx 8rpx 0;
  background: #edf3fb;
}

.career-signal.signal-accent {
  border-left-color: #e86343;
  background: #fbece8;
}

.career-signal.signal-amber {
  border-left-color: #e6af2e;
  background: #fff5e5;
}

.career-signal.signal-green {
  border-left-color: #176b68;
  background: #eaf4f1;
}

.signal-title {
  color: #172033;
  font-size: 21rpx;
  font-weight: 900;
}

.signal-copy {
  margin-top: 2rpx;
  color: #667085;
  font-size: 18rpx;
  line-height: 28rpx;
}

.chapter-style {
  margin-top: 22rpx;
  padding: 17rpx 19rpx;
  border-left: 5rpx solid #3568ad;
  background: #edf3fb;
}

.style-title {
  margin-top: 2rpx;
  color: #3568ad;
  font-size: 25rpx;
  font-weight: 900;
}

.style-copy {
  margin-top: 4rpx;
  color: #667085;
  font-size: 19rpx;
  line-height: 29rpx;
}

.chapter-deltas {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 16rpx;
}

.chapter-delta {
  min-width: 0;
  padding: 9rpx 2rpx;
  border-top: 3rpx solid #98a2b3;
  background: #fff;
  text-align: center;
}

.chapter-delta.positive {
  border-top-color: #176b68;
}

.chapter-delta.negative {
  border-top-color: #e86343;
}

.chapter-delta text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-delta text:first-child {
  color: #7b8493;
  font-size: 14rpx;
}

.chapter-delta text:last-child {
  margin-top: 3rpx;
  font-size: 19rpx;
  font-weight: 900;
}

.turning-point {
  margin-top: 16rpx;
  color: #344054;
  font-size: 19rpx;
  line-height: 30rpx;
}

.turning-kicker {
  margin-bottom: 3rpx;
  color: #e86343;
}

.chapter-stamp,
.ending-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #176b68;
  border-radius: 0 8rpx 8rpx 0;
  background: #fff;
  color: #344054;
  font-size: 22rpx;
}

.final-persona {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #3568ad;
  background: #edf3fb;
}

.final-persona-title {
  margin-top: 1rpx;
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
}

.final-persona-copy {
  margin-top: 4rpx;
  color: #667085;
  font-size: 19rpx;
  line-height: 29rpx;
}

.ending-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.ending-number {
  margin-top: 18rpx;
  color: #7b8493;
  font-size: 18rpx;
  font-weight: 800;
}

.ending-title {
  color: #a34b32;
  font-size: 42rpx;
  line-height: 54rpx;
}

.ending-hint {
  border-left-color: #e6af2e;
  color: #7a5917;
}

.run-exploration {
  display: flex;
  align-items: center;
  gap: 13rpx;
  margin-top: 16rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #cfe2dc;
  border-radius: 8rpx;
  background: #f0f7f4;
}

.run-exploration-icon {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 7rpx;
  background: #dceee7;
}

.run-exploration-copy {
  min-width: 0;
}

.run-exploration-title {
  color: #173d38;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 30rpx;
}

.run-exploration-detail {
  margin-top: 3rpx;
  color: #55716c;
  font-size: 18rpx;
  line-height: 27rpx;
}

.fixed-actions {
  flex: 0 0 calc(448rpx + env(safe-area-inset-bottom));
  height: calc(448rpx + env(safe-area-inset-bottom));
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid #d6dce1;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(23, 32, 51, .08);
}

.fixed-actions.phase-scene {
  flex-basis: calc(468rpx + env(safe-area-inset-bottom));
  height: calc(468rpx + env(safe-area-inset-bottom));
}

.action-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 38rpx;
  color: #172033;
  font-size: 22rpx;
  font-weight: 850;
}

.action-heading text:last-child {
  color: #7b8493;
  font-size: 18rpx;
  font-weight: 500;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  margin-top: 9rpx;
}

.choice-button {
  display: flex;
  align-items: center;
  align-self: stretch;
  width: 100%;
  max-width: none;
  height: 96rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 10rpx 13rpx;
  box-sizing: border-box;
  border: 1rpx solid #d8dee3;
  border-radius: 8rpx;
  background: #f8fafb;
  color: #172033;
  font-size: 22rpx;
  line-height: normal;
  text-align: left;
  animation: choice-rise .22s ease-out both;
}

.choice-count-2 .choice-button {
  height: 128rpx;
  min-height: 128rpx;
}

.choice-count-3 .choice-button {
  height: 112rpx;
  min-height: 112rpx;
}

.choice-count-4 .choice-button {
  height: 88rpx;
  min-height: 88rpx;
}

.choice-button:nth-child(2) {
  animation-delay: 35ms;
}

.choice-button:nth-child(3) {
  animation-delay: 70ms;
}

.choice-button:nth-child(4) {
  animation-delay: 105ms;
}

.choice-button:active,
.choice-button-hover,
.choice-button.choosing {
  border-color: #3568ad;
  background: #edf3fb;
  transform: scale(.992);
}

.choice-button.disabled {
  opacity: .62;
}

.choice-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.choice-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.choice-number {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background: #172033;
  color: #fff;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 36rpx;
  text-align: center;
}

.choice-text {
  display: block;
  width: 100%;
  color: #172033;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 31rpx;
  word-break: break-all;
  white-space: normal;
}

.choice-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5rpx;
  margin-top: 5rpx;
}

.choice-tags text {
  height: 26rpx;
  padding: 0 7rpx;
  border-radius: 5rpx;
  background: #e8edf1;
  color: #667085;
  font-size: 14rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.feedback-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  margin-top: 30rpx;
  padding: 0 22rpx;
  border-left: 5rpx solid #176b68;
  border-radius: 0 8rpx 8rpx 0;
  background: #edf5f2;
}

.feedback-title {
  font-size: 25rpx;
  font-weight: 900;
}

.feedback-copy {
  margin-top: 4rpx;
  color: #667085;
  font-size: 20rpx;
}

.primary-action,
.secondary-action {
  width: 100%;
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.ending-secondary-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
}

.ending-secondary-row .secondary-action {
  width: 100%;
  margin-top: 0;
  padding: 0 10rpx;
  font-size: 22rpx;
}

@keyframes story-rise {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes choice-rise {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.primary-action {
  margin-top: 20rpx;
  background: #172033;
  color: #fff;
}

.chapter-action {
  background: #3568ad;
}

.ending-actions-title {
  margin-top: 28rpx;
  color: #667085;
  font-size: 21rpx;
  text-align: center;
}

.phase-ending .primary-action {
  margin-top: 18rpx;
  background: #e86343;
}

.secondary-action {
  margin-top: 12rpx;
  border: 1rpx solid #cfd8e5;
  background: #eef3f9;
  color: #3568ad;
}
