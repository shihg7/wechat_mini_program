page{background:#eef2f5;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx)}.topbar,.hero,.section-head,.aa-toggle,.month,.actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.eyebrow{color:#667085;font-size:21rpx}.title{margin-top:4rpx;font-size:42rpx;font-weight:800}.year{height:64rpx;padding:0 18rpx;border-radius:8rpx;background:#fff;font-size:23rpx;font-weight:700;line-height:64rpx}.hero{margin-top:20rpx;padding:26rpx 8rpx;border-radius:8rpx;background:#172033;color:#fff}.stat{flex:1;text-align:center}.value{font-size:36rpx;font-weight:800}.label{color:rgba(255,255,255,.7);font-size:20rpx}.section,.empty{margin-top:18rpx;padding:24rpx;border-radius:8rpx;background:#fff}.empty{text-align:center;color:#667085}.field-label,.section-meta,.toggle-meta{color:#667085;font-size:22rpx}.input{width:100%;height:76rpx;margin-top:8rpx;padding:0 18rpx;box-sizing:border-box;border:1rpx solid #d9dee8;border-radius:8rpx;background:#f8fafc;font-size:25rpx}.aa-toggle{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e5e9f0}.toggle-title,.section-title{font-size:27rpx;font-weight:800}.switch{width:66rpx;height:46rpx;border-radius:8rpx;background:#eef2f5;color:#667085;font-size:21rpx;font-weight:800;line-height:46rpx;text-align:center}.aa-toggle.active .switch{background:#2864d9;color:#fff}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:16rpx}.photo{position:relative;height:158rpx;overflow:hidden;border:3rpx solid transparent;border-radius:8rpx;background:#eef2f5}.photo.checked{border-color:#2864d9}.photo image{width:100%;height:100%}.photo-name{position:absolute;left:0;right:0;bottom:0;padding:5rpx 7rpx;overflow:hidden;background:rgba(23,32,51,.72);color:#fff;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.month{padding:15rpx 0;border-bottom:1rpx solid #e5e9f0}.month-label{width:80rpx;color:#2864d9;font-size:23rpx;font-weight:800}.month-copy{flex:1;overflow:hidden;color:#4d596c;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.actions{margin-top:18rpx}.button{flex:1;height:80rpx;border-radius:8rpx;font-size:25rpx;font-weight:800;line-height:80rpx}.button::after{border:0}.share{background:#2864d9;color:#fff}.pdf{background:#172033;color:#fff}.hidden-canvas{position:fixed;left:-3000px;top:0;width:595px;height:842px;pointer-events:none}
