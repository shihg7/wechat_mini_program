<scroll-view class="page" scroll-y wx:if="{{place}}">
  <view class="hero">
    <view class="eyebrow">{{place.typeLabel}} · PLACE ARCHIVE</view>
    <view class="title">{{place.name}}</view>
    <view class="hero-meta">{{place.city || "未填写城市"}}{{place.area ? " · " + place.area : ""}}</view>
    <view class="hero-address" wx:if="{{place.address}}" bindtap="openLocation">{{place.address}}</view>
  </view>

  <view class="stats">
    <view class="stat"><view class="stat-value">{{stats.visitCount}}</view><view class="stat-label">到访</view></view>
    <view class="stat"><view class="stat-value">{{stats.ratedCount ? stats.averageScore : "--"}}</view><view class="stat-label">个人均分</view></view>
    <view class="stat"><view class="stat-value">{{stats.ratedCount ? stats.bestScore : "--"}}</view><view class="stat-label">最高分</view></view>
    <view class="stat"><view class="stat-value delta {{stats.scoreDelta > 0 ? 'up' : stats.scoreDelta < 0 ? 'down' : ''}}">{{stats.ratedCount > 1 ? (stats.scoreDelta > 0 ? "+" + stats.scoreDelta : stats.scoreDelta) : "--"}}</view><view class="stat-label">较上次</view></view>
  </view>

  <view class="actions">
    <button class="button primary" bindtap="addVisit">{{place.type === "restaurant" ? "再次用餐" : "再次入住"}}</button>
    <button class="button secondary" bindtap="startEdit">编辑地点</button>
  </view>

  <view class="section" wx:if="{{editing}}">
    <view class="section-title">编辑地点</view>
    <view class="field"><view class="label">名称</view><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
    <view class="grid">
      <view class="field"><view class="label">城市</view><input class="input" value="{{form.city}}" data-field="city" bindinput="onInput" /></view>
      <view class="field"><view class="label">地区/分店</view><input class="input" value="{{form.area}}" data-field="area" bindinput="onInput" /></view>
    </view>
    <view class="field"><view class="label">地址</view><input class="input" value="{{form.address}}" data-field="address" bindinput="onInput" /></view>
    <view class="field"><view class="label">别名</view><input class="input" placeholder="英文名、简称，用顿号分隔" value="{{form.aliasesText}}" data-field="aliasesText" bindinput="onInput" /></view>
    <button class="map-button" bindtap="chooseLocation">从微信地图更新位置</button>
    <view class="actions compact"><button class="button primary" bindtap="savePlace">保存</button><button class="button secondary" bindtap="cancelEdit">取消</button></view>
  </view>

  <view class="section">
    <view class="section-head"><view class="section-title">多次到访</view><view class="section-count">{{visits.length}} 次</view></view>
    <view class="empty" wx:if="{{!visits.length}}">还没有到访记录。</view>
    <view class="visit" wx:for="{{visits}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecord">
      <view><view class="visit-date">{{item.stayDate || "未填写日期"}}</view><view class="visit-note">{{item.publicNote || item.note || item.verdict}}</view></view>
      <view class="visit-score">{{item.isRated ? item.overallScore : "--"}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{mergeCandidates.length}}">
    <view class="section-title">合并重复地点</view>
    <view class="section-desc">只有确认是同一家酒店或餐厅时才合并。</view>
    <view class="merge-item" wx:for="{{mergeCandidates}}" wx:key="id">
      <view><view class="merge-name">{{item.name}}</view><view class="merge-meta">{{item.city || "未填写城市"}} · {{item.visitCount}} 次到访</view></view>
      <view class="merge-action" data-id="{{item.id}}" bindtap="mergeInto">合并到这里</view>
    </view>
  </view>

  <button class="delete-button" bindtap="deletePlace">删除地点</button>
</scroll-view>
