page {
  background: #f3f6f4;
  color: #1c2521;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 0;
}

.header {
  padding: 8rpx 2rpx 24rpx;
}

.eyebrow {
  color: #147a61;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.title {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 54rpx;
}

.form-band {
  margin: 0 -28rpx;
  padding: 8rpx 28rpx 30rpx;
  border-top: 1rpx solid #e0e6e2;
  border-bottom: 1rpx solid #e0e6e2;
  background: #fff;
}

.field {
  margin-top: 22rpx;
}

.date-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
}

.label {
  margin-bottom: 8rpx;
  color: #5d6963;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d7dfda;
  border-radius: 12rpx;
  background: #f8faf9;
  color: #1c2521;
  font-size: 24rpx;
}

.input {
  height: 76rpx;
  padding: 0 17rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  line-height: 76rpx;
  white-space: nowrap;
}

.picker-value text {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
}

.textarea {
  height: 190rpx;
  padding: 16rpx 17rpx;
  line-height: 36rpx;
}

.bottom-spacer {
  height: 170rpx;
}

.save-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  border-top: 1rpx solid #dce3df;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(25, 45, 36, 0.08);
}

.save-button,
.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #147a61 !important;
  color: #fff !important;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 78rpx;
}

.save-button::after,
.back-button::after {
  border: 0;
}

.missing {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 150rpx 40rpx;
  text-align: center;
}

.missing-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  background: #f7e8e4;
}

.missing-title {
  margin: 20rpx 0 28rpx;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 42rpx;
}

.back-button {
  width: 300rpx;
  margin: 0 auto;
}
