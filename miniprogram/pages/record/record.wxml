<scroll-view class="page" scroll-y>
  <view class="hero">
    <view>
      <view class="eyebrow">{{pageText.eyebrow}}</view>
      <view class="title">{{pageText.title}}</view>
      <view class="summary">{{form.isRated ? form.overallScore : "未评分"}} · {{form.verdict}} · {{form.status === "draft" ? "草稿" : "已完成"}}</view>
    </view>
    <view class="score-card" wx:if="{{!isQuick}}">
      <view class="score-value">{{form.isRated ? form.overallScore : "--"}}</view>
      <view class="score-label">总分</view>
    </view>
    <view class="place-choice" wx:if="{{placeSuggestions.length && !isReadonly}}">
      <view class="place-choice-title">可能是你去过的地点</view>
      <view class="place-suggestion" wx:for="{{placeSuggestions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectPlaceSuggestion">
        <view><view class="suggestion-name">{{item.name}}</view><view class="suggestion-meta">{{item.city || "未填写城市"}} · {{item.address || "地址未填写"}}</view></view>
        <view class="suggestion-action">关联</view>
      </view>
      <button class="new-place-button" bindtap="createAsNewPlace">都不是，创建新地点</button>
    </view>
    <view class="linked-place" wx:if="{{form.placeId}}">
      <view><view class="linked-label">已关联地点</view><view class="linked-name">{{form.placeName || (recordType === 'restaurant' ? form.restaurantName : form.hotelName)}}</view></view>
      <view class="linked-action" wx:if="{{!isReadonly}}" bindtap="resetPlaceChoice">更换</view>
    </view>
  </view>

  <view class="section" wx:if="{{!isReadonly}}">
    <view class="field-label">录入模板</view>
    <scroll-view class="template-scroll" scroll-x><view class="template-row"><view class="template-chip" wx:for="{{templates}}" wx:key="id" wx:if="{{item.type === recordType}}" data-id="{{item.id}}" bindtap="applyFormTemplate">{{item.name}}</view><view class="template-chip save-template" bindtap="saveCurrentTemplate">保存当前模板</view></view></scroll-view>
    <view class="recent" wx:if="{{recentSuggestions}}"><view class="recent-title">历史建议</view><view class="recent-row"><view class="recent-chip" wx:if="{{recentSuggestions.city && !form.city}}" data-field="city" data-value="{{recentSuggestions.city}}" bindtap="useRecentSuggestion">城市 {{recentSuggestions.city}}</view><view class="recent-chip" wx:if="{{recentSuggestions.roomType && !form.roomType}}" data-field="roomType" data-value="{{recentSuggestions.roomType}}" bindtap="useRecentSuggestion">房型 {{recentSuggestions.roomType}}</view><view class="recent-chip" wx:if="{{recentSuggestions.cuisine && !form.cuisine}}" data-field="cuisine" data-value="{{recentSuggestions.cuisine}}" bindtap="useRecentSuggestion">菜系 {{recentSuggestions.cuisine}}</view></view></view>
  </view>

  <view class="section">
    <view class="type-switch" wx:if="{{mode === 'create'}}">
      <view class="type-option {{recordType === 'hotel' ? 'type-active' : ''}}" data-type="hotel" bindtap="onTypeChange">酒店</view>
      <view class="type-option {{recordType === 'restaurant' ? 'type-active' : ''}}" data-type="restaurant" bindtap="onTypeChange">米其林餐厅</view>
    </view>
    <view class="field">
      <view class="field-label">{{typeConfig.primaryFieldLabel}}</view>
      <input
        wx:if="{{recordType === 'hotel'}}"
        class="input"
        disabled="{{isReadonly}}"
        placeholder="{{typeConfig.titlePlaceholder}}"
        value="{{form.hotelName}}"
        data-field="hotelName"
        bindinput="onFieldInput"
      />
      <input
        wx:if="{{recordType === 'restaurant'}}"
        class="input"
        disabled="{{isReadonly}}"
        placeholder="{{typeConfig.titlePlaceholder}}"
        value="{{form.restaurantName}}"
        data-field="restaurantName"
        bindinput="onFieldInput"
      />
    </view>
    <view class="grid">
      <view class="field">
        <view class="field-label">标准地点名</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="未来用于合并同一家酒店/餐厅"
          value="{{form.placeName}}"
          data-field="placeName"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field">
        <view class="field-label">地点别名</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="英文名/简称/商圈名"
          value="{{form.placeAlias}}"
          data-field="placeAlias"
          bindinput="onFieldInput"
        />
      </view>
    </view>
    <view class="grid">
      <view class="field">
        <view class="field-label">地区/分店</view>
        <input class="input" disabled="{{isReadonly}}" placeholder="浦东 / 银座店" value="{{form.area}}" data-field="area" bindinput="onFieldInput" />
      </view>
      <view class="field">
        <view class="field-label">地图位置</view>
        <button class="location-button" disabled="{{isReadonly}}" bindtap="chooseLocation">{{form.address ? "重新选择" : "从地图选择"}}</button>
      </view>
    </view>
    <view class="field" wx:if="{{form.address}}">
      <view class="field-label">地址</view>
      <input class="input" disabled="{{isReadonly}}" value="{{form.address}}" data-field="address" bindinput="onFieldInput" />
    </view>
    <view class="grid">
      <view class="field">
        <view class="field-label">城市/地区</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="上海"
          value="{{form.city}}"
          data-field="city"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field">
        <view class="field-label">{{typeConfig.dateLabel}}</view>
        <picker mode="date" disabled="{{isReadonly}}" value="{{form.stayDate}}" bindchange="onDateChange">
          <view class="input picker-value">{{form.stayDate || "选择日期"}}</view>
        </picker>
      </view>
    </view>
    <view class="grid">
      <view class="field" wx:if="{{recordType === 'hotel'}}">
        <view class="field-label">房型</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="基础房/套房"
          value="{{form.roomType}}"
          data-field="roomType"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field" wx:if="{{recordType === 'hotel'}}">
        <view class="field-label">会员等级</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="金卡/钻卡"
          value="{{form.memberLevel}}"
          data-field="memberLevel"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field" wx:if="{{recordType === 'restaurant'}}">
        <view class="field-label">菜系</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="粤菜/法餐/日料"
          value="{{form.cuisine}}"
          data-field="cuisine"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field" wx:if="{{recordType === 'restaurant'}}">
        <view class="field-label">米其林等级</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="一星/二星/三星/入选"
          value="{{form.michelinLevel}}"
          data-field="michelinLevel"
          bindinput="onFieldInput"
        />
      </view>
    </view>
    <view class="grid" wx:if="{{recordType === 'restaurant'}}">
      <view class="field">
        <view class="field-label">餐段</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="午餐/晚餐"
          value="{{form.mealPeriod}}"
          data-field="mealPeriod"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field">
        <view class="field-label">人均/套餐</view>
        <input
          class="input"
          disabled="{{isReadonly}}"
          placeholder="¥800/人"
          value="{{form.priceRange}}"
          data-field="priceRange"
          bindinput="onFieldInput"
        />
      </view>
    </view>
  </view>

  <view class="section score-overview" wx:if="{{!isQuick}}">
    <view class="field-label">维度评分</view>
    <view class="score-bar" wx:for="{{scoreBars}}" wx:key="key">
      <view class="score-bar-row">
        <view class="score-bar-label">{{item.title}}</view>
        <view class="score-bar-value">{{item.score}}</view>
      </view>
      <view class="score-track">
        <view class="score-fill" style="width: {{item.percent}}%; background: {{item.accent}};"></view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{!isQuick}}" wx:for="{{categories}}" wx:key="key">
    <view class="category-head">
      <view>
        <view class="category-title">{{item.title}}</view>
        <view class="category-subtitle">{{item.subtitle}}</view>
      </view>
      <view class="category-score">{{form.categoryScores[item.key]}}</view>
    </view>

    <view class="metric" wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="key">
      <view class="metric-row">
        <view class="metric-label">{{metric.label}}</view>
        <view class="metric-value">{{form.scores[item.key][metric.key]}} / 10</view>
      </view>
      <slider
        disabled="{{isReadonly}}"
        min="0"
        max="10"
        step="0.5"
        value="{{form.scores[item.key][metric.key]}}"
        activeColor="{{item.accent}}"
        backgroundColor="#d9dee8"
        block-size="22"
        data-category="{{item.key}}"
        data-metric="{{metric.key}}"
        bindchange="onScoreChange"
        bindchanging="onScoreChange"
      />
    </view>

    <view class="tag-list">
      <view
        class="tag {{form.selectedTags[item.key].indexOf(tag) >= 0 ? 'tag-active' : ''}} {{isReadonly ? 'tag-readonly' : ''}}"
        wx:for="{{item.tags}}"
        wx:for-item="tag"
        wx:key="*this"
        data-category="{{item.key}}"
        data-tag="{{tag}}"
        bindtap="onToggleTag"
      >
        {{tag}}
      </view>
    </view>
  </view>

  <view class="section photo-section">
    <view class="photo-head">
      <view>
        <view class="field-label photo-title">体验照片</view>
        <view class="photo-subtitle">{{form.photos.length}} / {{maxPhotos}} 张{{form.photos.length ? " · 点击照片预览" : ""}}</view>
      </view>
      <button class="photo-add-button" wx:if="{{!isReadonly && form.photos.length < maxPhotos}}" loading="{{addingPhotos}}" bindtap="addPhotos">添加照片</button>
    </view>
    <view class="photo-empty" wx:if="{{!form.photos.length}}">还没有照片，可以记录房间、餐食和现场细节。</view>
    <view class="photo-list" wx:for="{{form.photos}}" wx:key="id">
      <view class="photo-preview-wrap" data-id="{{item.id}}" bindtap="previewPhoto">
        <image class="photo-preview" wx:if="{{item.available !== false}}" src="{{item.filePath}}" mode="aspectFill" />
        <view class="photo-missing" wx:else>文件已失效</view>
        <view class="cover-badge" wx:if="{{form.coverPhotoId === item.id}}">封面</view>
      </view>
      <view class="photo-editor">
        <view class="photo-meta-row">
          <picker disabled="{{isReadonly}}" mode="selector" range="{{photoCategories}}" data-id="{{item.id}}" bindchange="onPhotoCategoryChange">
            <view class="photo-category">{{item.category}}</view>
          </picker>
          <view class="photo-tools" wx:if="{{!isReadonly}}">
            <view class="photo-icon" data-id="{{item.id}}" data-direction="-1" catchtap="movePhoto">‹</view>
            <view class="photo-icon" data-id="{{item.id}}" data-direction="1" catchtap="movePhoto">›</view>
            <view class="photo-cover-action" wx:if="{{form.coverPhotoId !== item.id}}" data-id="{{item.id}}" catchtap="setCoverPhoto">设封面</view>
            <view class="photo-delete" data-id="{{item.id}}" catchtap="removePhoto">删除</view>
          </view>
        </view>
        <input class="photo-caption" disabled="{{isReadonly}}" maxlength="40" placeholder="补充一句照片说明" value="{{item.caption}}" data-id="{{item.id}}" bindinput="onPhotoCaptionInput" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="field-label">自定义标签</view>
    <view class="custom-tag-editor" wx:if="{{!isReadonly}}">
      <input
        class="input custom-tag-input"
        placeholder="例如：适合纪念日 / 值得二刷"
        value="{{customTagInput}}"
        bindinput="onCustomTagInput"
      />
      <button class="tag-add-button" bindtap="addCustomTag">添加</button>
    </view>
    <view class="tag-list custom-tags" wx:if="{{form.customTags.length}}">
      <view
        class="tag tag-active {{isReadonly ? 'tag-readonly' : ''}}"
        wx:for="{{form.customTags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="removeCustomTag"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="section">
    <view class="field-label">补充观察</view>
    <textarea
      class="textarea"
      disabled="{{isReadonly}}"
      placeholder="{{recordType === 'restaurant' ? '记录菜品亮点、服务节奏、酒水搭配、订位难度等细节' : '记录排队情况、会员识别、儿童友好度、拍照点等细节'}}"
      value="{{form.note}}"
      maxlength="300"
      data-field="note"
      bindinput="onFieldInput"
    />
  </view>

  <view class="section">
    <view class="field-label">公开测评设置</view>
    <view class="visibility-tabs">
      <view class="visibility-tab {{form.visibility === 'private' ? 'visibility-active' : ''}}" data-visibility="private" bindtap="onVisibilityChange">私密</view>
      <view class="visibility-tab {{form.visibility === 'unlisted' ? 'visibility-active' : ''}}" data-visibility="unlisted" bindtap="onVisibilityChange">链接可见</view>
      <view class="visibility-tab {{form.visibility === 'public' ? 'visibility-active' : ''}}" data-visibility="public" bindtap="onVisibilityChange">公开</view>
    </view>
    <textarea
      class="textarea public-textarea"
      disabled="{{isReadonly}}"
      placeholder="公开摘要，只写愿意给别人看的内容；精确日期、会员等级、价格默认不应写在这里"
      value="{{form.publicNote}}"
      maxlength="180"
      data-field="publicNote"
      bindinput="onFieldInput"
    />
    <view class="public-preview">
      <view class="preview-head">
        <view class="preview-title">{{publicPreview.title}}</view>
        <view class="preview-score">{{form.isRated ? form.overallScore : "--"}}</view>
      </view>
      <view class="preview-meta">{{publicPreview.typeLabel}} · {{form.city || "未填写城市"}} · {{publicPreview.visitMonth}}</view>
      <view class="preview-note">{{publicPreview.summary}}</view>
      <view class="preview-tags">{{publicPreview.tags}}</view>
    </view>
    <view class="privacy-hint">公开预览不会展示精确日期、会员等级、价格和私密备注；这些字段未来只进入私有同步。</view>
  </view>

  <view class="actions" wx:if="{{mode === 'create' || mode === 'edit'}}">
    <button class="button primary" data-status="completed" bindtap="saveRecord">{{mode === "edit" ? "保存修改" : "保存记录"}}</button>
    <button class="button secondary" data-status="draft" bindtap="saveRecord">{{mode === "edit" ? "保存为草稿" : "保存草稿"}}</button>
    <button class="button secondary" wx:if="{{mode === 'edit'}}" bindtap="cancelEdit">取消</button>
  </view>

  <view class="actions detail-actions" wx:if="{{mode === 'detail'}}">
    <button class="button secondary" bindtap="goStory">生成回顾</button>
    <button class="button secondary" wx:if="{{form.placeId}}" bindtap="goPlaceDetail">查看地点</button>
    <button class="button primary" bindtap="enterEdit">编辑记录</button>
    <button class="button secondary" bindtap="copyRecord">复制记录</button>
    <button class="button danger" bindtap="deleteRecord">删除记录</button>
  </view>
</scroll-view>
