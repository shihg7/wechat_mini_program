page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.hero {
  padding: 34rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  box-sizing: border-box;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 38rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
}

.field + .field {
  margin-top: 22rpx;
}

.grid .field + .field {
  margin-top: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #5b6678;
  font-size: 24rpx;
  line-height: 34rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 27rpx;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 152rpx;
  padding: 20rpx 22rpx;
  line-height: 40rpx;
}

.members-textarea {
  min-height: 220rpx;
}

.picker-value {
  color: #172033;
}

.actions {
  margin-top: 24rpx;
}

.button {
  width: 100%;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}
