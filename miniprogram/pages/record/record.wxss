page {
  height: 100%;
  overflow: hidden;
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.record-shell {
  height: 100vh;
  overflow: hidden;
}

.page {
  box-sizing: border-box;
  height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.page-with-action-bar {
  padding-bottom: calc(env(safe-area-inset-bottom) + 174rpx);
}

.hero {
  min-height: 240rpx;
  padding: 34rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 12rpx;
  max-width: 430rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 56rpx;
  word-break: break-all;
}

.summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 38rpx;
}

.score-card {
  width: 140rpx;
  min-width: 140rpx;
  height: 140rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.score-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 30rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.photo-head,
.photo-list,
.photo-meta-row,
.photo-tools {
  display: flex;
  align-items: center;
}

.photo-head { justify-content: space-between; gap: 18rpx; }
.photo-title { margin-bottom: 2rpx; color: #172033; font-size: 30rpx; font-weight: 800; }
.photo-subtitle { color: #667085; font-size: 22rpx; line-height: 32rpx; }

.photo-add-button {
  width: 176rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}
.photo-add-button::after { border: 0; }
.photo-empty { margin-top: 18rpx; padding: 26rpx 18rpx; background: #f8fafc; color: #667085; font-size: 24rpx; line-height: 36rpx; text-align: center; }
.photo-list { align-items: stretch; gap: 18rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e5e9f0; }
.photo-preview-wrap { position: relative; width: 176rpx; min-width: 176rpx; height: 148rpx; overflow: hidden; border-radius: 8rpx; background: #eef2f5; }
.photo-preview { width: 100%; height: 100%; }
.photo-missing { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #a34b32; font-size: 22rpx; }
.cover-badge { position: absolute; left: 8rpx; bottom: 8rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: rgba(23, 32, 51, .86); color: #fff; font-size: 20rpx; line-height: 30rpx; }
.photo-editor { flex: 1; min-width: 0; }
.photo-meta-row { justify-content: space-between; gap: 10rpx; }
.photo-category { min-width: 86rpx; padding: 8rpx 12rpx; border-radius: 6rpx; background: #eef5ff; color: #2864d9; font-size: 22rpx; font-weight: 700; line-height: 30rpx; text-align: center; }
.photo-tools { justify-content: flex-end; gap: 14rpx; }
.photo-icon { width: 38rpx; height: 38rpx; border: 1rpx solid #d9dee8; border-radius: 6rpx; color: #263248; font-size: 32rpx; line-height: 34rpx; text-align: center; }
.photo-cover-action, .photo-delete { font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.photo-cover-action { color: #2864d9; }
.photo-delete { color: #a34b32; }
.photo-caption { width: 100%; height: 66rpx; margin-top: 14rpx; padding: 0 16rpx; border: 1rpx solid #d9dee8; border-radius: 8rpx; background: #f8fafc; box-sizing: border-box; color: #263248; font-size: 24rpx; }

.type-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.type-option {
  flex: 1;
  min-height: 68rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #4d596c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
}

.type-active {
  background: #172033;
  color: #ffffff;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
}

.field + .field {
  margin-top: 22rpx;
}

.grid .field + .field {
  margin-top: 0;
}

.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 78rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7eaee;
}

.advanced-copy { min-width: 0; flex: 1; }
.advanced-title { color: #172033; font-size: 25rpx; font-weight: 800; line-height: 36rpx; }
.advanced-subtitle { margin-top: 2rpx; color: #7a8494; font-size: 21rpx; line-height: 31rpx; }
.advanced-content { padding-top: 2rpx; }

.field-label {
  margin-bottom: 12rpx;
  color: #5b6678;
  font-size: 24rpx;
  line-height: 34rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 27rpx;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

.location-button,
.new-place-button {
  width: 100%;
  height: 84rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #2864d9;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.location-button::after,
.new-place-button::after { border: none; }

.place-choice,
.linked-place {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f4f7fb;
  border: 1rpx solid #d9dee8;
}

.place-choice-title,
.linked-label { color: #667085; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.place-suggestion,
.linked-place { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.place-suggestion { padding: 16rpx 0; border-bottom: 1rpx solid #e3e7ed; }
.suggestion-name,
.linked-name { font-size: 26rpx; font-weight: 800; line-height: 38rpx; }
.suggestion-meta { margin-top: 3rpx; color: #667085; font-size: 21rpx; line-height: 30rpx; }
.suggestion-action,
.linked-action { flex-shrink: 0; color: #2864d9; font-size: 23rpx; font-weight: 800; }
.new-place-button { margin-top: 12rpx; background: #fff; }

.textarea {
  min-height: 176rpx;
  padding: 20rpx 22rpx;
  line-height: 40rpx;
}

.picker-value {
  color: #172033;
}

.category-head,
.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.category-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.category-score {
  min-width: 84rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.metric {
  margin-top: 26rpx;
}

.metric-label,
.metric-value {
  font-size: 25rpx;
  line-height: 36rpx;
}

.metric-label {
  color: #263248;
  font-weight: 700;
}

.metric-value {
  color: #667085;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.tag {
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  color: #4d596c;
  font-size: 24rpx;
  line-height: 56rpx;
  background: #fff;
}

.tag-active {
  border-color: #172033;
  background: #172033;
  color: #fff;
}

.tag-readonly {
  opacity: 0.92;
}

.score-overview {
  padding-bottom: 18rpx;
}

.score-intro {
  margin: 12rpx 0 18rpx;
  padding: 14rpx 16rpx;
  border-left: 5rpx solid #2864d9;
  background: #edf3ff;
  color: #4d5f7d;
  font-size: 21rpx;
  line-height: 32rpx;
}

.unrated-empty { padding-top: 28rpx; padding-bottom: 28rpx; }
.unrated-title { font-size: 27rpx; font-weight: 800; line-height: 38rpx; }
.unrated-desc { margin-top: 6rpx; color: #667085; font-size: 22rpx; line-height: 34rpx; }

.score-bar {
  margin-top: 22rpx;
}

.score-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.score-bar-label,
.score-bar-value {
  font-size: 25rpx;
  line-height: 36rpx;
}

.score-bar-label {
  color: #263248;
  font-weight: 800;
}

.score-bar-value {
  color: #667085;
  font-weight: 700;
}

.score-track {
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 8rpx;
  background: #e7ebf1;
  overflow: hidden;
}

.score-fill {
  height: 14rpx;
  border-radius: 8rpx;
}

.custom-tag-editor {
  display: flex;
  gap: 12rpx;
}

.custom-tag-input {
  flex: 1;
  min-width: 0;
}

.tag-add-button {
  width: 128rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 84rpx;
  padding: 0;
}

.tag-add-button::after {
  border: none;
}

.custom-tags {
  margin-top: 18rpx;
}

.public-textarea {
  margin-top: 18rpx;
  min-height: 140rpx;
}

.share-toggle { min-height: 64rpx; margin-top: 0; padding-top: 0; border-top: 0; }

.local-only-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #e7f4ef;
  color: #28644d;
  font-size: 21rpx;
  line-height: 32rpx;
}

.public-preview {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  border: 1rpx solid #d9dee8;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
  word-break: break-all;
}

.preview-score {
  width: 72rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 60rpx;
  text-align: center;
}

.preview-meta,
.preview-note,
.preview-tags,
.privacy-hint {
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.preview-meta {
  margin-top: 10rpx;
}

.preview-note,
.preview-tags {
  margin-top: 8rpx;
}

.privacy-hint {
  margin-top: 14rpx;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-actions {
  flex-wrap: wrap;
}

.button {
  flex: 1;
  min-width: 190rpx;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #172033;
}

.danger {
  background: #a34b32;
  color: #ffffff;
}

.fixed-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 16rpx);
  border-top: 1rpx solid #dce2ea;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -8rpx 24rpx rgba(23, 32, 51, .1);
}

.fixed-actions-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
}

.fixed-button,
.fixed-cancel {
  height: 84rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.fixed-button::after,
.fixed-cancel::after { border: 0; }

.fixed-cancel {
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 76rpx;
  background: #eef2f5;
  color: #172033;
}

.fixed-draft {
  flex: 0 0 196rpx;
  width: 196rpx;
  min-width: 196rpx;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  color: #172033;
}

.fixed-primary {
  flex: 1;
  min-width: 0;
  background: #2864d9;
  color: #ffffff;
}
.template-scroll{width:100%;white-space:nowrap}.template-row{display:flex;gap:12rpx;padding:8rpx 0}.template-chip,.recent-chip{display:inline-block;padding:14rpx 20rpx;background:#eef2f6;border-radius:6rpx;font-size:23rpx;color:#263248}.save-template{border:1rpx dashed #2864d9;color:#2864d9;background:#fff}.recent{margin-top:20rpx}.recent-title{font-size:22rpx;color:#667085;margin-bottom:10rpx}.recent-row{display:flex;gap:10rpx;flex-wrap:wrap}.recent-chip{background:#eaf1ff;color:#2054b2}
