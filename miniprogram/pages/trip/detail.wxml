<scroll-view class="page" scroll-y wx:if="{{trip}}">
  <view class="trip-header">
    <view class="header-top">
      <view class="destination icon-label">
        <ui-icon name="pin" size="{{24}}" tone="green" />
        <text>{{trip.destinationText}}</text>
      </view>
      <button class="more-button icon-center" bindtap="showTripActions" aria-label="更多行程操作">
        <ui-icon name="more" size="{{28}}" tone="muted" />
      </button>
    </view>
    <view class="title">{{trip.title}}</view>
    <view class="date-line icon-label">
      <ui-icon name="calendar" size="{{24}}" tone="muted" />
      <text>{{trip.startDate}} 至 {{trip.endDate}}</text>
    </view>
    <view class="trip-note" wx:if="{{trip.note}}">{{trip.note}}</view>
  </view>

  <view class="warning icon-label" wx:if="{{conflicts.length}}">
    <ui-icon name="alert" size="{{27}}" tone="accent" />
    <text>有 {{conflicts.length}} 处日程安排在同一时间</text>
  </view>

  <view class="timeline-head">
    <view class="section-title">日程</view>
    <view class="section-count">{{trip.items.length}} 项</view>
  </view>

  <view class="day" wx:for="{{days}}" wx:key="date">
    <view class="day-head">
      <view class="day-title">{{item.label}}</view>
      <view class="day-count">{{item.items.length}} 项</view>
    </view>
    <view class="empty-day icon-label" wx:if="{{!item.items.length}}">
      <ui-icon name="circle" size="{{23}}" tone="muted" />
      <text>暂无安排</text>
    </view>
    <view
      class="plan {{plan.conflict ? 'conflict' : ''}}"
      wx:for="{{item.items}}"
      wx:for-item="plan"
      wx:key="id"
      data-id="{{plan.id}}"
      bindtap="editItem"
    >
      <view class="time">{{plan.time || "待定"}}</view>
      <view class="plan-main">
        <view class="plan-title-row">
          <view class="plan-title">{{plan.title}}</view>
          <view class="conflict-label" wx:if="{{plan.conflict}}">时间冲突</view>
        </view>
        <view class="plan-meta icon-label" wx:if="{{plan.location}}">
          <ui-icon name="pin" size="{{20}}" tone="muted" />
          <text>{{plan.location}}</text>
        </view>
        <view class="plan-note" wx:if="{{plan.note}}">{{plan.note}}</view>
      </view>
      <view class="item-more icon-center" data-id="{{plan.id}}" catchtap="showItemActions" aria-label="更多日程操作">
        <ui-icon name="more" size="{{26}}" tone="muted" />
      </view>
    </view>
  </view>

  <view class="item-editor" id="item-editor" wx:if="{{showForm}}">
    <view class="editor-title icon-label">
      <ui-icon name="{{editingItemId ? 'edit' : 'plus'}}" size="{{28}}" tone="green" />
      <text>{{editingItemId ? "编辑日程" : "新增日程"}}</text>
    </view>
    <view class="field">
      <view class="label">日程名称</view>
      <input
        class="input"
        maxlength="60"
        placeholder="例如：参观国立博物馆"
        value="{{itemForm.title}}"
        data-field="title"
        bindinput="input"
      />
    </view>
    <view class="date-time-grid">
      <view class="field">
        <view class="label">日期</view>
        <picker
          mode="date"
          value="{{itemForm.date}}"
          start="{{trip.startDate}}"
          end="{{trip.endDate}}"
          data-field="date"
          bindchange="choose"
        >
          <view class="input picker-value">{{itemForm.date || "选择日期"}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">时间</view>
        <picker mode="time" value="{{itemForm.time}}" data-field="time" bindchange="choose">
          <view class="input picker-value time-picker">
            <text>{{itemForm.time || "时间待定"}}</text>
            <ui-icon name="clock" size="{{22}}" tone="amber" />
          </view>
        </picker>
      </view>
    </view>
    <view class="clear-time icon-label" wx:if="{{itemForm.time}}" bindtap="clearTime">
      <ui-icon name="x" size="{{20}}" tone="muted" />
      <text>清除时间</text>
    </view>
    <view class="field">
      <view class="label">地点</view>
      <input
        class="input"
        maxlength="80"
        placeholder="可选"
        value="{{itemForm.location}}"
        data-field="location"
        bindinput="input"
      />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea
        class="textarea"
        maxlength="300"
        placeholder="可选"
        value="{{itemForm.note}}"
        data-field="note"
        bindinput="input"
      />
    </view>
  </view>
  <view class="bottom-spacer"></view>
</scroll-view>

<view class="save-bar two-buttons" wx:if="{{trip && !showForm}}">
  <button class="bar-button secondary icon-action" bindtap="edit">
    <ui-icon name="edit" size="{{25}}" tone="green" />
    <text>编辑行程</text>
  </button>
  <button class="bar-button primary icon-action" bindtap="openNewItem">
    <ui-icon name="plus" size="{{26}}" tone="white" />
    <text>新增日程</text>
  </button>
</view>

<view class="save-bar two-buttons" wx:if="{{trip && showForm}}">
  <button class="bar-button secondary icon-action" bindtap="cancelForm">
    <ui-icon name="x" size="{{24}}" tone="muted" />
    <text>取消</text>
  </button>
  <button class="bar-button primary icon-action" bindtap="saveItem">
    <ui-icon name="check" size="{{26}}" tone="white" />
    <text>{{editingItemId ? "保存修改" : "添加日程"}}</text>
  </button>
</view>

<view class="missing" wx:if="{{missing}}">
  <view class="missing-icon"><ui-icon name="alert" size="{{42}}" tone="accent" /></view>
  <view class="missing-title">找不到这段行程</view>
  <button class="back-button icon-action" bindtap="goBack">
    <ui-icon name="arrow-up" size="{{24}}" tone="white" />
    <text>返回上一页</text>
  </button>
</view>
