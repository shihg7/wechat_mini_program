<view class="page">
  <view class="topbar">
    <view>
      <view class="eyebrow">LOCAL DATA</view>
      <view class="title">数据设置</view>
    </view>
    <view class="local-badge">
      <ui-icon name="shield" size="{{25}}" tone="green" />
      <text>仅存本机</text>
    </view>
  </view>

  <view class="storage-band">
    <view class="storage-main">
      <text class="storage-label">当前本地占用</text>
      <text class="storage-value">{{localSummary.storageText}}</text>
    </view>
    <view class="storage-side">
      <text>上次备份</text>
      <text class="storage-date">{{localSummary.lastBackupText}}</text>
    </view>
  </view>

  <view class="summary-grid">
    <view class="summary-item"><text class="summary-value">{{localSummary.recordCount}}</text><text class="summary-label">快评</text></view>
    <view class="summary-item"><text class="summary-value">{{localSummary.tripCount}}</text><text class="summary-label">行程</text></view>
    <view class="summary-item"><text class="summary-value">{{localSummary.checklistCount}}</text><text class="summary-label">清单</text></view>
    <view class="summary-item"><text class="summary-value">{{localSummary.ledgerCount}}</text><text class="summary-label">账本</text></view>
    <view class="summary-item"><text class="summary-value">{{localSummary.wheelCount}}</text><text class="summary-label">转盘</text></view>
    <view class="summary-item"><text class="summary-value">{{localSummary.careerCount}}</text><text class="summary-label">生涯</text></view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-icon icon-blue"><ui-icon name="download" size="{{32}}" tone="blue" /></view>
      <view class="section-copy">
        <view class="section-title">导出完整备份</view>
        <view class="section-subtitle">生成一个 JSON 文件，包含六个工具的全部本地数据。</view>
      </view>
    </view>
    <button class="button primary" loading="{{exporting}}" bindtap="exportBackup">
      <ui-icon name="download" size="{{28}}" tone="white" />
      <text>导出并发送备份</text>
    </button>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-icon icon-green"><ui-icon name="upload" size="{{32}}" tone="green" /></view>
      <view class="section-copy">
        <view class="section-title">从备份恢复</view>
        <view class="section-subtitle">支持当前 v2 备份，也兼容此前生成的 v1 JSON 备份。</view>
      </view>
    </view>
    <button class="button secondary" bindtap="chooseBackup">
      <ui-icon name="file" size="{{28}}" />
      <text>选择 JSON 文件</text>
    </button>

    <view class="preview" wx:if="{{preview}}">
      <view class="file-row">
        <ui-icon name="file" size="{{28}}" tone="blue" />
        <text class="file-name">{{selectedFileName}}</text>
      </view>
      <view class="preview-time">导出于 {{preview.exportedAtText}}</view>
      <view class="preview-grid">
        <view><text class="metric">{{preview.recordCount}}</text><text class="metric-label">快评</text></view>
        <view><text class="metric">{{preview.tripCount}}</text><text class="metric-label">行程</text></view>
        <view><text class="metric">{{preview.checklistCount}}</text><text class="metric-label">清单</text></view>
        <view><text class="metric">{{preview.ledgerCount}}</text><text class="metric-label">账本</text></view>
        <view><text class="metric">{{preview.wheelCount}}</text><text class="metric-label">转盘</text></view>
        <view><text class="metric">{{preview.careerCount}}</text><text class="metric-label">生涯</text></view>
      </view>
      <view class="action-row">
        <button class="button merge" loading="{{importing}}" data-mode="merge" bindtap="confirmImport">合并导入</button>
        <button class="button danger" loading="{{importing}}" data-mode="replace" bindtap="confirmImport">覆盖本地</button>
      </view>
    </view>
  </view>

  <view class="section danger-section">
    <view class="section-head">
      <view class="section-icon icon-danger"><ui-icon name="trash" size="{{32}}" tone="accent" /></view>
      <view class="section-copy">
        <view class="section-title">清空本地数据</view>
        <view class="section-subtitle">一次删除六个工具的全部内容，不影响已发送到外部的备份文件。</view>
      </view>
    </view>
    <button class="button danger" loading="{{clearing}}" bindtap="confirmClear">
      <ui-icon name="trash" size="{{28}}" tone="accent" />
      <text>清空全部数据</text>
    </button>
  </view>

  <view class="privacy-note">
    <ui-icon name="shield" size="{{28}}" tone="green" />
    <text>本应用没有账号、云同步或后台服务。删除小程序或清理微信数据前，请先导出备份。</text>
  </view>
</view>
