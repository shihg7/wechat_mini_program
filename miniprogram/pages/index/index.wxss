page {
  background: #f4f6f8;
  color: #182230;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  flex: none;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 56rpx;
  letter-spacing: 0;
}

.top-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.top-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  height: 64rpx;
  min-width: 0;
  margin: 0;
  padding: 0 14rpx;
  box-sizing: border-box;
  border: 1rpx solid #d8dee8;
  border-radius: 8rpx;
  background: #ffffff;
  color: #3f4b5d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
}

.top-action::after,
.tool-card::after {
  border: none;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-auto-rows: 184rpx;
  gap: 14rpx;
  margin-top: 28rpx;
}

.tool-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  height: 184rpx;
  margin: 0;
  padding: 22rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid #dfe4eb;
  border-radius: 8rpx;
  background: #ffffff;
  color: #182230;
  line-height: normal;
  text-align: left;
}

.tool-card:active {
  background: #eef2f5;
}

.tool-card-review {
  grid-column: 1 / -1;
  width: calc((100% - 14rpx) / 2);
  justify-self: center;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background: #edf0f4;
}

.tool-icon-blue {
  background: #e8f0ff;
}

.tool-icon-green {
  background: #e5f3ed;
}

.tool-icon-amber {
  background: #fff0dc;
}

.tool-icon-accent {
  background: #f6e7e2;
}

.tool-icon-default {
  background: #edf0f4;
}

.tool-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
}

.tool-label {
  min-width: 0;
  color: #182230;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
  letter-spacing: 0;
  overflow-wrap: break-word;
}
