page{background:#f2f5f6;color:#172033}.page{height:100vh;padding:24rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);box-sizing:border-box;display:flex;flex-direction:column}.topbar,.wheel-switch,.wheel-actions,.editor-toggle,.history-head,.option,.option-main,.option-tools,.result-actions{display:flex;align-items:center;justify-content:space-between}.eyebrow{font-size:20rpx;color:#667085;font-weight:700}.title{font-size:42rpx;font-weight:800;margin-top:4rpx}.icon-button{width:68rpx;height:68rpx;margin:0;padding:0;background:#172033;color:#fff;border-radius:8rpx;line-height:68rpx}.wheel-switch{margin-top:16rpx}.wheel-name{font-size:28rpx;font-weight:800}.wheel-actions{gap:22rpx;color:#2864d9;font-size:22rpx}.danger{color:#a34b32!important}.stage{position:relative;width:min(660rpx,42vh);height:min(660rpx,42vh);min-height:430rpx;margin:18rpx auto 0}.wheel-canvas{width:100%;height:100%;touch-action:none}.pointer{position:absolute;z-index:2;left:50%;top:-5rpx;width:0;height:0;transform:translateX(-50%);border-left:20rpx solid transparent;border-right:20rpx solid transparent;border-top:46rpx solid #172033;filter:drop-shadow(0 4rpx 3rpx rgba(0,0,0,.18))}.spin-hint{text-align:center;color:#667085;font-size:22rpx;margin-top:2rpx}.spin-button{width:100%;height:82rpx;margin-top:14rpx;background:#172033!important;color:#fff!important;border-radius:8rpx;font-size:27rpx;font-weight:800;line-height:82rpx}.spin-button[disabled]{background:#aeb5c0!important}.editor-toggle{height:64rpx;margin-top:14rpx;padding:0 18rpx;background:#fff;border:1rpx solid #e1e6e9;border-radius:8rpx;font-size:22rpx;font-weight:700}.lower{flex:1;min-height:0}.editor{padding-top:14rpx}.batch{width:100%;height:130rpx;padding:18rpx;box-sizing:border-box;background:#fff;border:1rpx solid #dfe4e8;border-radius:8rpx;font-size:23rpx}.add-button{height:68rpx;margin-top:10rpx;background:#2864d9!important;color:#fff!important;border-radius:8rpx;font-size:24rpx;line-height:68rpx}.option{margin-top:10rpx;padding:16rpx;background:#fff;border-radius:8rpx;gap:12rpx}.option-main{flex:1;min-width:0;justify-content:flex-start;gap:12rpx}.option-index{width:38rpx;height:38rpx;border-radius:50%;background:#eef2f5;text-align:center;line-height:38rpx;font-size:20rpx}.option-text{overflow:hidden;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.option-tools{flex-shrink:0;gap:14rpx;color:#2864d9;font-size:20rpx}.disabled-option{opacity:.48}.history-head{margin-top:16rpx;padding:20rpx;background:#fff;border-radius:8rpx}.section-title{font-size:27rpx;font-weight:800}.section-meta{color:#667085;font-size:20rpx;margin-top:2rpx}.history{background:#fff;padding:0 20rpx 20rpx}.history-row{display:flex;justify-content:space-between;padding:15rpx 0;border-top:1rpx solid #edf0f3;font-size:22rpx}.history-row view:last-child{color:#667085}.empty{text-align:center;color:#98a2b3;padding:24rpx}.clear-history{text-align:center;color:#a34b32;font-size:22rpx;padding-top:16rpx}.result-mask{position:fixed;z-index:20;inset:0;background:rgba(10,16,28,.55);display:flex;align-items:flex-end}.result-sheet{width:100%;padding:42rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);box-sizing:border-box;background:#fff;border-radius:8rpx 8rpx 0 0;text-align:center}.result-label{color:#667085;font-size:23rpx}.result-value{margin:14rpx 0 30rpx;font-size:46rpx;font-weight:900;word-break:break-all}.result-actions{gap:12rpx}.result-actions button{flex:1;height:76rpx;border-radius:8rpx;font-size:24rpx}.again{background:#172033!important;color:#fff!important}.remove-winner{background:#eef2f5!important;color:#a34b32!important}.done{width:100%;height:70rpx;margin-top:12rpx;background:#fff!important;color:#2864d9!important;font-size:23rpx}
