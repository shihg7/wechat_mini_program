<view class="page">
  <view class="intro">
    <view class="intro-mark">DEMO</view>
    <view class="eyebrow">3 分钟快速上手</view>
    <view class="title">跟着真实场景走一遍</view>
    <view class="description">演示内容单独标记，随时退出并清理，不会覆盖你的个人数据。</view>
    <view class="progress-row">
      <view class="progress-track"><view class="progress-fill" style="width: {{percent}}%;"></view></view>
      <view class="progress-text">{{completed}} / {{total}}</view>
    </view>
  </view>

  <view class="done-panel" wx:if="{{allDone}}">
    <view class="done-title">核心功能已经走完</view>
    <view class="done-desc">现在可以结束演示，开始记录自己的旅程。</view>
  </view>

  <view class="section-head">
    <view class="section-title">上手任务</view>
    <view class="section-note">按任意顺序体验</view>
  </view>

  <view class="step {{item.completed ? 'completed' : ''}}" wx:for="{{steps}}" wx:key="id" data-id="{{item.id}}" bindtap="openStep" role="button" aria-label="{{item.title}}，{{item.completed ? '已完成' : item.action}}" hover-class="step-pressed" hover-stay-time="80">
    <view class="step-number">{{item.completed ? '✓' : item.number}}</view>
    <view class="step-main">
      <view class="step-title">{{item.title}}</view>
      <view class="step-desc">{{item.description}}</view>
      <view class="step-action">{{item.completed ? '再看一次' : item.action}} <text>›</text></view>
    </view>
  </view>

  <button class="finish-button" bindtap="finish">{{allDone ? '完成演示并清理数据' : '退出演示'}}</button>
  <button class="restart-button" bindtap="restart">重新开始</button>
  <view class="privacy-note">演示过程中新增的个人内容不会被清除。</view>
</view>
