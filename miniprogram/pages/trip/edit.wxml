<scroll-view class="page" scroll-y wx:if="{{!missing}}">
  <view class="hero"><view class="eyebrow">TRIP PROFILE</view><view class="title">{{mode === 'edit' ? '编辑行程' : '新建行程'}}</view></view>
  <view class="section">
    <view class="field"><view class="label">行程名称</view><input class="input" placeholder="例如：东京周末" value="{{form.title}}" data-field="title" bindinput="input" /></view>
    <view class="field"><view class="label">城市/目的地</view><input class="input" placeholder="多个城市用顿号分隔" value="{{form.citiesText}}" data-field="citiesText" bindinput="input" /></view>
    <view class="grid"><view class="field"><view class="label">开始日期</view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="date"><view class="input">{{form.startDate || '选择日期'}}</view></picker></view><view class="field"><view class="label">结束日期</view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="date"><view class="input">{{form.endDate || '选择日期'}}</view></picker></view></view>
    <view class="label">状态</view><view class="segments"><view class="segment {{form.status === item.key ? 'active' : ''}}" wx:for="{{statuses}}" wx:key="key" data-value="{{item.key}}" bindtap="status">{{item.label}}</view></view>
    <view class="grid"><view class="field"><view class="label">本位币</view><input class="input" value="{{form.baseCurrency}}" data-field="baseCurrency" bindinput="input" /></view><view class="field"><view class="label">总预算</view><input class="input" type="digit" placeholder="0.00" value="{{form.budgetText}}" data-field="budgetText" bindinput="input" /></view></view>
    <view class="field"><view class="label">备注</view><textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="input" /></view>
  </view>
  <button class="save" bindtap="save">保存行程</button>
</scroll-view>
<view class="page" wx:if="{{missing}}"><view class="section"><view class="title">找不到这段行程</view><view class="label">它可能已经被删除或被备份恢复替换。</view><button class="save" bindtap="goBack">返回上一页</button></view></view>
