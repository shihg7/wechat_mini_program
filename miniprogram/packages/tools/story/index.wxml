<scroll-view class="page" scroll-y wx:if="{{record}}">
  <view class="hero"><view class="eyebrow">PHOTO STORY</view><view class="title">照片故事</view><view class="hero-meta">{{record.displayName}} · 所有内容只在本机处理</view></view>
  <view class="section"><view class="label">分享标题</view><input class="input" value="{{preferences.title}}" bindinput="onTitleInput" /><view class="label spaced">版式</view><view class="segments"><view class="segment {{preferences.layout === item.key ? 'active' : ''}}" wx:for="{{layouts}}" wx:key="key" data-value="{{item.key}}" bindtap="onLayoutTap">{{item.label}}</view></view></view>
  <view class="section"><view class="section-head"><view><view class="section-title">选择照片</view><view class="section-meta">最多 6 张 · 点击选择</view></view><view class="count">{{preferences.photoIds.length}}/6</view></view><view class="photo-grid"><view class="photo-item {{item.checked ? 'checked' : ''}}" wx:for="{{photoOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="onPhotoToggle"><image wx:if="{{item.available}}" src="{{item.filePath}}" mode="aspectFill" /><view class="missing" wx:else>已失效</view><view class="check">{{item.checked ? "✓" : ""}}</view></view></view><view class="selected-order" wx:if="{{preferences.photoIds.length}}"><view class="order-row" wx:for="{{model.photos}}" wx:key="id"><view class="order-name">{{index + 1}}. {{item.caption || item.category}}</view><view class="order-tools"><view data-id="{{item.id}}" data-direction="-1" bindtap="movePhoto">‹</view><view data-id="{{item.id}}" data-direction="1" bindtap="movePhoto">›</view></view></view></view></view>
  <view class="section"><view class="section-title">展示内容</view><view class="option-grid"><view class="option {{preferences.options[item.key] ? 'active' : ''}}" wx:for="{{optionItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onOptionTap">{{item.label}}</view></view><view class="privacy">不会展示精确地址、经纬度、会员等级、价格、私密备注和本地文件路径。</view></view>
  <view class="preview"><view class="preview-type">{{model.layout === "photo" ? "照片叙事" : model.layout === "score" ? "评分报告" : "简洁档案"}}</view><view class="preview-title">{{model.title}}</view><view class="preview-meta">{{model.typeLabel}}{{model.city ? " · " + model.city : ""}}{{model.month ? " · " + model.month : ""}}</view><view class="preview-score" wx:if="{{model.score !== null}}">{{model.score}}</view><view class="preview-summary">{{model.summary}}</view></view>
  <button class="export-button" loading="{{exporting}}" bindtap="exportStory">生成分享长图</button>
  <canvas type="2d" id="storyCanvas" class="hidden-canvas"></canvas>
</scroll-view>
<scroll-view class="page" scroll-y wx:if="{{missing}}"><view class="section"><view class="section-title">找不到这条体验</view><view class="privacy">记录可能已经被删除或被备份恢复替换。</view><button class="export-button" bindtap="goBack">返回上一页</button></view></scroll-view>
