.page{min-height:100vh;background:#f3f5f7;padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 56rpx);box-sizing:border-box;color:#182230}.hero{display:flex;justify-content:space-between;align-items:flex-start;padding:12rpx 2rpx 30rpx}.eyebrow{font-size:22rpx;color:#667085;font-weight:600}.title{font-size:48rpx;font-weight:800;line-height:62rpx;margin-top:4rpx}.subtitle{font-size:24rpx;color:#667085;margin-top:4rpx}.add,.primary{background:#182230!important;color:#fff!important;border-radius:8rpx;font-size:26rpx;font-weight:700}.add{height:72rpx;line-height:72rpx;margin:5rpx 0 0;padding:0 24rpx}.filters{margin-bottom:22rpx}.search{height:76rpx;background:#fff;border:1rpx solid #e1e5ea;border-radius:8rpx;padding:0 22rpx;font-size:24rpx;box-sizing:border-box}.status-scroll{white-space:nowrap;margin-top:12rpx}.status-row{display:inline-flex;gap:10rpx}.status-filter{padding:12rpx 20rpx;background:#e8ebef;color:#475467;border-radius:6rpx;font-size:22rpx}.status-filter.active{background:#182230;color:#fff}.empty{background:#fff;border:1rpx solid #e7eaee;padding:58rpx 34rpx 38rpx;border-radius:8rpx;text-align:center}.empty-mark{width:76rpx;height:76rpx;margin:0 auto 22rpx;border-radius:50%;background:#eaf1ff;color:#2864d9;font-size:42rpx;line-height:74rpx}.empty-title{font-size:34rpx;font-weight:800}.empty-copy{max-width:540rpx;margin:14rpx auto 28rpx;color:#667085;font-size:25rpx;line-height:39rpx}.empty-steps{margin:0 0 30rpx;border-top:1rpx solid #edf0f3;text-align:left}.empty-steps view{display:flex;align-items:center;gap:18rpx;padding:18rpx 4rpx;border-bottom:1rpx solid #edf0f3;color:#475467;font-size:24rpx}.empty-steps text{width:40rpx;height:40rpx;border-radius:50%;background:#f0f2f5;text-align:center;line-height:40rpx;font-size:21rpx;font-weight:700}.primary{height:82rpx;line-height:82rpx}.group-title{display:flex;justify-content:space-between;margin:34rpx 4rpx 14rpx;color:#667085;font-size:24rpx;font-weight:700}.trip-card{background:#fff;border:1rpx solid #e7eaee;border-radius:8rpx;padding:26rpx;margin-bottom:16rpx}.trip-top,.trip-foot{display:flex;align-items:center;justify-content:space-between}.status{padding:5rpx 12rpx;border-radius:6rpx;background:#eaf1ff;color:#2864d9;font-size:20rpx;font-weight:700}.status.active{background:#e7f4ef;color:#1f7a55}.status.ended,.status.archived{background:#eef0f2;color:#667085}.count{font-size:22rpx;color:#667085}.trip-title{font-size:34rpx;line-height:46rpx;font-weight:800;margin-top:18rpx}.trip-meta{font-size:23rpx;color:#667085;line-height:34rpx;margin-top:7rpx}.trip-foot{gap:18rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #edf0f3;color:#475467;font-size:22rpx}.trip-foot view:nth-child(2){margin-left:auto}.arrow{color:#98a2b3;font-size:34rpx}
