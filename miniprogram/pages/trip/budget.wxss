.page{min-height:100vh;background:#f4f6f8;padding:28rpx;box-sizing:border-box;color:#172033}.hero{background:#172033;color:#fff;padding:34rpx;border-radius:8rpx}.eyebrow{font-size:20rpx;color:#9ab8ff;font-weight:700}.title{font-size:44rpx;font-weight:750;margin-top:8rpx}.numbers{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10rpx;margin-top:30rpx}.value{font-size:29rpx;font-weight:700}.value.danger{color:#ff9f8a}.label{font-size:21rpx;color:#b8c2d1;margin-top:6rpx}.section{background:#fff;border-radius:8rpx;padding:28rpx;margin-top:20rpx}.section-title{font-size:30rpx;font-weight:700;margin-bottom:18rpx}.category-row,.ledger,.expense{display:flex;justify-content:space-between;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #edf0f3}.category-name,.expense-title{font-size:26rpx;font-weight:600}.category-copy,.hint{font-size:22rpx;color:#667085;margin-top:4rpx}.over,.delete{font-size:22rpx;color:#a34b32}.ledger{padding:20rpx;background:#f4f6f8;margin-top:10rpx;border-radius:6rpx}.ledger.linked{background:#eaf1ff;color:#2054b2}.input{background:#f3f5f7;padding:20rpx;border-radius:6rpx;margin-bottom:12rpx;box-sizing:border-box}.grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10rpx}.categories{display:flex;gap:8rpx;flex-wrap:wrap;margin:6rpx 0 18rpx}.chip{font-size:22rpx;padding:12rpx 18rpx;background:#edf0f3;border-radius:5rpx}.chip.active{background:#172033;color:#fff}.add{background:#172033!important;color:#fff!important;border-radius:8rpx}
.budget-input{width:190rpx;background:#f3f5f7;border-radius:5rpx;padding:14rpx;text-align:right;font-size:23rpx}.budget-over{color:#a34b32;background:#fff1ed}.expense-form-actions{display:flex;gap:12rpx}.expense-form-actions .add{flex:1}.cancel{width:150rpx;margin:0;background:#e9edf2!important;color:#344054!important;border-radius:8rpx}
.source-strip{display:grid;grid-template-columns:1fr 1fr;background:#fff;padding:24rpx 28rpx;margin-top:16rpx;border-radius:8rpx;gap:20rpx}.source-strip>view+view{border-left:1rpx solid #e7eaf0;padding-left:20rpx}.source-label,.field-label{font-size:21rpx;color:#667085;margin-bottom:8rpx}.source-value{font-size:29rpx;font-weight:700}.ledger-title{font-size:25rpx;font-weight:650}.picker{min-height:68rpx}.grid>view{min-width:0}
