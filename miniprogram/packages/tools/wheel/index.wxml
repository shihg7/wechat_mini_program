<view class="page" wx:if="{{wheel}}">
  <view class="topbar"><view><view class="eyebrow">JUST PICK ONE</view><view class="title">转一转</view><view class="subtitle">把选择交给一点运气</view></view><button class="icon-button icon-center square-icon-button" bindtap="createWheel" aria-label="新建转盘"><ui-icon name="plus" size="{{32}}" tone="white" /></button></view>
  <view class="wheel-switch"><picker class="wheel-picker" mode="selector" range="{{wheelTitles}}" value="{{wheelIndex}}" bindchange="onWheelChange"><view><view class="switch-label">当前转盘</view><view class="wheel-name">{{wheel.title}} <text>⌄</text></view></view></picker><view class="wheel-actions"><view class="wheel-action icon-label" bindtap="renameWheel"><ui-icon name="edit" size="{{23}}" tone="white" /><text>编辑</text></view><view class="wheel-action icon-label danger" bindtap="deleteWheel"><ui-icon name="trash" size="{{23}}" tone="white" /><text>删除</text></view></view></view>
  <view class="stage"><view class="stage-ring"></view><canvas type="2d" id="wheelCanvas" class="wheel-canvas" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas></view>
  <view class="spin-hint">{{enabledCount < 2 ? '添加至少两个选项' : spinning ? '转盘正在选择…' : '用手拨动转盘，或点击按钮'}}</view>
  <button class="spin-button icon-action" disabled="{{spinning || enabledCount < 2}}" bindtap="spin"><ui-icon name="wheel" size="{{31}}" tone="white" /><text>{{spinning ? '正在选择…' : '转动转盘'}}</text></button>
  <view class="editor-toggle" bindtap="toggleEditor"><view class="editor-label icon-label"><ui-icon name="sliders" size="{{27}}" tone="blue" /><text class="editor-title">选项</text><text class="count-badge">{{enabledCount}}</text></view><view class="toggle-copy icon-label"><text>{{showEditor ? '完成编辑' : '管理选项'}}</text><ui-icon name="chevron-right" size="{{24}}" tone="blue" /></view></view>
  <scroll-view class="lower" scroll-y>
    <view class="editor" wx:if="{{showEditor}}"><view class="editor-head"><view class="section-title">添加新选项</view><view class="section-meta">每行一个，最多 50 个</view></view><textarea class="batch" maxlength="1200" placeholder="火锅\n日料\n本帮菜" value="{{batchText}}" bindinput="onBatchInput"/><button class="add-button icon-action" bindtap="addBatch"><ui-icon name="plus" size="{{27}}" tone="white" /><text>加入转盘</text></button>
      <view class="option {{!item.enabled ? 'disabled-option' : ''}}" wx:for="{{wheel.options}}" wx:key="id"><view class="option-main" data-id="{{item.id}}" bindtap="editOption"><view class="option-index">{{index + 1}}</view><view class="option-text">{{item.text}}</view></view><view class="option-tools"><view data-id="{{item.id}}" data-action="up" bindtap="optionAction">↑</view><view data-id="{{item.id}}" data-action="down" bindtap="optionAction">↓</view><view data-id="{{item.id}}" data-action="toggle" bindtap="optionAction">{{item.enabled ? '停用' : '启用'}}</view><view class="danger" data-id="{{item.id}}" data-action="remove" bindtap="optionAction">删除</view></view></view>
    </view>
    <view class="history-head" bindtap="toggleHistory"><view class="history-label icon-label"><view class="history-icon icon-center"><ui-icon name="book" size="{{28}}" tone="blue" /></view><view><view class="section-title">抽取历史</view><view class="section-meta">最近 {{wheel.history.length}} 次</view></view></view><view class="history-toggle icon-label"><text>{{historyExpanded ? '收起' : '展开'}}</text><ui-icon class="expand-icon {{historyExpanded ? 'expanded' : ''}}" name="chevron-right" size="{{24}}" tone="blue" /></view></view>
    <view class="history" wx:if="{{historyExpanded}}"><view class="empty" wx:if="{{!wheel.history.length}}">还没有抽取结果</view><view class="history-row" wx:for="{{wheel.history}}" wx:key="id"><view>{{item.optionText}}</view><view>{{item.displayTime}}</view></view><view class="clear-history" wx:if="{{wheel.history.length}}" bindtap="clearHistory">清空历史</view></view>
  </scroll-view>
  <view class="result-mask" wx:if="{{winner}}"><view class="result-sheet"><view class="result-accent"></view><view class="result-mark icon-center"><ui-icon name="check" size="{{42}}" tone="white" /></view><view class="result-label">这次就选</view><view class="result-value">{{winner.optionText}}</view><view class="result-actions"><button class="again icon-action" bindtap="spinAgain"><ui-icon name="refresh" size="{{26}}" tone="white" /><text>再转一次</text></button><button class="remove-winner icon-action" bindtap="removeWinner"><ui-icon name="trash" size="{{26}}" tone="accent" /><text>移出本轮</text></button></view><button class="done icon-action" bindtap="closeWinner"><ui-icon name="check" size="{{26}}" tone="white" /><text>就这么定了</text></button></view></view>
</view>
