page {
  background: #f3f5f7;
  color: #182230;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  box-sizing: border-box;
}

.page-head,
.page-head > view,
.segmented,
.date-field,
.inline-fields,
.mini-segmented,
.choice-row,
.choice,
.primary-button,
.icon-action {
  display: flex;
  align-items: center;
}

.page-head {
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: #3568ad;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 24rpx;
}

.page-title {
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.today-chip {
  flex: none;
  height: 52rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #ffffff;
  color: #526071;
  font-size: 21rpx;
  font-weight: 700;
}

.segmented {
  height: 72rpx;
  margin-top: 24rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe4ea;
  border-radius: 8rpx;
  background: #e8ecf0;
}

.segment {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.segment-active {
  background: #ffffff;
  color: #182230;
  box-shadow: 0 3rpx 10rpx rgba(24, 34, 48, 0.08);
}

.result-panel {
  position: relative;
  min-height: 230rpx;
  margin-top: 18rpx;
  padding: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #1f4f8c;
  color: #ffffff;
}

.result-panel-green {
  background: #176b68;
}

.result-panel-amber {
  background: #8a5b10;
}

.result-kicker {
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  font-weight: 800;
}

.result-number {
  display: inline-block;
  margin-top: 5rpx;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 106rpx;
}

.result-unit {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.result-date {
  margin-top: 14rpx;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 70rpx;
  word-break: break-all;
}

.result-detail {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 34rpx;
}

.form-panel {
  margin-top: 14rpx;
  padding: 24rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 8rpx;
  background: #ffffff;
}

.field-label {
  margin: 18rpx 0 9rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
}

.field-label:first-child {
  margin-top: 0;
}

.date-field,
.number-field input {
  min-height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #f8fafb;
  font-size: 27rpx;
  font-weight: 800;
}

.date-field {
  justify-content: space-between;
}

.field-meta {
  color: #667085;
  font-size: 21rpx;
}

.icon-action {
  justify-content: center;
  gap: 8rpx;
  height: 58rpx;
  margin: 12rpx auto 0;
  padding: 0 18rpx;
  border: 0;
  background: transparent;
  color: #3568ad;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.icon-action::after,
.primary-button::after {
  border: 0;
}

.inline-fields {
  align-items: flex-end;
  gap: 14rpx;
}

.number-field,
.direction-field {
  flex: 1;
  min-width: 0;
}

.number-field input {
  width: 100%;
}

.mini-segmented {
  height: 76rpx;
  padding: 5rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #edf0f3;
}

.mini-segmented view {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-segmented .active {
  background: #ffffff;
  color: #182230;
}

.choice-row {
  gap: 12rpx;
}

.choice {
  flex: 1;
  justify-content: center;
  gap: 9rpx;
  height: 70rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  color: #526071;
  font-size: 22rpx;
  font-weight: 800;
}

.choice-active {
  border-color: #3568ad;
  background: #edf4ff;
  color: #245795;
}

.notice {
  margin-top: 14rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 31rpx;
}

.primary-button {
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 82rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
  background: #182230 !important;
  color: #ffffff !important;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 82rpx;
}
