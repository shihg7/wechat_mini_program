page{background:#eef2f5;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx)}.top,.section-head,.selected,.missing-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.eyebrow{color:#667085;font-size:20rpx}.title{margin-top:3rpx;font-size:40rpx;font-weight:800}.count{color:#667085;font-size:22rpx;font-weight:700}.filters{margin-top:16rpx;white-space:nowrap}.filter{display:inline-block;min-width:112rpx;height:58rpx;margin-right:9rpx;border-radius:8rpx;background:#fff;color:#667085;font-size:22rpx;font-weight:700;line-height:58rpx;text-align:center}.filter.active{background:#172033;color:#fff}.map{width:100%;height:660rpx;margin-top:14rpx;border-radius:8rpx;overflow:hidden}.selected{margin-top:12rpx;padding:20rpx 22rpx;border-left:6rpx solid #2864d9;border-radius:8rpx;background:#fff}.selected-title,.section-title,.missing-name{font-size:27rpx;font-weight:800}.selected-meta,.section-meta,.missing-meta{margin-top:3rpx;color:#667085;font-size:21rpx}.selected-score{width:70rpx;height:58rpx;border-radius:8rpx;background:#eef2f5;font-size:26rpx;font-weight:800;line-height:58rpx;text-align:center}.section{margin-top:16rpx;padding:22rpx;border-radius:8rpx;background:#fff}.number{color:#667085;font-size:23rpx}.missing-row{padding:17rpx 0;border-bottom:1rpx solid #e5e9f0}.missing-row:last-child{border:0}.link{color:#2864d9;font-size:22rpx;font-weight:800}
