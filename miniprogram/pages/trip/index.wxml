<view class="page"><view class="hero"><view><view class="eyebrow">TRIP PLANNER</view><view class="title">我的行程</view><view class="subtitle">把想去、日程和预算放在一次旅行里</view></view><button class="add" bindtap="createTrip">新建</button></view><view class="empty" wx:if="{{!trips.length}}"><view class="empty-title">还没有行程</view><view class="empty-copy">先创建一次旅行，再安排酒店、餐厅和预算。</view><button class="primary" bindtap="createTrip">创建行程</button></view><view class="group" wx:for="{{groups}}" wx:key="key"><view class="group-title">{{item.label}} · {{item.items.length}}</view><view class="trip-card" wx:for="{{item.items}}" wx:for-item="trip" wx:key="id" data-id="{{trip.id}}" bindtap="openTrip"><view class="trip-top"><view class="trip-title">{{trip.title}}</view><view class="count">{{trip.planCount}} 项</view></view><view class="trip-meta">{{trip.cityText}}</view><view class="trip-date">{{trip.dateText}}</view></view></view></view>
