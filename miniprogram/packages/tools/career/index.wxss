page {
  background: #edf1f2;
  color: #172033;
}

.career-home {
  height: 100vh;
  overflow: hidden;
}

.home-scroll {
  height: 100%;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx 30rpx 30rpx;
  background: #172033;
  color: #fff;
}

.hero-copy {
  min-width: 0;
}

.eyebrow,
.section-kicker {
  color: #e86343;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.hero-subtitle {
  margin-top: 5rpx;
  color: #bec8d8;
  font-size: 23rpx;
  line-height: 34rpx;
}

.archive-button {
  width: 70rpx;
  min-width: 70rpx;
  height: 70rpx;
  margin: 3rpx 0 0 20rpx;
  padding: 0;
  border: 1rpx solid #516078;
  border-radius: 8rpx;
  background: #26344a;
}

.archive-button::after,
.continue-button::after,
.start-button::after,
.retry-button::after {
  border: 0;
}

.loading-state,
.error-state {
  margin: 28rpx 30rpx 0;
  padding: 36rpx 28rpx;
  border-radius: 8rpx;
  background: #fff;
}

.loading-line {
  width: 76%;
  height: 24rpx;
  background: #e2e7ea;
}

.loading-line.short {
  width: 46%;
  margin-top: 20rpx;
}

.error-state {
  text-align: center;
}

.state-icon {
  display: flex;
  justify-content: center;
}

.state-title {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 850;
}

.state-copy {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.retry-button {
  width: 250rpx;
  height: 70rpx;
  margin: 24rpx auto 0;
  border-radius: 8rpx;
  background: #3568ad;
  color: #fff;
  font-size: 23rpx;
  font-weight: 800;
}

.active-card {
  margin: 24rpx 30rpx 0;
  padding: 25rpx 26rpx 24rpx;
  border-left: 7rpx solid #176b68;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(23, 32, 51, .1);
}

.card-topline,
.active-footer,
.progress-band,
.section-heading,
.recent-row,
.recent-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-label {
  color: #176b68;
  font-size: 21rpx;
  font-weight: 800;
}

.autosave-label {
  color: #7b8493;
  font-size: 19rpx;
}

.active-name {
  margin-top: 18rpx;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.active-stage {
  margin-top: 5rpx;
  color: #667085;
  font-size: 22rpx;
}

.active-footer {
  margin-top: 24rpx;
}

.phase-chip {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #e7f2ef;
  color: #176b68;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 42rpx;
}

.continue-button {
  width: 224rpx;
  height: 70rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #172033;
  color: #fff;
  font-size: 23rpx;
  font-weight: 850;
}

.progress-band {
  margin-top: 24rpx;
  padding: 24rpx 30rpx;
  background: #f8fafb;
  border-top: 1rpx solid #dce2e5;
  border-bottom: 1rpx solid #dce2e5;
}

.progress-copy {
  flex-shrink: 0;
}

.progress-title,
.section-title {
  margin-top: 3rpx;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.progress-side {
  width: 260rpx;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  background: #dce2e5;
  border-radius: 6rpx;
}

.progress-fill {
  height: 100%;
  background: #e6af2e;
}

.progress-link,
.all-runs {
  justify-content: flex-end;
  margin-top: 8rpx;
  color: #3568ad;
  font-size: 20rpx;
  font-weight: 750;
}

.new-run-section,
.recent-section {
  padding: 30rpx;
  background: #fff;
}

.recent-section {
  margin-top: 18rpx;
}

.nickname-count {
  color: #7b8493;
  font-size: 20rpx;
}

.nickname-field {
  display: flex;
  align-items: center;
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #cfd6dc;
  border-radius: 8rpx;
  background: #f8fafb;
}

.nickname-input {
  flex: 1;
  height: 76rpx;
  margin-left: 12rpx;
  font-size: 25rpx;
}

.start-button {
  width: 100%;
  height: 80rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: #e86343;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.save-note {
  justify-content: center;
  margin-top: 13rpx;
  color: #667085;
  font-size: 20rpx;
}

.recent-empty {
  justify-content: flex-start;
  gap: 16rpx;
  min-height: 104rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  border: 1rpx dashed #cfd6dc;
  border-radius: 8rpx;
  color: #667085;
}

.empty-title {
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 3rpx;
  font-size: 20rpx;
}

.recent-row {
  min-height: 104rpx;
  border-bottom: 1rpx solid #e5e9ec;
}

.recent-index {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #172033;
  color: #fff;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 40rpx;
  text-align: center;
}

.recent-main {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx;
}

.recent-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  overflow: hidden;
  margin-top: 4rpx;
  color: #667085;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-date {
  margin-right: 6rpx;
  color: #7b8493;
  font-size: 18rpx;
}

.bottom-space {
  height: calc(env(safe-area-inset-bottom) + 30rpx);
}
