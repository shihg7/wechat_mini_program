page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.topbar,
.hero,
.quick-actions,
.section-head,
.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.icon-button {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 72rpx;
  text-align: center;
  padding: 0;
}

.icon-button::after,
.button::after {
  border: none;
}

.hero {
  margin-top: 32rpx;
  padding: 34rpx 30rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
}

.summary-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.summary-value {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 66rpx;
}

.summary-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
}

.summary-divider {
  width: 1rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.18);
}

.quick-actions {
  gap: 18rpx;
  margin-top: 22rpx;
  align-items: stretch;
}

.button {
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  padding: 0 10rpx;
}

.primary {
  flex: 1;
  background: #2864d9;
  color: #ffffff;
}

.accent {
  flex: 1;
  background: #a34b32;
  color: #ffffff;
}

.secondary {
  flex: 1;
  background: #ffffff;
  color: #172033;
}

.insight {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.insight-line {
  color: #4d596c;
  font-size: 26rpx;
  line-height: 40rpx;
}

.insight-line + .insight-line {
  margin-top: 8rpx;
}

.section-head {
  margin-top: 34rpx;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.filter-tab {
  flex: 1;
  min-height: 64rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4d596c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.filter-active {
  background: #172033;
  color: #ffffff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.section-count {
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.empty {
  margin-top: 22rpx;
  padding: 58rpx 38rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.empty-desc {
  margin-top: 14rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 40rpx;
}

.empty-button {
  margin-top: 30rpx;
}

.record {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  gap: 24rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
  word-break: break-all;
}

.record-type {
  display: inline-flex;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #667085;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  margin-bottom: 8rpx;
}

.record-meta,
.record-note {
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.record-meta {
  margin-top: 8rpx;
}

.record-note {
  margin-top: 4rpx;
}

.record-score {
  width: 86rpx;
  height: 70rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 70rpx;
  text-align: center;
}

.pdf-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}
