page {
  background: #eef2f5;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.hero {
  min-height: 196rpx;
  padding: 30rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 32rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
  word-break: break-all;
}

.summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 36rpx;
}

.total-card {
  width: 178rpx;
  min-width: 178rpx;
  min-height: 128rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.total-value {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.total-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 30rpx;
}

.overview-grid,
.quick-actions,
.amount-row,
.split-row,
.section-head,
.member-row,
.settlement,
.expense,
.category-row,
.settled-banner,
.transfer-history,
.participant-head,
.participant-actions,
.expense-actions,
.form-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.overview-grid {
  margin-top: 18rpx;
}

.settled-banner {
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #a34b32;
  border-radius: 8rpx;
  background: #fff4ef;
}

.settled-banner.done {
  border-left-color: #1f7a55;
  background: #e8f5ee;
}

.settled-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.settled-desc {
  color: #667085;
  font-size: 22rpx;
  line-height: 32rpx;
}

.copy-link,
.confirm-link {
  color: #2864d9;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.overview-item {
  flex: 1;
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.overview-value {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.overview-label {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 30rpx;
}

.quick-actions {
  margin-top: 18rpx;
}

.button {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #172033;
}

.section {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.priority-section {
  border-left: 6rpx solid #2864d9;
}

.form-section {
  border: 1rpx solid #cdd9f2;
}

.member-section {
  padding-bottom: 22rpx;
}

.section-head {
  justify-content: space-between;
  align-items: flex-start;
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 32rpx;
}

.close-link,
.mini-link,
.edit-link {
  color: #2864d9;
}

.mini-danger,
.delete-link {
  color: #a34b32;
}

.close-link,
.mini-link,
.mini-danger,
.edit-link,
.delete-link {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.field {
  margin-top: 20rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #5b6678;
  font-size: 24rpx;
  line-height: 34rpx;
}

.amount-row,
.split-row {
  align-items: flex-start;
}

.amount-field,
.payer-field,
.split-field {
  flex: 1;
  min-width: 0;
}

.input {
  width: 100%;
  height: 82rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 27rpx;
  line-height: 82rpx;
}

.member-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.member-chip {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #263248;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.member-chip.archived,
.member-check.archived {
  color: #667085;
  background: #f0f1f3;
}

.add-member-row {
  margin-top: 16rpx;
}

.add-member-input {
  flex: 1;
  min-width: 0;
}

.add-member-button {
  width: 128rpx;
  height: 82rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 82rpx;
  padding: 0;
}

.add-member-button::after {
  border: none;
}

.amount-input {
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
}

.picker-value {
  color: #172033;
}

.participant-head {
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.participant-head .field-label {
  margin-bottom: 0;
}

.participant-actions {
  gap: 18rpx;
}

.member-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.split-mode-control {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #f8fafc;
}

.split-mode-option {
  min-width: 0;
  height: 68rpx;
  border-right: 1rpx solid #d9dee8;
  color: #5b6678;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.split-mode-option:last-child { border-right: 0; }
.split-mode-option.active { background: #2864d9; color: #ffffff; }

.allocation-panel {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.allocation-hint {
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 32rpx;
}

.allocation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 74rpx;
  border-top: 1rpx solid #e5e9f0;
}

.allocation-name {
  flex: 1;
  min-width: 0;
  color: #263248;
  font-size: 25rpx;
  line-height: 34rpx;
}

.allocation-input-wrap {
  display: flex;
  align-items: center;
  width: 220rpx;
  height: 58rpx;
  padding: 0 14rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.allocation-input { flex: 1; min-width: 0; height: 56rpx; font-size: 26rpx; text-align: right; }
.allocation-unit { margin-left: 8rpx; color: #667085; font-size: 22rpx; }

.member-check {
  min-height: 58rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #263248;
  font-size: 25rpx;
  line-height: 58rpx;
}

.form-actions {
  margin-top: 22rpx;
}

.member-row,
.settlement,
.expense,
.category-row {
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.settlement {
  background: #eef5ff;
}

.settlement-side,
.history-side {
  min-width: 150rpx;
  text-align: right;
}

.transfer-form {
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #cdd9f2;
  border-radius: 8rpx;
  background: #f8fafc;
}

.transfer-form-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.transfer-form-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 32rpx;
}

.transfer-input {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.button.inset {
  border: 1rpx solid #d9dee8;
}

.transfer-history {
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.transfer-history.voided {
  opacity: 0.58;
}

.history-main {
  flex: 1;
  min-width: 0;
}

.history-side .delete-link {
  margin-top: 6rpx;
}

.member-name,
.settlement-flow,
.expense-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.settlement-hint,
.member-meta,
.expense-meta,
.expense-note {
  color: #667085;
  font-size: 23rpx;
  line-height: 34rpx;
}

.balance,
.settlement-amount,
.expense-amount {
  min-width: 132rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.settlement-amount {
  color: #2864d9;
}

.balance-positive {
  color: #1f7a55;
}

.balance-negative {
  color: #a34b32;
}

.expense-main {
  flex: 1;
  min-width: 0;
}

.expense-side {
  min-width: 138rpx;
  text-align: right;
}

.expense-actions {
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 8rpx;
}

.empty-inner {
  margin-top: 14rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #667085;
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}

.success-empty {
  color: #1f7a55;
  background: #e8f5ee;
}
