.page{min-height:100vh;background:#f4f6f8;padding:28rpx;box-sizing:border-box;color:#172033}.hero{padding:25rpx 4rpx}.eyebrow{font-size:20rpx;color:#2864d9;font-weight:700}.title{font-size:46rpx;font-weight:750;margin-top:8rpx}.section{background:#fff;border:1rpx solid #e4e8ee;border-radius:8rpx;padding:28rpx}.field{margin-bottom:24rpx}.label{font-size:23rpx;color:#526071;margin-bottom:10rpx}.input,.textarea{background:#f5f7f9;border:1rpx solid #e0e5eb;border-radius:6rpx;padding:22rpx;font-size:27rpx;box-sizing:border-box;width:100%}.textarea{height:150rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.segments{display:flex;gap:10rpx;flex-wrap:wrap;margin-bottom:26rpx}.segment{font-size:23rpx;padding:15rpx 20rpx;background:#f0f2f5;border-radius:6rpx}.segment.active{background:#172033;color:#fff}.save{margin-top:24rpx;background:#172033!important;color:#fff!important;border-radius:8rpx}
