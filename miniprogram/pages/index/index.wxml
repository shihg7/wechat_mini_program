<view class="page">
  <view class="topbar">
    <view class="title">工具箱</view>
    <view class="top-actions">
      <button
        class="top-action"
        wx:for="{{headerActions}}"
        wx:key="id"
        data-url="{{item.url}}"
        bindtap="openRoute"
        aria-label="{{item.label}}"
      >
        <ui-icon name="{{item.icon}}" size="{{24}}" tone="muted" />
        <text>{{item.label}}</text>
      </button>
    </view>
  </view>

  <view class="tool-grid">
    <button
      class="tool-card tool-card-{{item.id}}"
      wx:for="{{tools}}"
      wx:key="id"
      data-url="{{item.url}}"
      bindtap="openRoute"
      aria-label="打开{{item.label}}"
    >
      <view class="tool-icon tool-icon-{{item.tone}}">
        <ui-icon name="{{item.icon}}" size="{{34}}" tone="{{item.tone}}" />
      </view>
      <view class="tool-card-footer">
        <text class="tool-label">{{item.label}}</text>
        <ui-icon name="chevron-right" size="{{24}}" tone="muted" />
      </view>
    </button>
  </view>
</view>
