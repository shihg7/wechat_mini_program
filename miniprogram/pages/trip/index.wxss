.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 56rpx);
  background: #f3f5f7;
  color: #182230;
}
.hero { display: flex; align-items: flex-start; justify-content: space-between; padding: 12rpx 2rpx 30rpx; }
.eyebrow { color: #667085; font-size: 22rpx; font-weight: 600; }
.title { margin-top: 4rpx; font-size: 48rpx; font-weight: 800; line-height: 62rpx; }
.subtitle { margin-top: 4rpx; color: #667085; font-size: 24rpx; }
.add,
.primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 8rpx;
  background: #182230 !important;
  color: #fff !important;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
}
.add { height: 72rpx; margin: 5rpx 0 0; padding: 0 24rpx; }
.add::after,
.primary::after { border: 0; }
.filters { margin-bottom: 22rpx; }
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #e1e5ea;
  border-radius: 8rpx;
  background: #fff;
}
.search { height: 72rpx; flex: 1; min-width: 0; padding: 0; font-size: 24rpx; }
.status-scroll { margin-top: 12rpx; white-space: nowrap; }
.status-row { display: inline-flex; gap: 10rpx; }
.status-filter { padding: 12rpx 20rpx; border-radius: 6rpx; background: #e8ebef; color: #475467; font-size: 22rpx; }
.status-filter.active { background: #182230; color: #fff; }
.empty { padding: 58rpx 34rpx 38rpx; border: 1rpx solid #e7eaee; border-radius: 8rpx; background: #fff; text-align: center; }
.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
  border-radius: 8rpx;
  background: #eaf1ff;
}
.empty-title { font-size: 34rpx; font-weight: 800; }
.empty-copy { max-width: 540rpx; margin: 14rpx auto 28rpx; color: #667085; font-size: 25rpx; line-height: 39rpx; }
.empty-steps { margin: 0 0 30rpx; border-top: 1rpx solid #edf0f3; text-align: left; }
.empty-steps view { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 4rpx; border-bottom: 1rpx solid #edf0f3; color: #475467; font-size: 24rpx; }
.empty-steps text { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 8rpx; background: #f0f2f5; }
.primary { height: 82rpx; }
.group-title { display: flex; justify-content: space-between; margin: 34rpx 4rpx 14rpx; color: #667085; font-size: 24rpx; font-weight: 700; }
.trip-card { margin-bottom: 16rpx; padding: 26rpx; border: 1rpx solid #e7eaee; border-radius: 8rpx; background: #fff; }
.trip-top,
.trip-foot { display: flex; align-items: center; justify-content: space-between; }
.status { padding: 5rpx 12rpx; border-radius: 6rpx; background: #eaf1ff; color: #2864d9; font-size: 20rpx; font-weight: 700; }
.status.active { background: #e7f4ef; color: #1f7a55; }
.status.ended,
.status.archived { background: #eef0f2; color: #667085; }
.count { color: #667085; font-size: 22rpx; }
.trip-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 800; line-height: 46rpx; }
.trip-meta { display: flex; align-items: center; gap: 8rpx; margin-top: 7rpx; color: #667085; font-size: 23rpx; line-height: 34rpx; }
.trip-meta text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trip-foot { gap: 18rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f3; color: #475467; font-size: 22rpx; }
.trip-foot view { display: flex; align-items: center; gap: 7rpx; min-width: 0; }
.trip-foot view:nth-child(2) { margin-left: auto; }
.trip-foot text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
