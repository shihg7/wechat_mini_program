page {
  height: 100%;
  overflow: hidden;
  background: #f3f5f7;
  color: #182230;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 22rpx 22rpx calc(env(safe-area-inset-bottom) + 18rpx);
  overflow: hidden;
  box-sizing: border-box;
}

.page-head,
.offline-badge,
.quick-tools,
.icon-command,
.recognition-status,
.control-row,
.segmented,
.segment,
.detail-control,
.color-options,
.bottom-bar,
.replace-button,
.save-button,
.privacy-note,
.choose-primary {
  display: flex;
  align-items: center;
}

.page-head {
  flex: none;
  justify-content: space-between;
  gap: 18rpx;
}

.head-copy {
  min-width: 0;
}

.eyebrow {
  color: #295b9b;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 22rpx;
}

.page-title {
  font-size: 39rpx;
  font-weight: 900;
  line-height: 49rpx;
}

.offline-badge {
  flex: none;
  gap: 7rpx;
  min-height: 50rpx;
  padding: 0 13rpx;
  box-sizing: border-box;
  border: 1rpx solid #cfe1d9;
  border-radius: 8rpx;
  background: #edf7f2;
  color: #176b68;
  font-size: 19rpx;
  font-weight: 800;
}

.empty-state {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 34rpx 80rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #e8f0ff;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.empty-text {
  max-width: 590rpx;
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 34rpx;
  overflow-wrap: break-word;
}

.choose-primary {
  justify-content: center;
  gap: 10rpx;
  width: 360rpx;
  min-height: 78rpx;
  margin-top: 28rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #182230 !important;
  color: #ffffff !important;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 32rpx;
}

.privacy-note {
  justify-content: center;
  gap: 8rpx;
  max-width: 590rpx;
  margin-top: 18rpx;
  color: #667085;
  font-size: 19rpx;
  line-height: 28rpx;
}

.quick-tools {
  flex: none;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 12rpx;
}

.icon-command {
  flex: 1;
  min-width: 0;
  min-height: 62rpx;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  margin: 0;
  padding: 5rpx 2rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #ffffff;
  color: #526071;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 22rpx;
}

.icon-command[disabled] {
  opacity: 0.45;
}

.icon-command::after,
.choose-primary::after,
.replace-button::after,
.save-button::after,
.toggle-mask::after {
  border: 0;
}

.canvas-shell {
  position: relative;
  flex: 1;
  min-height: 250rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid #cfd7e2;
  border-radius: 8rpx;
  background: #202936;
}

.preview-canvas {
  width: 100%;
  height: 100%;
}

.recognizing-cover {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: rgba(24, 34, 48, 0.72);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: rotate 0.9s linear infinite;
}

@keyframes rotate {
  to { transform: rotate(360deg); }
}

.recognition-status {
  flex: none;
  justify-content: center;
  gap: 7rpx;
  min-height: 48rpx;
  padding: 6rpx 12rpx;
  box-sizing: border-box;
  color: #526071;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
}

.recognition-status text {
  min-width: 0;
  overflow-wrap: break-word;
}

.status-ready {
  color: #176b68;
}

.status-warning {
  color: #8a5b10;
}

.editor-controls {
  flex: none;
  padding: 10rpx 12rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #ffffff;
}

.control-row + .control-row {
  margin-top: 8rpx;
}

.control-label {
  flex: 0 0 62rpx;
  color: #667085;
  font-size: 19rpx;
  font-weight: 900;
}

.segmented {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #e9edf1;
}

.segment {
  flex: 1;
  min-width: 0;
  height: 50rpx;
  justify-content: center;
  gap: 5rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 24rpx;
  text-align: center;
}

.segment-active {
  background: #ffffff;
  color: #182230;
  box-shadow: 0 2rpx 8rpx rgba(24, 34, 48, 0.1);
}

.detail-control {
  height: 58rpx;
  margin-top: 8rpx;
  padding: 0 4rpx 0 62rpx;
  box-sizing: border-box;
}

.detail-label {
  flex: none;
  width: 62rpx;
  color: #667085;
  font-size: 18rpx;
  font-weight: 800;
}

.strength-slider {
  flex: 1;
  min-width: 0;
  margin: 0 8rpx;
}

.strength-value {
  flex: 0 0 42rpx;
  color: #182230;
  font-size: 19rpx;
  font-weight: 900;
  text-align: center;
}

.color-options {
  gap: 16rpx;
}

.color-swatch {
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #aab4c1;
}

.color-dark { background: #182230; }
.color-gray { background: #667085; }
.color-white { background: #ffffff; }

.swatch-active {
  box-shadow: 0 0 0 4rpx #2877d4;
}

.toggle-mask {
  min-height: 50rpx;
  margin: 0 0 0 auto;
  padding: 0 14rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 8rpx;
  background: #f8fafb;
  color: #354052;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.bottom-bar {
  flex: none;
  gap: 10rpx;
  padding-top: 10rpx;
}

.replace-button,
.save-button {
  justify-content: center;
  gap: 8rpx;
  min-height: 74rpx;
  margin: 0;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 30rpx;
}

.replace-button {
  flex: 0 0 190rpx;
  border: 1rpx solid #cfd7e2;
  background: #ffffff;
  color: #354052;
}

.save-button {
  flex: 1;
  min-width: 0;
  background: #182230 !important;
  color: #ffffff !important;
}

.replace-button[disabled],
.save-button[disabled] {
  opacity: 0.55;
}

.hidden-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 2px;
  height: 2px;
  pointer-events: none;
}

@media (max-height: 680px) {
  .page {
    padding-top: 14rpx;
  }

  .eyebrow {
    display: none;
  }

  .page-title {
    font-size: 34rpx;
    line-height: 42rpx;
  }

  .quick-tools {
    margin-top: 8rpx;
  }

  .recognition-status {
    min-height: 42rpx;
    padding-top: 3rpx;
    padding-bottom: 3rpx;
  }
}
