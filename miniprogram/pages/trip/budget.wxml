<scroll-view class="page" scroll-y wx:if="{{trip}}">
  <view class="hero"><view class="eyebrow">TRIP BUDGET</view><view class="title icon-label"><ui-icon name="wallet" size="{{37}}" tone="white" /><text>预算中心</text></view><view class="numbers"><view><view class="value">{{summary.spentText}}</view><view class="label">已使用</view></view><view><view class="value {{summary.overBudget ? 'danger' : ''}}">{{summary.remainingText}}</view><view class="label">{{summary.overBudget ? '已超支' : '剩余'}}</view></view><view><view class="value">{{summary.percent}}%</view><view class="label">预算进度</view></view></view></view>
  <view class="source-strip"><view><view class="source-label icon-label"><ui-icon name="receipt" size="{{23}}" tone="blue" /><text>个人支出 · {{summary.personalExpenseCount}} 笔</text></view><view class="source-value">{{summary.personalText}}</view></view><view><view class="source-label icon-label"><ui-icon name="users" size="{{23}}" tone="green" /><text>AA 账本 · {{summary.ledgerExpenseCount}} 笔</text></view><view class="source-value">{{summary.ledgerText}}</view></view></view>
  <view class="section"><view class="section-title icon-label"><ui-icon name="chart" size="{{29}}" tone="blue" /><text>分类进度</text></view><view class="category-row" wx:for="{{summary.byCategory}}" wx:key="category"><view><view class="category-name">{{item.category}}</view><view class="category-copy">已用 {{item.spentText}}</view></view><input class="budget-input {{item.over ? 'budget-over' : ''}}" type="digit" placeholder="分类预算" value="{{item.budgetInput}}" data-category="{{item.category}}" bindblur="setCategoryBudget"/></view></view>
  <view class="section"><view class="section-title icon-label"><ui-icon name="users" size="{{29}}" tone="green" /><text>关联 AA 账本</text></view><view class="hint">计入同行人的全部账本支出，不复制数据。</view><view class="ledger {{item.linked ? 'linked' : ''}}" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleLedger"><view><view class="ledger-title">{{item.title}}</view><view class="hint">{{item.expenseCount}} 笔 · {{item.amountText}}</view></view><view class="icon-label"><ui-icon name="{{item.linked ? 'check' : 'circle'}}" size="{{24}}" tone="{{item.linked ? 'blue' : 'muted'}}" /><text>{{item.linked ? '已计入' : '不计入'}}</text></view></view><view class="hint" wx:if="{{!ledgers.length}}">暂无可关联账本</view></view>
  <view class="section"><view class="section-title icon-label"><ui-icon name="{{editingExpenseId ? 'edit' : 'plus'}}" size="{{29}}" tone="accent" /><text>{{editingExpenseId ? '编辑个人支出' : '新增个人支出'}}</text></view><view class="field-label">支出名称</view><input class="input" placeholder="例如：机场快线" value="{{expense.title}}" data-field="title" bindinput="input"/><view class="grid"><view><view class="field-label">金额</view><input class="input" type="digit" placeholder="0.00" value="{{expense.amountText}}" data-field="amountText" bindinput="input"/></view><view><view class="field-label">币种</view><input class="input" placeholder="CNY" value="{{expense.currency}}" data-field="currency" bindinput="input"/></view><view><view class="field-label">汇率</view><input class="input" type="digit" placeholder="1" value="{{expense.rate}}" data-field="rate" bindinput="input"/></view></view><view class="field-label">支出日期</view><picker mode="date" value="{{expense.date}}" start="{{trip.startDate}}" end="{{trip.endDate}}" bindchange="expenseDate"><view class="input picker">{{expense.date || '选择日期'}}</view></picker><view class="categories"><view class="chip {{expense.category === item ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" data-value="{{item}}" bindtap="category">{{item}}</view></view><view class="expense-form-actions"><button class="add icon-action" bindtap="addExpense"><ui-icon name="{{editingExpenseId ? 'check' : 'plus'}}" size="{{27}}" tone="white" /><text>{{editingExpenseId ? '保存修改' : '记录支出'}}</text></button><button class="cancel icon-action" wx:if="{{editingExpenseId}}" bindtap="cancelExpenseEdit"><ui-icon name="x" size="{{25}}" tone="muted" /><text>取消</text></button></view><view class="expense" wx:for="{{trip.personalExpenses}}" wx:key="id" data-id="{{item.id}}" bindtap="editExpense"><view><view class="expense-title">{{item.title || item.category}}</view><view class="hint icon-label"><ui-icon name="calendar" size="{{22}}" tone="muted" /><text>{{item.currency}} · {{item.date}} · 点击编辑</text></view></view><view class="delete icon-label" data-id="{{item.id}}" catchtap="removeExpense"><ui-icon name="trash" size="{{22}}" tone="accent" /><text>删除</text></view></view></view>
</scroll-view>
<view class="page" wx:if="{{missing}}"><view class="section"><view class="section-title">找不到这段行程</view><view class="hint">行程可能已经被删除或被备份恢复替换。</view><button class="add" bindtap="goBack">返回上一页</button></view></view>
