page {
  background: #f3f5f7;
  color: #182230;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

.topbar,
.section-head,
.file-row,
.action-row,
.privacy-note {
  display: flex;
  align-items: center;
}

.topbar {
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  line-height: 30rpx;
}

.title {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.local-badge {
  display: flex;
  align-items: center;
  gap: 7rpx;
  padding: 12rpx 15rpx;
  border: 1rpx solid #b9c5d1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #425466;
  font-size: 22rpx;
  font-weight: 700;
}

.storage-band {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  background: #182230;
  color: #ffffff;
}

.storage-main,
.storage-side,
.summary-item,
.metric-label,
.metric {
  display: flex;
  flex-direction: column;
}

.storage-label,
.storage-side {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  line-height: 32rpx;
}

.storage-value {
  margin-top: 4rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.storage-side {
  align-items: flex-end;
  text-align: right;
}

.storage-date {
  color: #ffffff;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-item {
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 18rpx 4rpx;
  border: 1rpx solid #dfe4eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.summary-label,
.metric-label {
  color: #667085;
  font-size: 20rpx;
  line-height: 28rpx;
}

.section {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e1e6ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-head {
  gap: 15rpx;
}

.section-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef2f5;
}

.icon-blue { background: #e8f0ff; }
.icon-green { background: #e5f3ed; }
.icon-danger { background: #f7e5e1; }

.section-copy {
  min-width: 0;
  flex: 1;
}

.section-title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.section-subtitle,
.preview-time {
  color: #667085;
  font-size: 23rpx;
  line-height: 34rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 82rpx;
  margin: 22rpx 0 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #2864d9;
  color: #ffffff;
}

.secondary {
  background: #eef2f5;
  color: #182230;
}

.preview {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e4e8ef;
}

.file-row {
  gap: 9rpx;
}

.file-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-time {
  margin-top: 5rpx;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 14rpx;
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-radius: 8rpx;
  background: #f6f8fa;
}

.metric,
.metric-label {
  align-items: center;
}

.metric {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.action-row {
  gap: 12rpx;
}

.action-row .button {
  flex: 1;
}

.merge {
  background: #dfe9ff;
  color: #184da9;
}

.danger {
  background: #f7e3df;
  color: #913626;
}

.danger-section {
  border-color: #efd7d1;
}

.privacy-note {
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 0 4rpx;
  color: #596579;
  font-size: 23rpx;
  line-height: 36rpx;
}
