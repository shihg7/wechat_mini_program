page {
  background: #f3f5f7;
  color: #182230;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

button { letter-spacing: 0; }
button::after { border: 0; }
button:active, [bindtap]:active, [catchtap]:active { opacity: .72; }
input, textarea { caret-color: #2864d9; }
input::placeholder, textarea::placeholder { color: #98a2b3; }

.container { position: absolute; inset: 0; }

.icon-center {
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.icon-action {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.icon-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.square-icon-button {
  display: flex !important;
  flex: 0 0 72rpx !important;
  width: 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx !important;
  height: 72rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}

.trip-hero-action {
  flex: 0 0 160rpx !important;
  width: 160rpx !important;
  min-width: 160rpx !important;
  max-width: 160rpx !important;
  height: 68rpx !important;
  padding: 0 !important;
  box-sizing: border-box;
}

.trip-more-action {
  flex: 0 0 68rpx !important;
  width: 68rpx !important;
  min-width: 68rpx !important;
  max-width: 68rpx !important;
  height: 68rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}
